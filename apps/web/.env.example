# Copy to .env (gitignored) to try GitHub sign-in with `pnpm dev`. Use a GitHub OAuth
# App made for local development: its callback URL must be
# http://localhost:4321/auth/github/callback (see deploy/README.md §7).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your numeric GitHub user ID (the "id" at https://api.github.com/users/<your-login>).
ADMIN_GITHUB_IDS=
# Optional: search engine ownership checks (deploy/README.md §9). Only production needs them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional: IndexNow key (8–128 letters, digits, dashes). Unset: no pings are sent.
INDEXNOW_KEY=
# File storage: dev keeps uploads in apps/web/.data/storage. To try the real bucket
# instead (deploy/storage.md), fill these in; FILES_URL defaults to files.trilleo.net.
OBS_BUCKET=
OBS_REGION=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
