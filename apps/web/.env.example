# Copy to .env (gitignored). Signing in by email works in `pnpm dev` with nothing set:
# the code lands in the outbox (/admin/mail/, or the dev server's database).
# Who can use /admin: account addresses (comma-separated)…
ADMIN_EMAILS=
# …or numeric GitHub user IDs (the "id" at https://api.github.com/users/<your-login>).
ADMIN_GITHUB_IDS=
# Optional: "Sign in with GitHub". Use a GitHub OAuth App made for local development:
# its callback URL must be http://localhost:4321/auth/github/callback (deploy/README.md §7).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: search engine ownership checks (deploy/README.md §9). Only production needs them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional: IndexNow key (8–128 letters, digits, dashes). Unset: no pings are sent.
INDEXNOW_KEY=
# File storage: dev keeps uploads in apps/web/.data/storage. To try the real bucket
# instead (deploy/storage.md), fill these in; FILES_URL defaults to files.trilleo.net.
OBS_BUCKET=
OBS_REGION=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
# Optional: where Minecraft release versions come from (Mojang's manifest by default);
# "off" uses only the list in src/lib/minecraft/game-versions.ts.
MINECRAFT_VERSION_MANIFEST=
# The CHUNITHM catalog (src/lib/chunithm/): "off" never fetches. The URLs default to
# SEGA's music.json, otoge-db.net's data folder and https://sdvx.in.
CHUNITHM_SYNC=
CHUNITHM_SEGA_URL=
CHUNITHM_OTOGE_URL=
CHUNITHM_SDVX_URL=
# The wait between requests to sdvx.in, in milliseconds (default 1000).
CHUNITHM_SDVX_DELAY_MS=
# "off" stops building Master and Ultima charts ahead of visitors (src/lib/chunithm/
# prebuild.ts: one every 2 minutes while no one is opening charts).
CHUNITHM_PREBUILD=
# Hypixel SkyBlock's shard data (src/lib/skyblock/): read from SkyShards' GitHub
# repository every 6 hours. "off" never fetches (pages use the copy committed with the
# site). SKYBLOCK_REPO ("owner/name"), SKYBLOCK_GITHUB_API and SKYBLOCK_RAW_URL point
# elsewhere (tests); leave them empty.
SKYBLOCK_SYNC=
SKYBLOCK_REPO=
SKYBLOCK_GITHUB_API=
SKYBLOCK_RAW_URL=
# SkyBlock's Bazaar prices (src/lib/skyblock/bazaar.ts): fetched from Hypixel's public
# endpoint (no key) every 5 minutes. "off" never fetches; SKYBLOCK_BAZAAR_URL points
# elsewhere (e2e's fake). Leave both empty.
SKYBLOCK_BAZAAR=
SKYBLOCK_BAZAAR_URL=
# The event timer's mayor, election, fire sales, Bingo and news: Hypixel's keyless
# endpoints, fetched by the server (the election and fire sales every 5 minutes, Bingo
# and news every 30). "off" never fetches; SKYBLOCK_HYPIXEL_URL points at another host.
SKYBLOCK_FEEDS=
SKYBLOCK_HYPIXEL_URL=
# Jacob's contest crops come from the Skyblocker mod's calendar (hysky.de), every 3
# hours. "off" skips them alone; SKYBLOCK_CROPS_URL points elsewhere (e2e's fake).
SKYBLOCK_CROPS=
SKYBLOCK_CROPS_URL=
# Preview's server fetch refuses private and loopback addresses. Hosts ("host:port")
# listed here are let through: e2e uses it for its fake document server. Leave empty.
PREVIEW_ALLOW_HOSTS=
# Email: dev keeps every message in the outbox instead of sending it (read them at
# /admin/mail/). To send for real (deploy/mail.md), fill in SMTP_*; the rest is optional.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Default: "Trilleo Network" <no-reply@automail.trilleo.net>
MAIL_FROM=
# Where answers to the admin's contact replies go.
MAIL_REPLY_TO=
# Who gets admin alerts (comma-separated). Default: the admins' own verified addresses.
MAIL_ADMIN_TO=
