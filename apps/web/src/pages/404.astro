---
import DisplayTitle from "../components/DisplayTitle.astro";
import { ArrowRightIcon, buttonClasses } from "@trilleo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

// Rendered by the server: pages that look things up (a post, a tag) rewrite to it.
export const prerender = false;
---

<BaseLayout title="Page not found" noindex>
  <section
    aria-labelledby="not-found-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label text-ink">(404) Not found</p>

    <DisplayTitle id="not-found-title">404</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-6 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-lead col-span-4 md:col-span-6 md:col-start-3 xl:col-start-3">
        This page doesn’t exist, or it has moved.
      </p>
      <div class="col-span-4 md:col-span-6 md:col-start-3 xl:col-span-3 xl:col-start-10">
        <a href="/" class={buttonClasses()}>
          Back to home
          <ArrowRightIcon size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
