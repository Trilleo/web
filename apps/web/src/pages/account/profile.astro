---
/**
 * Editing your profile: GET shows the form, POST saves it and comes back here (or
 * shows the form again, with what was typed and what's wrong). The username can be
 * changed here too, every USERNAME_COOLDOWN_DAYS (lib/auth/usernames.ts); the old
 * one redirects for a while.
 */
import { buttonClasses } from "@trilleo/ui";
import Avatar from "../../components/account/Avatar.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdmin, requireUser } from "../../lib/auth/guard";
import { logEvent } from "../../lib/auth/activity";
import { noStoreRedirect } from "../../lib/auth/redirect";
import {
  USERNAME_HOLD_DAYS,
  USERNAME_LIMITS,
  USERNAME_PROBLEMS,
  changeUsername,
  nextUsernameChange,
  normalizeUsername,
} from "../../lib/auth/usernames";
import { field } from "../../lib/comments/form";
import { formatPostDate } from "../../lib/listings";
import { getDb } from "../../lib/db";
import {
  PROFILE_LIMITS,
  displayName,
  profileDraft,
  profileHref,
  readProfileForm,
  validateProfile,
  type ProfileDraft,
  type ProfileField,
} from "../../lib/profile/profile";
import {
  AVATAR_ACCEPT,
  AVATAR_ERROR_MESSAGES,
  AVATAR_SIZE,
  avatarMaxBytes,
  type AvatarError,
} from "../../lib/profile/avatar";
import { updateProfile } from "../../lib/profile/store";
import { toast, toastError } from "../../lib/toast";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

let values: ProfileDraft = profileDraft(user);
let errors: Partial<Record<ProfileField, string>> = {};
let username = user.username;
let usernameError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const draft = readProfileForm(form);
  username = normalizeUsername(field(form, "username")) || user.username;
  const result = validateProfile(draft);
  if (result.ok) {
    const db = await getDb();
    // The username first: if it can't be had, nothing is saved.
    const renamed =
      username === user.username
        ? null
        : await changeUsername(db, user, username);
    if (renamed && !renamed.ok) {
      usernameError = USERNAME_PROBLEMS[renamed.problem];
    } else {
      if (renamed)
        await logEvent(db, user.id, "username-changed", {
          detail: `@${user.username} → @${renamed.username}`,
          userAgent: Astro.request.headers.get("user-agent"),
        });
      await updateProfile(db, user.id, result.profile);
      return noStoreRedirect("/account/profile/?saved=1", 303);
    }
  } else {
    errors = result.errors;
  }
  values = draft;
  Astro.response.status = 422;
}
const canRenameAt = nextUsernameChange(user);

const saved =
  Astro.url.searchParams.has("saved") && Astro.request.method !== "POST";
// What happened to the picture (its own form, /account/avatar).
const avatarDone = Astro.url.searchParams.get("avatar");
// The admin isn't held to the picture size limits, and may skip the crop.
const admin = isAdmin(user);
const avatarMegabytes = avatarMaxBytes(admin) / 1024 / 1024;
const avatarErrorCode = Astro.url.searchParams.get("avatar-error") ?? "";
const avatarError = Object.hasOwn(AVATAR_ERROR_MESSAGES, avatarErrorCode)
  ? AVATAR_ERROR_MESSAGES[avatarErrorCode as AvatarError]
  : null;
const avatarStatus =
  avatarDone === "saved"
    ? "Picture saved."
    : avatarDone === "removed"
      ? "Picture removed."
      : null;
const hasErrors = Object.keys(errors).length > 0 || usernameError !== null;
const githubName = user.name ?? user.username;
const nameHint = user.name
  ? `Shown on your profile and comments. Leave empty to use ${user.name}, the name on your linked GitHub account.`
  : `Shown on your profile and comments. Leave empty to show just @${user.username}.`;

// Field limits are in characters as people count them, checked on the server; the
// browser counts UTF-16 units (an emoji is two), so its maxlength only stops pastes
// of far too much.
const input =
  "w-full border border-ink bg-paper px-3 py-2.5 text-base text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-invalid:border-accent";
const row = "grid-swiss gap-y-5 border-t border-ink pt-4 md:pt-5 xl:pt-6";
const heading = "type-label col-span-4 md:col-span-2 xl:col-span-2";
const body = "col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-7";

const lines = [
  {
    name: "displayName",
    label: "Display name",
    hint: nameHint,
    placeholder: githubName,
    autocomplete: "nickname",
  },
  {
    name: "pronouns",
    label: "Pronouns",
    hint: "Optional, e.g. she/her, they/them.",
    placeholder: "",
    autocomplete: "off",
  },
  {
    name: "location",
    label: "Location",
    hint: "Optional. As broad as you like.",
    placeholder: "",
    autocomplete: "off",
  },
  {
    name: "status",
    label: "Currently",
    hint: "A line about what you’re up to, shown at the top of your profile.",
    placeholder: "Building a redstone computer",
    autocomplete: "off",
  },
] as const;
if (hasErrors) toastError(Astro, "Not saved: check the fields marked below.");
else if (saved)
  toast(Astro, "Saved.", "done", {
    href: profileHref(user.username),
    label: "See your profile",
  });
if (avatarError) toastError(Astro, avatarError);
else toast(Astro, avatarStatus);
---

<BaseLayout title="Edit profile" noindex>
  <section
    aria-labelledby="profile-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label text-ink">
      (Account){" "}
      <a href="/account/" class="link-wipe">
        @{user.username}
      </a>
    </p>

    <DisplayTitle id="profile-title">Profile</DisplayTitle>

    <div id="avatar" class:list={[row, "mt-7 scroll-mt-6 md:mt-8 xl:mt-12"]}>
      <h2 class={heading}>Picture</h2>
      <div class={body}>
        <div class="flex flex-wrap items-start gap-5">
          <Avatar user={user} size="lg" />
          <form
            method="post"
            action="/account/avatar"
            enctype="multipart/form-data"
            class="flex min-w-0 flex-1 flex-col gap-3"
            data-avatar-form
            data-size={String(AVATAR_SIZE)}
          >
            <label for="avatar-file" class="font-medium">
              {user.avatarHash ? "Choose a new picture" : "Choose a picture"}
            </label>
            <input
              id="avatar-file"
              type="file"
              name="avatar"
              accept={AVATAR_ACCEPT}
              aria-describedby="avatar-hint"
              class="w-full text-sm file:mr-3 file:cursor-pointer file:border file:border-ink file:bg-paper file:px-3 file:py-2 file:font-sans file:text-ink"
            />
            <p id="avatar-hint" class="text-sm text-muted">
              PNG, JPEG or WebP, up to {avatarMegabytes} MB
              {admin && " (the admin’s limit)"}. It’s cropped to a square and
              shown next to your name on comments, forum posts and your profile.
            </p>
            <div class="flex flex-col gap-3" hidden data-avatar-crop>
              <canvas
                width={AVATAR_SIZE}
                height={AVATAR_SIZE}
                tabindex="0"
                role="img"
                aria-label="Crop preview. Drag, or use the arrow keys, to move the picture."
                class="size-48 cursor-grab touch-none border border-ink bg-chip focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:cursor-grabbing"
                data-avatar-canvas
              ></canvas>
              <label class="flex max-w-48 flex-col gap-1 text-sm">
                <span class="font-medium">Zoom</span>
                <input
                  type="range"
                  min="1"
                  max="4"
                  step="0.01"
                  value="1"
                  class="accent-accent"
                  data-avatar-zoom
                />
              </label>
            </div>
            {admin && (
              <label class="flex items-start gap-3 text-sm">
                <input
                  type="checkbox"
                  class="mt-0.5 size-4 shrink-0 accent-accent"
                  data-avatar-original
                />
                <span>Keep the picture as it is: no crop, no resizing.</span>
              </label>
            )}
            <p
              aria-live="assertive"
              class="text-sm font-medium"
              data-avatar-error
            ></p>
            <div class="flex flex-wrap gap-3">
              <button type="submit" class={buttonClasses()}>
                Save picture
              </button>
            </div>
          </form>
        </div>
        {user.avatarHash && (
          <form method="post" action="/account/avatar">
            <input type="hidden" name="intent" value="remove" />
            <button
              type="submit"
              class="group type-label cursor-pointer text-muted hover:text-ink"
            >
              <span class="link-wipe">Remove picture</span>
            </button>
          </form>
        )}
      </div>
    </div>

    <form
      method="post"
      action="/account/profile/"
      class="mt-7 flex flex-col gap-12 md:mt-8 xl:mt-12"
      novalidate
      data-profile-form
    >
      <div class={row}>
        <h2 class={heading}>Preview</h2>
        <div class={body}>
          <div
            class="flex items-center gap-5 border border-ink p-4 md:p-5"
            data-preview
          >
            <Avatar user={user} size="md" />
            <div class="flex min-w-0 flex-col gap-1">
              <p class="type-card truncate" data-preview-name>
                {displayName({
                  ...user,
                  displayName: values.displayName.trim() || null,
                })}
              </p>
              <p class="type-label flex flex-wrap gap-x-3 text-muted">
                <span>@{user.username}</span>
                <span data-preview-pronouns>{values.pronouns}</span>
              </p>
              <p class="truncate text-muted" data-preview-status>
                {values.status}
              </p>
            </div>
          </div>
          <p class="text-muted">
            {values.profilePublic ? (
              <>
                Your profile is public at{" "}
                <a href={profileHref(user.username)} class="link-wipe text-ink">
                  {profileHref(user.username)}
                </a>
                .
              </>
            ) : (
              "Your profile is private: only you can see it."
            )}
          </p>
        </div>
      </div>

      <div class={row}>
        <h2 class={heading}>About you</h2>
        <div class={body}>
          <div class="flex flex-col gap-2">
            <label for="username" class="font-medium">
              Username
            </label>
            <input
              id="username"
              name="username"
              value={username}
              readonly={canRenameAt !== null}
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              minlength={USERNAME_LIMITS.min}
              maxlength={USERNAME_LIMITS.max}
              aria-invalid={usernameError ? "true" : undefined}
              aria-describedby="username-hint"
              class:list={[
                input,
                "font-mono",
                canRenameAt !== null && "bg-chip text-muted",
              ]}
            />
            <p
              id="username-hint"
              class:list={[
                "text-sm",
                usernameError ? "text-ink" : "text-muted",
              ]}
            >
              {usernameError ? (
                <strong class="font-medium">{usernameError}</strong>
              ) : canRenameAt ? (
                `You changed it recently. You can change it again on ${formatPostDate(canRenameAt)}.`
              ) : (
                `In your profile’s address and next to your comments. Lower-case letters, digits and hyphens. Links to the old one keep working for ${String(USERNAME_HOLD_DAYS)} days.`
              )}
            </p>
          </div>

          {lines.map((line) => (
            <div class="flex flex-col gap-2">
              <label for={line.name} class="font-medium">
                {line.label}
              </label>
              <input
                id={line.name}
                name={line.name}
                value={values[line.name]}
                placeholder={line.placeholder || undefined}
                autocomplete={line.autocomplete}
                maxlength={PROFILE_LIMITS[line.name] * 2}
                aria-invalid={errors[line.name] ? "true" : undefined}
                aria-describedby={`${line.name}-hint`}
                class={input}
                data-preview-source={line.name}
              />
              <p
                id={`${line.name}-hint`}
                class:list={[
                  "text-sm",
                  errors[line.name] ? "text-ink" : "text-muted",
                ]}
              >
                {errors[line.name] ? (
                  <strong class="font-medium">{errors[line.name]}</strong>
                ) : (
                  line.hint
                )}
              </p>
            </div>
          ))}

          <div class="flex flex-col gap-2">
            <label for="bio" class="font-medium">
              Bio
            </label>
            <textarea
              id="bio"
              name="bio"
              rows="6"
              aria-invalid={errors.bio ? "true" : undefined}
              aria-describedby="bio-hint"
              class:list={[input, "font-serif leading-relaxed"]}
            >{values.bio}</textarea>
            <p
              id="bio-hint"
              class:list={["text-sm", errors.bio ? "text-ink" : "text-muted"]}
            >
              {errors.bio ? (
                <strong class="font-medium">{errors.bio}</strong>
              ) : (
                <>
                  Up to {PROFILE_LIMITS.bio} characters. Formatting as in
                  comments: *emphasis*, **bold**, `code`, &gt; quotes and links.
                </>
              )}
            </p>
          </div>
        </div>
      </div>

      <div role="group" aria-labelledby="links-heading" class={row}>
        <h2 id="links-heading" class={heading}>
          Links
        </h2>
        <div class={body}>
          <p class="text-muted">
            Up to {PROFILE_LIMITS.links}: your site, socials, projects. Leave a
            label empty to use the site’s name.
          </p>
          <ol class="flex flex-col gap-4">
            {values.links.map((link, index) => {
              const key = `link-${String(index)}` as const;
              const error = errors[key];
              return (
                <li class="grid grid-cols-[1.75rem_1fr] gap-x-3 gap-y-2 md:grid-cols-[1.75rem_minmax(0,1fr)_minmax(0,2fr)]">
                  <span class="type-label pt-3.5 text-muted">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="flex flex-col gap-1">
                    <label for={`link-label-${String(index)}`} class="sr-only">
                      Link {index + 1} label
                    </label>
                    <input
                      id={`link-label-${String(index)}`}
                      name={`link-label-${String(index)}`}
                      value={link.label}
                      placeholder="Label"
                      maxlength={PROFILE_LIMITS.linkLabel * 2}
                      aria-invalid={error ? "true" : undefined}
                      aria-describedby={error ? `${key}-error` : undefined}
                      class={input}
                    />
                  </div>
                  <div class="col-start-2 flex flex-col gap-1 md:col-start-3">
                    <label for={`link-url-${String(index)}`} class="sr-only">
                      Link {index + 1} address
                    </label>
                    <input
                      id={`link-url-${String(index)}`}
                      name={`link-url-${String(index)}`}
                      value={link.url}
                      placeholder="https://"
                      inputmode="url"
                      autocomplete="url"
                      maxlength={PROFILE_LIMITS.linkUrl + 20}
                      aria-invalid={error ? "true" : undefined}
                      aria-describedby={error ? `${key}-error` : undefined}
                      class={input}
                    />
                  </div>
                  {error && (
                    <p
                      id={`${key}-error`}
                      class="col-start-2 text-sm font-medium md:col-span-2"
                    >
                      {error}
                    </p>
                  )}
                </li>
              );
            })}
          </ol>
        </div>
      </div>

      <div role="group" aria-labelledby="privacy-heading" class={row}>
        <h2 id="privacy-heading" class={heading}>
          Privacy
        </h2>
        <div class={body}>
          <div class="flex items-start gap-3">
            <input
              id="profilePublic"
              type="checkbox"
              name="profilePublic"
              checked={values.profilePublic}
              aria-describedby="profilePublic-hint"
              class="mt-1 size-4 shrink-0 accent-accent"
            />
            <div>
              <label for="profilePublic" class="font-medium">
                Public profile
              </label>
              <p id="profilePublic-hint" class="text-muted">
                Anyone can see your profile page, and your name on comments
                links to it. Off: only you can see it, and your name links to
                GitHub.
              </p>
            </div>
          </div>

          <div
            role="radiogroup"
            aria-labelledby="comment-name-label"
            class="flex flex-col gap-3"
          >
            <p id="comment-name-label" class="font-medium">
              Sign your comments as
            </p>
            <label class="flex items-start gap-3">
              <input
                type="radio"
                name="commentName"
                value="display"
                checked={values.commentName === "display"}
                class="mt-1 size-4 shrink-0 accent-accent"
              />
              <span>Your display name, with @{user.username} beside it</span>
            </label>
            <label class="flex items-start gap-3">
              <input
                type="radio"
                name="commentName"
                value="username"
                checked={values.commentName === "username"}
                class="mt-1 size-4 shrink-0 accent-accent"
              />
              <span>Just @{user.username}</span>
            </label>
          </div>
        </div>
      </div>

      <div class={row}>
        <div class="col-span-4 flex flex-wrap gap-3 md:col-span-8 xl:col-span-12">
          <button type="submit" class={buttonClasses()}>
            Save profile
          </button>
          <a
            href={profileHref(user.username)}
            class={buttonClasses({ variant: "secondary" })}
          >
            View profile
          </a>
        </div>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  import { displayName, monogram } from "../../lib/profile/profile";

  // The preview card follows the form as it's typed in.
  const form = document.querySelector<HTMLFormElement>("[data-profile-form]");
  const preview = form?.querySelector<HTMLElement>("[data-preview]");
  if (form && preview) {
    const login =
      document.querySelector<HTMLInputElement>("#username")?.value ?? "";
    const githubName =
      document.querySelector<HTMLInputElement>("#displayName")?.placeholder ??
      login;
    const value = (name: string) =>
      form
        .querySelector<HTMLInputElement>(`[data-preview-source="${name}"]`)
        ?.value.trim() ?? "";
    const set = (selector: string, text: string) => {
      const element = preview.querySelector(selector);
      if (element) element.textContent = text;
    };
    const update = () => {
      const person = {
        username: login,
        name: githubName,
        displayName: value("displayName") || null,
      };
      set("[data-preview-name]", displayName(person));
      set("[data-monogram]", monogram(person));
      set("[data-preview-pronouns]", value("pronouns"));
      set("[data-preview-status]", value("status"));
    };
    form.addEventListener("input", update);
  }
</script>

<script>
  import { cropToSquare, coverRect } from "../../lib/profile/crop";

  // The picture form: crop to a square in the browser, send a small WebP. Without
  // this, the form sends the file as it is and the server checks it.
  const form = document.querySelector<HTMLFormElement>("[data-avatar-form]");
  const input = form?.querySelector<HTMLInputElement>('input[type="file"]');
  const panel = form?.querySelector<HTMLElement>("[data-avatar-crop]");
  const canvas = form?.querySelector<HTMLCanvasElement>("[data-avatar-canvas]");
  const zoomInput = form?.querySelector<HTMLInputElement>("[data-avatar-zoom]");
  const errorBox = form?.querySelector<HTMLElement>("[data-avatar-error]");
  const context = canvas?.getContext("2d");
  if (form && input && panel && canvas && zoomInput && errorBox && context) {
    const size = Number(form.dataset.size ?? "256");
    let image: ImageBitmap | null = null;
    // The crop's centre, as a fraction of the picture.
    let centre = { x: 0.5, y: 0.5 };

    const draw = () => {
      if (!image) return;
      const rect = coverRect(image, Number(zoomInput.value), centre);
      centre = { x: rect.centreX, y: rect.centreY };
      context.clearRect(0, 0, size, size);
      context.drawImage(
        image,
        rect.x,
        rect.y,
        rect.side,
        rect.side,
        0,
        0,
        size,
        size,
      );
    };

    input.addEventListener("change", async () => {
      errorBox.textContent = "";
      const file = input.files?.[0];
      if (!file) return;
      try {
        image = await createImageBitmap(file);
      } catch {
        image = null;
        panel.hidden = true;
        errorBox.textContent =
          "That file isn’t a picture this browser can read.";
        return;
      }
      centre = { x: 0.5, y: 0.5 };
      zoomInput.value = "1";
      panel.hidden =
        form.querySelector<HTMLInputElement>("[data-avatar-original]")
          ?.checked ?? false;
      draw();
    });
    zoomInput.addEventListener("input", draw);

    // Dragging moves the picture under the square.
    let drag: { x: number; y: number } | null = null;
    canvas.addEventListener("pointerdown", (event) => {
      drag = { x: event.clientX, y: event.clientY };
      canvas.setPointerCapture(event.pointerId);
    });
    canvas.addEventListener("pointermove", (event) => {
      if (!drag || !image) return;
      const rect = coverRect(image, Number(zoomInput.value), centre);
      const scale = rect.side / canvas.clientWidth;
      centre = {
        x: centre.x - ((event.clientX - drag.x) * scale) / image.width,
        y: centre.y - ((event.clientY - drag.y) * scale) / image.height,
      };
      drag = { x: event.clientX, y: event.clientY };
      draw();
    });
    canvas.addEventListener("pointerup", () => (drag = null));
    canvas.addEventListener("keydown", (event) => {
      const step = 0.02;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-step, 0],
        ArrowRight: [step, 0],
        ArrowUp: [0, -step],
        ArrowDown: [0, step],
      };
      const move = moves[event.key];
      if (!move) return;
      event.preventDefault();
      centre = { x: centre.x + move[0], y: centre.y + move[1] };
      draw();
    });

    const original = form.querySelector<HTMLInputElement>(
      "[data-avatar-original]",
    );
    original?.addEventListener("change", () => {
      panel.hidden = original.checked || !image;
    });
    form.addEventListener("submit", async (event) => {
      // Kept as it is (the admin's choice): the plain form sends the file.
      if (!image || original?.checked) return;
      event.preventDefault();
      errorBox.textContent = "";
      const blob = await cropToSquare(canvas);
      const body = new FormData();
      body.set("avatar", blob, "avatar");
      const response = await fetch(form.action, {
        method: "POST",
        body,
        headers: { Accept: "application/json" },
      }).catch(() => null);
      if (response?.ok) {
        window.location.assign("/account/profile/?avatar=saved#avatar");
        return;
      }
      const reply = (await response?.json().catch(() => null)) as {
        error?: string;
      } | null;
      errorBox.textContent =
        reply?.error ?? "The picture couldn’t be saved. Try again.";
    });
  }
</script>
