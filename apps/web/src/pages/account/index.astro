---
import DisplayTitle from "../../components/DisplayTitle.astro";
import { buttonClasses } from "@trilleo/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdmin, requireUser } from "../../lib/auth/guard";
import { postTitles } from "../../lib/blog/store";
import { renderComment } from "../../lib/comments/render";
import { userComments } from "../../lib/comments/store";
import { getDb } from "../../lib/db";
import { formatPostDate } from "../../lib/listings";
import { postHref } from "../../lib/posts";
import { displayName, profileHref } from "../../lib/profile/profile";
import Monogram from "../../components/account/Monogram.astro";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const admin = isAdmin(user);
const own = await userComments(await getDb(), user.id);
const titles = await postTitles(await getDb());
const STATUS = {
  pending: "Awaiting approval",
  published: "Published",
  hidden: "Hidden by the admin",
} as const;
---

<BaseLayout title="Account" noindex>
  <section
    aria-labelledby="account-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label text-ink">(Account) @{user.githubLogin}</p>

    <DisplayTitle id="account-title">Account</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-6 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">You</h2>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-10">
        <div class="flex items-center gap-4">
          <Monogram user={user} size="md" />
          <p class="text-lg">
            Signed in with GitHub as <strong>{displayName(user)}</strong>
            (@{user.githubLogin}).
          </p>
        </div>
        <p class="text-muted">
          {admin || user.trustedAt
            ? "Your comments appear right away."
            : "Your first comment appears once it’s approved; after that, right away."}
        </p>
        <div class="flex flex-wrap gap-3">
          {admin && (
            <a href="/admin" class={buttonClasses()}>
              Admin
            </a>
          )}
          <form method="post" action="/auth/logout">
            <button
              type="submit"
              class={buttonClasses({
                variant: admin ? "secondary" : "primary",
              })}
            >
              Sign out
            </button>
          </form>
          <form method="post" action="/auth/logout">
            <input type="hidden" name="everywhere" value="1" />
            <button
              type="submit"
              class={buttonClasses({ variant: "secondary" })}
            >
              Sign out everywhere
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        Your profile
      </h2>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7">
        <p>
          {user.profilePublic ? (
            <>
              Your profile is public at{" "}
              <a href={profileHref(user.githubLogin)} class="link-wipe">
                {profileHref(user.githubLogin)}
              </a>
              . Add a display name, a bio and links, or make it private.
            </>
          ) : (
            "Your profile is private: only you can see it. Add a display name, a bio and links, or make it public."
          )}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/account/profile/" class={buttonClasses()}>
            Edit profile
          </a>
          <a
            href={profileHref(user.githubLogin)}
            class={buttonClasses({ variant: "secondary" })}
          >
            View profile
          </a>
        </div>
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">Email</h2>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7">
        <p>
          {user.email
            ? `Notifications go to ${user.email}: replies to your comments and decisions on your uploads.`
            : "Add an email address to hear about replies to your comments and decisions on your uploads."}
        </p>
        <div>
          <a href="/account/email/" class={buttonClasses()}>
            {user.email ? "Email settings" : "Add an address"}
          </a>
        </div>
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        Minecraft
      </h2>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7">
        <p>
          Share your mods, plugins, worlds, builds and packs: each gets a page,
          a gallery and releases to download.
        </p>
        <div>
          <a href="/account/minecraft/" class={buttonClasses()}>
            Your projects
          </a>
        </div>
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">Privacy</h2>
      <ul class="col-span-4 flex flex-col md:col-span-6 xl:col-span-7">
        <li class="border-b border-hair">
          <a
            href="/account/files/"
            class="group flex min-h-14 flex-col justify-center gap-0.5 py-3"
          >
            <span class="link-wipe type-nav w-fit">Files</span>
            <span class="text-muted">
              What you’ve uploaded, how much room is left, and appeals.
            </span>
          </a>
        </li>
        <li class="border-b border-hair">
          <a
            href="/account/sessions/"
            class="group flex min-h-14 flex-col justify-center gap-0.5 py-3"
          >
            <span class="link-wipe type-nav w-fit">Sessions</span>
            <span class="text-muted">
              See where you’re signed in, and sign out of other browsers.
            </span>
          </a>
        </li>
        <li>
          <a
            href="/account/export.json"
            download
            class="group flex min-h-14 flex-col justify-center gap-0.5 py-3"
          >
            <span class="link-wipe type-nav w-fit">Download your data</span>
            <span class="text-muted">
              Your account, profile, sessions, comments, tool data, files,
              Minecraft projects and the email we sent you, as JSON.
            </span>
          </a>
        </li>
      </ul>
    </div>

    <div
      id="comments"
      class="grid-swiss mt-12 scroll-mt-6 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6"
    >
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        Your comments ({own.length})
      </h2>
      <div class="col-span-4 md:col-span-6 xl:col-span-10">
        {own.length === 0 ? (
          <p class="text-muted">You haven’t commented yet.</p>
        ) : (
          <ol class="flex flex-col">
            {own.map((comment) => (
              <li class="flex flex-col gap-2.5 border-t border-hair py-5 first:border-t-0 first:pt-0">
                <p class="type-label flex flex-wrap gap-x-3 gap-y-1 text-muted">
                  <a
                    href={`${postHref(comment.postSlug)}#comment-${String(comment.id)}`}
                    class="link-wipe text-ink"
                  >
                    {titles.get(comment.postSlug) ?? comment.postSlug}
                  </a>
                  <time datetime={comment.createdAt.toISOString()}>
                    {formatPostDate(comment.createdAt)}
                  </time>
                  <span>{STATUS[comment.status]}</span>
                </p>
                <div class="comment-body">
                  <Fragment set:html={renderComment(comment.body)} />
                </div>
                <details class="type-label text-muted">
                  <summary class="link-wipe w-fit cursor-pointer hover:text-ink">
                    Delete
                  </summary>
                  <form method="post" action="/comments/delete" class="mt-2">
                    <input type="hidden" name="id" value={String(comment.id)} />
                    <input
                      type="hidden"
                      name="back"
                      value="/account#comments"
                    />
                    <button
                      type="submit"
                      class="type-label border border-ink px-2.5 py-1.5 text-ink hover:bg-ink hover:text-paper"
                    >
                      Yes, delete this comment
                    </button>
                  </form>
                </details>
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        Delete account
      </h2>
      <form
        method="post"
        action="/account/delete"
        class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7"
      >
        <p>
          Deletes your account, all your comments, everything saved in tools
          (like your notes), and your Minecraft projects with their files. Where
          others replied to you, a “removed” note keeps their replies readable.
          This can’t be undone; signing in again later starts a new, empty
          account.
        </p>
        <label class="flex items-start gap-3">
          <input
            type="checkbox"
            name="confirm"
            value="yes"
            required
            class="mt-1 size-4 shrink-0 accent-accent"
          />
          I understand: delete my account and comments.
        </label>
        <div>
          <button type="submit" class={buttonClasses({ variant: "secondary" })}>
            Delete my account
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
