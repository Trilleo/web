---
/**
 * Starting a conversation: who it's for (usernames, ?to= fills it in), a subject
 * and the first message. POST here; a refused one comes back as typed.
 */
import { MESSAGE_LIMITS } from "@trilleo/forum";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import PostForm from "../../../components/forum/PostForm.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireUser } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { field } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import {
  MESSAGE_ERRORS,
  messagingRole,
  parseRecipients,
  startConversation,
} from "../../../lib/forum/conversations";
import { loadTree } from "../../../lib/forum/store";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const tree = await loadTree(db);
const role = await messagingRole(db, tree, user);
let to = Astro.url.searchParams.get("to") ?? "";
let subject = "";
let body = "";
let error: string | null = null;
if (Astro.request.method === "POST" && role.problem === null) {
  const form = await Astro.request.formData();
  to = field(form, "to");
  subject = field(form, "subject");
  body = field(form, "body");
  const result = await startConversation(db, {
    tree,
    sender: user,
    to: parseRecipients(to),
    subject,
    body,
  });
  if (result.ok)
    return noStoreRedirect(
      `/account/messages/${String(result.value.id)}/`,
      303,
    );
  error = MESSAGE_ERRORS[result.error];
  Astro.response.status = 422;
}
const input = "w-full border border-ink bg-paper px-3 py-2.5 text-base";
---

<BaseLayout title="New message" noindex>
  <section
    aria-labelledby="new-message-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label text-ink">
      (Account){" "}
      <a href="/account/messages/" class="link-wipe">
        Messages
      </a>
    </p>
    <DisplayTitle id="new-message-title" fit={7.2}>
      New message
    </DisplayTitle>
    <div class="grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-label col-span-4 md:col-span-2 xl:col-span-2">Private</p>
      <div class="col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-7">
        {role.problem ? (
          <p role="alert" class="border-l-2 border-accent pl-4">
            {MESSAGE_ERRORS[role.problem]}
          </p>
        ) : (
          <>
            {error && (
              <p role="alert" class="border-l-2 border-accent pl-4">
                {error}
              </p>
            )}
            <div class="contents">
              <div class="flex flex-col gap-2">
                <label for="message-to" class="font-medium">
                  To
                </label>
                <input
                  id="message-to"
                  name="to"
                  value={to}
                  form="message-form"
                  autocapitalize="none"
                  spellcheck="false"
                  aria-describedby="message-to-hint"
                  class:list={[input, "font-mono"]}
                />
                <p id="message-to-hint" class="text-sm text-muted">
                  Usernames, separated by commas: up to{" "}
                  {MESSAGE_LIMITS.members - 1} people.
                </p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="message-subject" class="font-medium">
                  Subject
                </label>
                <input
                  id="message-subject"
                  name="subject"
                  value={subject}
                  form="message-form"
                  maxlength={MESSAGE_LIMITS.subject * 2}
                  class={input}
                />
              </div>
            </div>
            <PostForm
              action="/account/messages/new/"
              body={body}
              submitLabel="Send"
              label="Message"
              id="message-form"
              rows={8}
              cancel="/account/messages/"
            />
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
