---
import DisplayTitle from "../components/DisplayTitle.astro";
import { ArrowRightIcon, ArrowUpRightIcon } from "@trilleo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorJsonLd, breadcrumbJsonLd } from "../lib/seo";
import { GITHUB_URL, SITE_NAME } from "../lib/site";

const links = [
  {
    label: "Writing",
    detail: "Notes on building this site, and what comes out of the projects.",
    href: "/writing/",
  },
  {
    label: "Tools",
    detail: "Small web tools that work in your browser.",
    href: "/tools/",
  },
  {
    label: "Games",
    detail: "Browser games drawn in text, made for long, slow play.",
    href: "/games/",
  },
  {
    label: "GitHub",
    detail: "Code releases and the source of this site.",
    href: GITHUB_URL,
  },
] as const;
---

<BaseLayout
  title="About"
  description={`What ${SITE_NAME} is, what you'll find here, and how to join in.`}
  jsonLd={[
    authorJsonLd(),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" },
    ]),
  ]}
>
  <section
    aria-labelledby="about-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label">(03) About</p>

    <DisplayTitle id="about-title">About</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-8 border-t border-ink pt-4 md:mt-8 md:gap-y-10 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-lead col-span-4 md:col-span-6 md:col-start-3 xl:col-start-3">
        {SITE_NAME} is Trilleo’s corner of the web: Minecraft creations, code,
        and learning resources, collected in one place.
      </p>

      <div class="col-span-4 flex flex-col gap-4 text-[15px] leading-[1.6] text-muted md:col-span-6 md:col-start-3 xl:col-span-6 xl:col-start-3 xl:text-base">
        <p>
          Everything here is picked and made by hand. The writing explains how
          things are built; the tools are small, useful, and free to use without
          an account.
        </p>
        <p>
          Want to join in? Sign in with GitHub to comment on posts and keep your
          tool data in your account. Your first comment is read before it
          appears; after that, you post straight away.
        </p>
      </div>

      <nav
        aria-label="Around the site"
        class="col-span-4 flex flex-col border-t border-ink md:col-span-6 md:col-start-3 xl:col-span-3 xl:col-start-10 xl:row-span-2 xl:row-start-1"
      >
        {links.map((link) => {
          const external = link.href.startsWith("http");
          return (
            <a
              href={link.href}
              class="group flex min-h-12 flex-col gap-1 border-b border-ink py-3"
            >
              <span class="flex items-center justify-between font-semibold">
                <span class="link-wipe">{link.label}</span>
                {external ? (
                  <ArrowUpRightIcon
                    size={16}
                    className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                ) : (
                  <ArrowRightIcon className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:translate-x-1" />
                )}
              </span>
              <span class="text-[14px] leading-[1.5] text-muted">
                {link.detail}
              </span>
            </a>
          );
        })}
      </nav>
    </div>
  </section>
</BaseLayout>
