---
import DisplayTitle from "../components/DisplayTitle.astro";
import { ArrowRightIcon, ArrowUpRightIcon } from "@trilleo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorJsonLd, breadcrumbJsonLd } from "../lib/seo";
import { CONTACT_EMAIL, GITHUB_URL, SITE_NAME } from "../lib/site";

const links = [
  {
    label: "Writing",
    href: "/writing/",
  },
  {
    label: "Tools",
    href: "/tools/",
  },
  {
    label: "Games",
    href: "/games/",
  },
  {
    label: "Minecraft",
    href: "/minecraft/",
  },
  {
    label: "Contact",
    href: "/contact/",
  },
  {
    label: "GitHub",
    href: GITHUB_URL,
  },
] as const;

const facts = [
  { term: "Run by", value: "Trilleo, an individual in mainland China" },
  {
    term: "Sections",
    value: "Writing, Tools, Games, Minecraft, Study, Forum",
  },
  {
    term: "Accounts",
    value: "Email code or GitHub; your first comment or post is reviewed",
  },
  { term: "Built with", value: "Astro, React, Tailwind, Postgres" },
  { term: "Hosted on", value: "One small server, behind Cloudflare" },
] as const;
---

<BaseLayout
  title="About"
  description={`What ${SITE_NAME} is, what you'll find here, and how to join in.`}
  jsonLd={[
    authorJsonLd(),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" },
    ]),
  ]}
>
  <section
    aria-labelledby="about-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label">(04) About</p>

    <DisplayTitle id="about-title">About</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-8 border-t border-ink pt-4 md:mt-8 md:gap-y-10 md:pt-5 xl:mt-12 xl:pt-6">
      <div class="col-span-4 flex flex-col gap-8 md:col-span-8 md:gap-10 xl:col-span-9">
        <p class="type-lead">{SITE_NAME} is Trilleo’s personal site.</p>
        <dl class="grid grid-cols-1 border-t border-ink md:grid-cols-[10rem_1fr]">
          {facts.map((fact) => (
            <>
              <dt class="type-label pt-3 text-muted md:border-b md:border-hair md:pb-3">
                {fact.term}
              </dt>
              <dd class="border-b border-hair pb-3 md:pt-3">{fact.value}</dd>
            </>
          ))}
          <dt class="type-label pt-3 text-muted md:border-b md:border-hair md:pb-3">
            Source
          </dt>
          <dd class="border-b border-hair pb-3 md:pt-3">
            <a href={GITHUB_URL} class="group">
              <span class="link-wipe">
                {GITHUB_URL.replace(/^https:\/\//, "")}
              </span>
            </a>
          </dd>
          <dt class="type-label pt-3 text-muted md:border-b md:border-hair md:pb-3">
            Contact
          </dt>
          <dd class="border-b border-hair pb-3 md:pt-3">
            <a href={`mailto:${CONTACT_EMAIL}`} class="group">
              <span class="link-wipe">{CONTACT_EMAIL}</span>
            </a>
          </dd>
        </dl>
      </div>

      <nav
        aria-label="Around the site"
        class="col-span-4 flex flex-col border-t border-ink md:col-span-8 xl:col-span-3 xl:col-start-10 xl:row-start-1"
      >
        {links.map((link) => {
          const external = link.href.startsWith("http");
          return (
            <a
              href={link.href}
              class="group flex min-h-12 flex-col gap-1 border-b border-ink py-3"
            >
              <span class="flex items-center justify-between font-semibold">
                <span class="link-wipe">{link.label}</span>
                {external ? (
                  <ArrowUpRightIcon
                    size={16}
                    className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                ) : (
                  <ArrowRightIcon className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:translate-x-1" />
                )}
              </span>
            </a>
          );
        })}
      </nav>
    </div>
  </section>
</BaseLayout>
