---
/**
 * A topic: its posts, page by page (?page=), and the reply form (POST here; a
 * refused reply comes back with the text and what's wrong, Preview shows it
 * rendered). ?quote=<post> starts the reply with that post quoted; in threaded
 * forums ?reply=<post> answers that post. Posts come in the forum's layout's order.
 * Opening it marks it read (and offers a jump to what was new). The address is
 * /forum/<forum>/<id>-<slug>/: any other forum or slug redirects there.
 */
import {
  FORUM_LIMITS,
  can,
  excerpt,
  forumPath,
  plainText,
  parseTopicSegment,
  postPath,
  quoteFor,
  topicPath,
  topicSegment,
} from "@trilleo/forum";
import { buttonClasses } from "@trilleo/ui";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Pager from "../../../components/forum/Pager.astro";
import PostForm from "../../../components/forum/PostForm.astro";
import PostItem from "../../../components/forum/PostItem.astro";
import BanNotice from "../../../components/forum/BanNotice.astro";
import Notices from "../../../components/forum/Notices.astro";
import TopicBadges from "../../../components/forum/TopicBadges.astro";
import { draftKey } from "../../../lib/forum/drafts";
import { isWatching, signaturesOf } from "../../../lib/forum/notifications";
import { reactionsFor, votesFor } from "../../../lib/forum/reactions";
import { firstPostAfter, markRead } from "../../../lib/forum/reads";
import { reputationOf } from "../../../lib/forum/reputation";
import { prefixesById, prefixesOf, tagsOf } from "../../../lib/forum/tags";
import { discussionJsonLd, topicCard } from "../../../lib/forum/seo";
import { breadcrumbJsonLd, ogImagePath } from "../../../lib/seo";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { field, parseId } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import { activeBan } from "../../../lib/forum/access";
import { postErrorMessage, postErrorStatus } from "../../../lib/forum/messages";
import { mergedTarget } from "../../../lib/forum/moderation";
import {
  FORUM_NUMBER,
  counted,
  formatWhen,
  pageParam,
} from "../../../lib/forum/public";
import {
  countView,
  createReply,
  forumViewer,
  getPost,
  getTopic,
  listPosts,
  loadTree,
  renderBody,
  usernameOf,
} from "../../../lib/forum/store";

export const prerender = false;

const db = await getDb();
const user = Astro.locals.user ?? null;

const id = parseTopicSegment(Astro.params.topic ?? "");
const topic = id === null ? undefined : await getTopic(db, id);
const tree = await loadTree(db);
const viewer = await forumViewer(db, tree, user);
const node = topic ? tree.get(topic.forumId) : undefined;
if (!topic && id !== null) {
  // A merged topic's address goes on to the topic it joined.
  const merged = await mergedTarget(db, id);
  const mergedNode = merged ? tree.get(merged.forumId) : undefined;
  if (
    merged &&
    mergedNode &&
    can(viewer, "forum.view", tree.place(mergedNode.forum), merged)
  )
    return Astro.redirect(topicPath(mergedNode.forum, merged), 301);
}
if (
  !topic ||
  !node ||
  !can(viewer, "forum.view", tree.place(node.forum), topic)
)
  return Astro.rewrite("/404");
const { forum } = node;

// One address per topic.
if (
  Astro.params.forum !== forum.slug ||
  Astro.params.topic !== topicSegment(topic)
) {
  return Astro.redirect(topicPath(forum, topic) + Astro.url.search, 301);
}
Astro.response.headers.set("Cache-Control", "private, no-store");

const place = tree.place(forum);
const mod = tree.moderates(forum, viewer);
const now = new Date();
const canReply = can(viewer, "topic.reply", place, topic);
const here = Astro.url.pathname + Astro.url.search;

const threaded = forum.layout === "threaded";
const qa = forum.layout === "qa";
let replyBody = "";
let parentId: number | null = null;
let replyError: string | undefined;
let preview: string | null = null;

if (Astro.request.method === "POST") {
  if (!user)
    return noStoreRedirect(
      `/sign-in?next=${encodeURIComponent(topicPath(forum, topic))}`,
      303,
    );
  const form = await Astro.request.formData();
  replyBody = field(form, "body");
  parentId = threaded ? parseId(field(form, "parent")) : null;
  if (field(form, "intent") === "preview") {
    preview = await renderBody(db, replyBody);
  } else {
    const result = await createReply(db, {
      tree,
      forum,
      topic,
      author: user,
      body: replyBody,
      parentId,
    });
    if (result.ok) return noStoreRedirect(postPath(result.value), 303);
    replyError = postErrorMessage(result.error, replyBody.length);
    Astro.response.status = postErrorStatus(result.error);
  }
} else {
  await countView(db, topic.id);
  parentId = threaded
    ? parseId(Astro.url.searchParams.get("reply") ?? "")
    : null;
  const quoteId = parseId(Astro.url.searchParams.get("quote") ?? "");
  const quoted = quoteId === null ? undefined : await getPost(db, quoteId);
  if (quoted && quoted.topicId === topic.id && canReply) {
    const author = await usernameOf(db, quoted.authorId);
    replyBody = quoteFor(quoted, author, postPath(quoted));
  }
}

const listed = await listPosts(db, {
  topic,
  layout: forum.layout,
  viewer,
  mod,
  page: pageParam(Astro.url),
  adminTitle: tree.groups.get("admin")?.title ?? null,
});
const ban = viewer?.banned && user ? await activeBan(db, user.id) : undefined;
const postIds = listed.posts.map((view) => view.post.id);
const authorIds = listed.posts.flatMap((view) =>
  view.author ? [view.author.id] : [],
);
const [reactions, myVotes, reputation, signatures, tags, prefixes, watching] =
  await Promise.all([
    reactionsFor(db, postIds, user?.id ?? null),
    qa
      ? votesFor(db, postIds, user?.id ?? null)
      : Promise.resolve(new Map<number, number>()),
    reputationOf(db, authorIds),
    signaturesOf(db, authorIds),
    tagsOf(db, [topic.id]),
    topic.prefixId === null
      ? Promise.resolve(new Map())
      : prefixesById(db, [topic.prefixId]),
    user
      ? isWatching(db, user.id, { topicId: topic.id })
      : Promise.resolve(false),
  ]);
const topicTags = tags.get(topic.id) ?? [];
const prefix =
  topic.prefixId === null ? null : (prefixes.get(topic.prefixId) ?? null);
// The asker (while they may edit) and moderators can change the prefix and tags.
const canLabel =
  mod ||
  (topic.authorId !== null &&
    topic.authorId === user?.id &&
    can(viewer, "post.edit-own", place, topic, { authorId: topic.authorId }));
const forumPrefixes = canLabel ? await prefixesOf(db, forum.id) : [];
// Reading it: remember how far, and offer a jump to what was new.
const readBefore =
  user && Astro.request.method === "GET"
    ? await markRead(db, user.id, topic)
    : null;
const firstUnread =
  readBefore !== null &&
  topic.lastPostId !== null &&
  readBefore < topic.lastPostId
    ? await firstPostAfter(db, topic.id, readBefore)
    : null;
const asker = user !== null && topic.authorId === user.id;
const canSolve = (asker || mod) && user !== null;
// Threaded: the post being answered.
const parent =
  parentId === null
    ? undefined
    : listed.posts.find((view) => view.post.id === parentId);
const parentPost =
  parentId === null || parent ? undefined : await getPost(db, parentId);
const replyingTo =
  parentId !== null && (parent || parentPost?.topicId === topic.id)
    ? {
        label: `Replying to ${parent?.author ? `@${parent.author.username}` : "a post"}`,
        cancel: `${topicPath(forum, topic)}#reply`,
      }
    : undefined;
const replyHref = (postId: number) =>
  `${topicPath(forum, topic, listed.page)}${listed.page > 1 ? "&" : "?"}reply=${String(postId)}#reply`;
const card = topicCard(topic, forum);
const image = ogImagePath(`forum/${String(topic.id)}`, card);
const jsonLd =
  topic.state === "published" && !place.hidden && listed.page === 1
    ? [
        discussionJsonLd({
          topic,
          path: topicPath(forum, topic),
          posts: listed.posts,
          image,
        }),
        breadcrumbJsonLd([
          { name: "Forum", path: "/forum/" },
          { name: forum.name, path: forumPath(forum) },
          { name: topic.title, path: topicPath(forum, topic) },
        ]),
      ]
    : [];
// Where a moderator can move or split to: forums they moderate.
const targets = mod
  ? tree
      .flat()
      .filter(
        (option) =>
          option.forum.kind === "forum" && tree.moderates(option.forum, viewer),
      )
  : [];
const opening = listed.page === 1 ? listed.posts[0] : undefined;
const description = opening
  ? excerpt(plainText(opening.html), 160)
  : `A topic in ${forum.name}.`;
const crumbs = [
  { label: `(${FORUM_NUMBER}) Forum`, href: "/forum/" },
  ...tree.ancestors(forum.id).map((parent) => ({
    label: parent.name,
    href: forumPath(parent),
  })),
  { label: forum.name, href: forumPath(forum) },
];
const quoteHref = (postId: number) =>
  `${topicPath(forum, topic, listed.page)}${listed.page > 1 ? "&" : "?"}quote=${String(postId)}#reply`;
const firstNumber = (listed.page - 1) * FORUM_LIMITS.postsPerPage + 1;
const modForm = "/forum/action";
const firstPostId = topic.firstPostId ?? 0;
---

<BaseLayout
  title={
    listed.page > 1
      ? `${topic.title} (page ${String(listed.page)})`
      : topic.title
  }
  description={description}
  noindex={topic.state !== "published" || place.hidden}
  image={image}
  imageAlt={topic.title}
  jsonLd={jsonLd}
  feeds={[
    {
      title: `${topic.title} (RSS)`,
      href: `${topicPath(forum, topic)}rss.xml`,
    },
  ]}
>
  <section
    aria-labelledby="topic-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <Breadcrumb items={crumbs} class="type-label" />

    <div class="mt-5 flex flex-col gap-3 xl:mt-7">
      <h1 id="topic-title" class="type-band max-w-[22ch] break-words">
        {topic.title}
      </h1>
      <p class="type-label flex flex-wrap items-center gap-x-4 gap-y-1 text-muted">
        <TopicBadges topic={topic} prefix={prefix} />
        <span>
          Started{" "}
          <time datetime={topic.createdAt.toISOString()}>
            {formatWhen(topic.createdAt, now)}
          </time>
        </span>
        <span>{counted(topic.replyCount, "reply", "replies")}</span>
        <span>{counted(topic.viewCount, "view")}</span>
      </p>
      {topicTags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Tags">
          {topicTags.map((tag) => (
            <li>
              <a
                href={`/forum/tags/${tag}/`}
                class="type-label inline-flex border border-hair px-2 py-1 hover:border-ink"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {firstUnread !== null && (
          <a
            href={postPath({ id: firstUnread })}
            class="group type-label inline-flex items-center gap-1.5 text-ink"
          >
            <span class="size-2 bg-accent" aria-hidden="true" />
            <span class="link-wipe">Jump to first unread</span>
          </a>
        )}
        {user && (
          <form method="post" action="/forum/engage">
            <input
              type="hidden"
              name="do"
              value={watching ? "unwatch" : "watch"}
            />
            <input type="hidden" name="topic" value={String(topic.id)} />
            <input type="hidden" name="back" value={here} />
            <button
              type="submit"
              class="group type-label cursor-pointer text-muted hover:text-ink"
            >
              <span class="link-wipe">
                {watching ? "Stop watching" : "Watch this topic"}
              </span>
            </button>
          </form>
        )}
        {canSolve && (
          <form method="post" action="/forum/engage">
            <input
              type="hidden"
              name="do"
              value={topic.solvedAt ? "unsolved" : "solved"}
            />
            <input type="hidden" name="topic" value={String(topic.id)} />
            <input type="hidden" name="back" value={here} />
            <button
              type="submit"
              class="group type-label cursor-pointer text-muted hover:text-ink"
            >
              <span class="link-wipe">
                {topic.solvedAt ? "Mark not solved" : "Mark solved"}
              </span>
            </button>
          </form>
        )}
        <a
          href={`${topicPath(forum, topic)}rss.xml`}
          class="group type-label text-muted hover:text-ink"
        >
          <span class="link-wipe">RSS</span>
        </a>
        {canLabel && (
          <details class="type-label text-muted">
            <summary class="link-wipe w-fit cursor-pointer hover:text-ink">
              Prefix and tags
            </summary>
            <form
              method="post"
              action="/forum/engage"
              class="mt-3 flex flex-wrap items-end gap-2 font-sans text-sm tracking-normal text-ink normal-case"
            >
              <input type="hidden" name="do" value="labels" />
              <input type="hidden" name="topic" value={String(topic.id)} />
              <input type="hidden" name="back" value={here} />
              {forumPrefixes.length > 0 && (
                <div class="flex flex-col gap-1">
                  <label for="labels-prefix">Prefix</label>
                  <select
                    id="labels-prefix"
                    name="prefix"
                    class="h-9 border border-ink bg-paper px-2"
                  >
                    <option value="">None</option>
                    {forumPrefixes.map((option) => (
                      <option
                        value={String(option.id)}
                        selected={option.id === topic.prefixId}
                      >
                        {option.label}
                      </option>
                    ))}
                  </select>
                </div>
              )}
              <div class="flex flex-col gap-1">
                <label for="labels-tags">Tags</label>
                <input
                  id="labels-tags"
                  name="tags"
                  value={topicTags.join(", ")}
                  class="h-9 w-56 border border-ink bg-paper px-2 font-mono"
                />
              </div>
              <button
                type="submit"
                class="type-label h-9 border border-ink px-3 hover:bg-ink hover:text-paper"
              >
                Save
              </button>
            </form>
          </details>
        )}
      </div>
    </div>

    <Notices />

    {mod && (
      <div
        role="group"
        aria-label="Moderate this topic"
        class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border border-ink p-3"
      >
        <span class="type-label text-muted">Moderate</span>
        <form method="post" action={modForm}>
          <input type="hidden" name="post" value={String(firstPostId)} />
          <input
            type="hidden"
            name="action"
            value={topic.locked ? "unlock" : "lock"}
          />
          <input type="hidden" name="back" value={here} />
          <button type="submit" class="group type-label cursor-pointer">
            <span class="link-wipe">{topic.locked ? "Unlock" : "Lock"}</span>
          </button>
        </form>
        <form method="post" action={modForm} class="flex items-center gap-2">
          <input type="hidden" name="post" value={String(firstPostId)} />
          <input type="hidden" name="back" value={here} />
          <label for="pin-choice" class="type-label">
            Pin
          </label>
          <select
            id="pin-choice"
            name="action"
            class="type-label h-9 border border-ink bg-paper px-2"
          >
            <option value="pin-none" selected={topic.pinned === "none"}>
              Not pinned
            </option>
            <option value="pin-forum" selected={topic.pinned === "forum"}>
              In this forum
            </option>
            <option value="pin-global" selected={topic.pinned === "global"}>
              As an announcement
            </option>
          </select>
          <button type="submit" class="group type-label cursor-pointer">
            <span class="link-wipe">Set</span>
          </button>
        </form>
        <form method="post" action={modForm} class="flex items-center gap-2">
          <input type="hidden" name="post" value={String(firstPostId)} />
          <input type="hidden" name="action" value="move" />
          <input type="hidden" name="back" value={here} />
          <label for="move-to" class="type-label">
            Move to
          </label>
          <select
            id="move-to"
            name="forum"
            class="type-label h-9 max-w-48 border border-ink bg-paper px-2"
          >
            {targets.map((option) => (
              <option
                value={String(option.forum.id)}
                selected={option.forum.id === forum.id}
              >
                {"— ".repeat(option.depth)}
                {option.forum.name}
              </option>
            ))}
          </select>
          <button type="submit" class="group type-label cursor-pointer">
            <span class="link-wipe">Move</span>
          </button>
        </form>
        <form method="post" action={modForm} class="flex items-center gap-2">
          <input type="hidden" name="post" value={String(firstPostId)} />
          <input type="hidden" name="action" value="merge" />
          <input type="hidden" name="back" value={here} />
          <label for="merge-into" class="type-label">
            Merge into
          </label>
          <input
            id="merge-into"
            name="into"
            placeholder="Topic address or number"
            class="h-9 w-48 border border-ink bg-paper px-2 text-sm"
          />
          <button type="submit" class="group type-label cursor-pointer">
            <span class="link-wipe">Merge</span>
          </button>
        </form>
        <form
          method="post"
          action={modForm}
          id="split-form"
          class="flex flex-wrap items-center gap-2"
        >
          <input type="hidden" name="post" value={String(firstPostId)} />
          <input type="hidden" name="action" value="split" />
          <input type="hidden" name="back" value={here} />
          <label for="split-title" class="type-label">
            Split ticked posts into
          </label>
          <input
            id="split-title"
            name="title"
            placeholder="New topic’s title"
            class="h-9 w-56 border border-ink bg-paper px-2 text-sm"
          />
          <label for="split-forum" class="sr-only">
            Forum for the new topic
          </label>
          <select
            id="split-forum"
            name="forum"
            class="type-label h-9 max-w-48 border border-ink bg-paper px-2"
          >
            {targets.map((option) => (
              <option
                value={String(option.forum.id)}
                selected={option.forum.id === forum.id}
              >
                {"— ".repeat(option.depth)}
                {option.forum.name}
              </option>
            ))}
          </select>
          <button type="submit" class="group type-label cursor-pointer">
            <span class="link-wipe">Split</span>
          </button>
        </form>
      </div>
    )}

    <div class="mt-8 md:mt-10" data-testid="posts">
      {listed.posts.map((view, index) => (
        <PostItem
          view={view}
          number={firstNumber + index}
          quoteHref={canReply ? quoteHref(view.post.id) : undefined}
          canEdit={
            mod || can(viewer, "post.edit-own", place, topic, view.post, now)
          }
          canDelete={can(viewer, "post.delete-own", place, topic, view.post)}
          canReport={
            viewer !== null &&
            view.post.authorId !== viewer.id &&
            can(viewer, "post.report", place, topic)
          }
          splitForm={mod ? "split-form" : undefined}
          viewerId={viewer?.id}
          reactions={reactions.get(view.post.id) ?? []}
          canReact={can(viewer, "post.react", place, topic, view.post)}
          votes={
            qa && !view.first
              ? {
                  score: view.post.score,
                  mine: myVotes.get(view.post.id) ?? 0,
                  canVote: can(viewer, "post.vote", place, topic, view.post),
                }
              : undefined
          }
          canAccept={qa && !view.first && canSolve}
          replyHref={
            threaded && canReply && !view.first
              ? replyHref(view.post.id)
              : undefined
          }
          signature={view.author ? signatures.get(view.author.id) : undefined}
          reputation={view.author ? reputation.get(view.author.id) : undefined}
          mod={mod}
          back={here}
          now={now}
        />
      ))}
    </div>

    {listed.pages > 1 && (
      <div class="mt-6 border-t border-hair pt-6">
        <Pager
          page={listed.page}
          pages={listed.pages}
          base={topicPath(forum, topic)}
          label="Topic pages"
        />
      </div>
    )}

    <section
      id="reply"
      aria-labelledby="reply-title"
      class="grid-swiss mt-12 scroll-mt-6 gap-y-5 border-t border-ink pt-4 md:pt-5 xl:pt-6"
    >
      <h2
        id="reply-title"
        class="type-label col-span-4 md:col-span-2 xl:col-span-2"
      >
        Reply
      </h2>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 xl:col-span-7">
        {ban ? (
          <BanNotice ban={ban} />
        ) : canReply ? (
          <>
            {preview !== null && (
              <div
                class="border border-hair p-4"
                aria-labelledby="preview-title"
              >
                <p id="preview-title" class="type-label mb-3 text-muted">
                  Preview
                </p>
                <div class="comment-body forum-body">
                  <Fragment set:html={preview} />
                </div>
              </div>
            )}
            {replyError && (
              <p role="alert" class="border-l-2 border-accent pl-4">
                {replyError}
              </p>
            )}
            <PostForm
              action={`${topicPath(forum, topic)}#reply`}
              body={replyBody}
              errors={{ body: replyError }}
              submitLabel={qa ? "Post answer" : "Post reply"}
              label={qa ? "Your answer" : "Your reply"}
              hidden={
                parentId !== null && replyingTo
                  ? { parent: String(parentId) }
                  : {}
              }
              replyingTo={replyingTo}
              draftKey={draftKey.reply(topic.id)}
              id="reply-form"
              rows={8}
            />
          </>
        ) : !user ? (
          <p>
            <a
              href={`/sign-in?next=${encodeURIComponent(`${topicPath(forum, topic)}#reply`)}`}
              class={buttonClasses()}
            >
              Sign in to reply
            </a>
          </p>
        ) : (
          <p class="text-muted">
            {user.blockedAt
              ? "Your account can’t post here."
              : topic.locked || forum.locked
                ? "This topic is locked: no new replies."
                : "You can’t reply to this topic."}
          </p>
        )}
      </div>
    </section>
  </section>
</BaseLayout>
