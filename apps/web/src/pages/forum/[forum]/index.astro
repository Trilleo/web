---
/**
 * A category (its forums) or a forum: its subforums, then its topics, pinned ones
 * first, page by page (?page=), filtered by ?filter= (unanswered, solved,
 * unsolved) and ?prefix=. New ones are marked for the signed-in. A forum the
 * viewer may not see is a 404.
 */
import { can, forumPath } from "@trilleo/forum";
import { buttonClasses } from "@trilleo/ui";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ForumRows from "../../../components/forum/ForumRows.astro";
import Pager from "../../../components/forum/Pager.astro";
import TopicList from "../../../components/forum/TopicList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getDb } from "../../../lib/db";
import { parseId } from "../../../lib/comments/form";
import { isWatching } from "../../../lib/forum/notifications";
import { FORUM_NUMBER, counted, pageParam } from "../../../lib/forum/public";
import { unreadOf } from "../../../lib/forum/reads";
import { prefixesOf } from "../../../lib/forum/tags";
import {
  TOPIC_FILTERS,
  forumViewer,
  isTopicFilter,
  lastPostsById,
  type TopicFilter,
  listTopics,
  loadTree,
} from "../../../lib/forum/store";

export const prerender = false;

const db = await getDb();
const user = Astro.locals.user;
const tree = await loadTree(db);
const viewer = await forumViewer(db, tree, user);
const node = tree.find(Astro.params.forum ?? "");
if (!node || !tree.canView(node.forum, viewer)) return Astro.rewrite("/404");
Astro.response.headers.set("Cache-Control", "private, no-store");

const { forum } = node;
const place = tree.place(forum);
const mod = tree.moderates(forum, viewer);
const visible = tree.visible(viewer);
const children = visible.get(forum.id)?.children ?? [];
const lastIds = children.flatMap((child) =>
  child.lastPostId === null ? [] : [child.lastPostId],
);
const lastPosts = await lastPostsById(db, lastIds);
const page = pageParam(Astro.url);
const filterParam = Astro.url.searchParams.get("filter") ?? "all";
const filter: TopicFilter = isTopicFilter(filterParam) ? filterParam : "all";
const prefixes = forum.kind === "forum" ? await prefixesOf(db, forum.id) : [];
const prefixParam = parseId(Astro.url.searchParams.get("prefix") ?? "");
const prefixId = prefixes.some((prefix) => prefix.id === prefixParam)
  ? prefixParam
  : null;
const listed =
  forum.kind === "forum"
    ? await listTopics(db, { forum, viewer, mod, page, filter, prefixId })
    : { topics: [], total: 0, pages: 1 };
const unread = user
  ? await unreadOf(
      db,
      user,
      listed.topics.map((row) => row.topic),
    )
  : new Set<number>();
const watching = user
  ? await isWatching(db, user.id, { forumId: forum.id })
  : false;
const query = (changes: Record<string, string | null>) => {
  const params = new URLSearchParams();
  const values = {
    filter: filter === "all" ? null : filter,
    prefix: prefixId === null ? null : String(prefixId),
    ...changes,
  };
  for (const [key, value] of Object.entries(values))
    if (value) params.set(key, value);
  const text = params.toString();
  return text ? `${forumPath(forum)}?${text}` : forumPath(forum);
};
const listBase = query({});
const canStart = can(viewer, "topic.create", place);
const crumbs = [
  { label: `(${FORUM_NUMBER}) Forum`, href: "/forum/" },
  ...tree.ancestors(forum.id).map((parent) => ({
    label: parent.name,
    href: forumPath(parent),
  })),
  { label: forum.name },
];
const newHref = `/forum/new/?in=${encodeURIComponent(forum.slug)}`;
const now = new Date();
---

<BaseLayout
  title={page > 1 ? `${forum.name} (page ${String(page)})` : forum.name}
  description={forum.description || `Topics in ${forum.name}.`}
  noindex={forum.hidden || filter !== "all" || prefixId !== null}
  feeds={
    forum.kind === "forum"
      ? [{ title: `${forum.name} (RSS)`, href: `${forumPath(forum)}rss.xml` }]
      : []
  }
>
  <section
    aria-labelledby="forum-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <Breadcrumb items={crumbs} class="type-label" />

    <div class="grid-swiss mt-5 items-end gap-y-4 xl:mt-7">
      <div class="col-span-4 flex flex-col gap-3 md:col-span-6 xl:col-span-9">
        <h1 id="forum-title" class="type-band break-words">
          {forum.name}
        </h1>
        {forum.description && (
          <p class="type-dek text-muted">{forum.description}</p>
        )}
      </div>
      <div class="col-span-4 flex flex-wrap gap-3 md:col-span-2 md:justify-end xl:col-span-3">
        {forum.kind === "forum" &&
          (canStart ? (
            <a href={newHref} class={buttonClasses()}>
              New topic
            </a>
          ) : !user ? (
            <a
              href={`/sign-in?next=${encodeURIComponent(newHref)}`}
              class={buttonClasses()}
            >
              Sign in to post
            </a>
          ) : null)}
        {user && (
          <form method="post" action="/forum/engage">
            <input
              type="hidden"
              name="do"
              value={watching ? "unwatch" : "watch"}
            />
            <input type="hidden" name="forum" value={String(forum.id)} />
            <input
              type="hidden"
              name="back"
              value={Astro.url.pathname + Astro.url.search}
            />
            <button
              type="submit"
              class={buttonClasses({ variant: "secondary" })}
            >
              {watching ? "Stop watching" : "Watch"}
            </button>
          </form>
        )}
        {mod && (
          <a
            href={`/admin/forum/${String(forum.id)}/`}
            class={buttonClasses({ variant: "secondary" })}
          >
            Edit forum
          </a>
        )}
      </div>
    </div>

    {(forum.locked || forum.hidden) && (
      <p role="status" class="mt-6 border-l-2 border-accent pl-4">
        {forum.hidden
          ? "This forum is hidden: only moderators can see it."
          : "This forum is locked: only moderators can start topics or reply."}
      </p>
    )}

    {children.length > 0 && (
      <section aria-labelledby="subforums-title" class="mt-10 md:mt-12">
        <h2 id="subforums-title" class="type-label mb-3">
          {forum.kind === "category" ? "Forums" : "Subforums"}
        </h2>
        <ForumRows nodes={children} lastPosts={lastPosts} now={now} />
      </section>
    )}

    {forum.kind === "forum" && (
      <section aria-labelledby="topics-title" class="mt-10 md:mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="topics-title" class="type-label">
            Topics
          </h2>
          <p class="type-label text-muted">{counted(listed.total, "topic")}</p>
        </div>
        <nav
          aria-label="Show topics"
          class="type-label mb-4 flex flex-wrap items-center gap-x-5 gap-y-2"
        >
          {Object.entries(TOPIC_FILTERS).map(([key, label]) => (
            <a
              href={query({ filter: key === "all" ? null : key })}
              class="group inline-flex items-center gap-2"
              aria-current={filter === key ? "page" : undefined}
            >
              <span
                class:list={[
                  "size-2",
                  filter === key ? "bg-accent" : "bg-transparent",
                ]}
                aria-hidden="true"
              />
              <span class="link-wipe">{label}</span>
            </a>
          ))}
          {prefixes.length > 0 && (
            <form
              method="get"
              action={forumPath(forum)}
              class="flex items-center gap-2"
            >
              {filter !== "all" && (
                <input type="hidden" name="filter" value={filter} />
              )}
              <label for="prefix-filter">Prefix</label>
              <select
                id="prefix-filter"
                name="prefix"
                class="h-8 border border-ink bg-paper px-2"
              >
                <option value="">Any</option>
                {prefixes.map((prefix) => (
                  <option
                    value={String(prefix.id)}
                    selected={prefix.id === prefixId}
                  >
                    {prefix.label}
                  </option>
                ))}
              </select>
              <button type="submit" class="group cursor-pointer">
                <span class="link-wipe">Show</span>
              </button>
            </form>
          )}
          <a
            href={`${forumPath(forum)}rss.xml`}
            class="group text-muted hover:text-ink"
          >
            <span class="link-wipe">RSS</span>
          </a>
        </nav>
        <TopicList
          topics={listed.topics}
          now={now}
          unread={unread}
          empty={
            filter !== "all" || prefixId !== null
              ? "No topics match."
              : canStart
                ? "No topics yet. Start the first one."
                : "No topics yet."
          }
        />
        {listed.pages > 1 && (
          <div class="mt-6">
            <Pager
              page={Math.min(page, listed.pages)}
              pages={listed.pages}
              base={listBase}
              label="Topic pages"
            />
          </div>
        )}
      </section>
    )}
  </section>
</BaseLayout>
