---
/**
 * Starting a topic in a forum: /forum/new/?in=<forum>. POST here; a refused topic
 * comes back with what was typed and what's wrong, Preview shows it rendered.
 */
import {
  ATTACHMENT_LIMITS,
  can,
  forumPath,
  parseTags,
  postPath,
  validatePoll,
  type PollDraft,
  type PollField,
} from "@trilleo/forum";
import PollFields from "../../components/forum/PollFields.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BanNotice from "../../components/forum/BanNotice.astro";
import PostForm from "../../components/forum/PostForm.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireUser } from "../../lib/auth/guard";
import { noStoreRedirect } from "../../lib/auth/redirect";
import { field, parseId } from "../../lib/comments/form";
import { getDb } from "../../lib/db";
import {
  isTitleError,
  postErrorMessage,
  postErrorStatus,
} from "../../lib/forum/messages";
import { activeBan } from "../../lib/forum/access";
import { draftKey } from "../../lib/forum/drafts";
import { FORUM_NUMBER } from "../../lib/forum/public";
import { popularTags, prefixesOf } from "../../lib/forum/tags";
import {
  createTopic,
  forumViewer,
  loadTree,
  renderBody,
} from "../../lib/forum/store";
import { toastError } from "../../lib/toast";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;
Astro.response.headers.set("Cache-Control", "private, no-store");

const db = await getDb();
const tree = await loadTree(db);
const viewer = await forumViewer(db, tree, user);
const node = tree.find(Astro.url.searchParams.get("in") ?? "");
if (!node || !tree.canView(node.forum, viewer)) return Astro.rewrite("/404");
const { forum } = node;
const allowed = can(viewer, "topic.create", tree.place(forum));
const canPoll = can(viewer, "poll.create", tree.place(forum));
const canAttach = can(viewer, "post.attach", tree.place(forum));
const ban = viewer?.banned ? await activeBan(db, user.id) : undefined;

let title = "";
let body = "";
let tags = "";
let prefixId: number | null = null;
let attachments: string[] = [];
let poll: PollDraft = {
  question: "",
  options: "",
  multiple: false,
  maxChoices: "",
  length: "never",
  resultsBeforeVote: false,
};
let pollErrors: Partial<Record<PollField, string>> = {};
let errors: { title?: string; body?: string } = {};
let preview: string | null = null;

if (Astro.request.method === "POST" && allowed) {
  const form = await Astro.request.formData();
  title = field(form, "title");
  body = field(form, "body");
  tags = field(form, "tags");
  prefixId = parseId(field(form, "prefix"));
  attachments = form
    .getAll("attachments")
    .filter((value) => typeof value === "string");
  poll = {
    question: field(form, "pollQuestion"),
    options: field(form, "pollOptions"),
    multiple: field(form, "pollMultiple") === "on",
    maxChoices: field(form, "pollMax"),
    length: field(form, "pollLength"),
    resultsBeforeVote: field(form, "pollResults") === "on",
  };
  const checkedPoll = canPoll
    ? validatePoll(poll, new Date())
    : { ok: true as const, poll: null };
  if (!checkedPoll.ok) {
    pollErrors = checkedPoll.errors;
    Astro.response.status = 422;
  } else if (field(form, "intent") === "preview") {
    preview = await renderBody(db, body);
  } else {
    const result = await createTopic(db, {
      tree,
      forum,
      author: user,
      title,
      body,
      tags: parseTags(tags),
      prefixId,
      attachments,
      poll: checkedPoll.poll,
    });
    if (result.ok) return noStoreRedirect(postPath(result.value.post), 303);
    const message = postErrorMessage(result.error, body.length);
    errors = isTitleError(result.error)
      ? { title: message }
      : { body: message };
    Astro.response.status = postErrorStatus(result.error);
  }
}
const waits = !can(viewer, "post.skip-review", tree.place(forum));
const prefixes = await prefixesOf(db, forum.id);
const suggestions = (await popularTags(db)).map((row) => row.name);
const crumbs = [
  { label: `(${FORUM_NUMBER}) Forum`, href: "/forum/" },
  ...tree.ancestors(forum.id).map((parent) => ({
    label: parent.name,
    href: forumPath(parent),
  })),
  { label: forum.name, href: forumPath(forum) },
  { label: "New topic" },
];
if (errors.title || errors.body || Object.keys(pollErrors).length > 0)
  toastError(Astro, "Not posted: check the fields marked below.");
---

<BaseLayout title={`New topic in ${forum.name}`} noindex>
  <section
    aria-labelledby="new-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <Breadcrumb items={crumbs} class="type-label" />
    <h1 id="new-title" class="type-band mt-5 xl:mt-7">
      New topic
    </h1>

    <div class="grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        In {forum.name}
      </p>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 xl:col-span-7">
        {ban ? (
          <BanNotice ban={ban} />
        ) : !allowed ? (
          <p role="alert" class="border-l-2 border-accent pl-4">
            {user.blockedAt
              ? "Your account can’t post here."
              : forum.kind === "category"
                ? "Topics go in a forum, not a category. Choose one of its forums."
                : "This forum is locked: only moderators can start topics."}
          </p>
        ) : (
          <>
            {waits && (
              <p class="text-muted">
                A moderator will look at your topic before others can see it.
              </p>
            )}
            {preview !== null && (
              <div class="border border-hair p-4">
                <p class="type-label mb-3 text-muted">Preview</p>
                {title.trim() && <p class="type-card mb-4">{title.trim()}</p>}
                <div class="comment-body forum-body">
                  <Fragment set:html={preview} />
                </div>
              </div>
            )}
            <PostForm
              action={`/forum/new/?in=${encodeURIComponent(forum.slug)}`}
              title={title}
              body={body}
              errors={errors}
              prefixes={prefixes}
              prefixId={prefixId}
              tags={tags}
              suggestions={suggestions}
              draftKey={draftKey.topic(forum.id)}
              submitLabel={
                forum.layout === "qa" ? "Ask question" : "Post topic"
              }
              id="topic-form"
              rows={14}
              cancel={forumPath(forum)}
              attach={
                canAttach
                  ? { room: ATTACHMENT_LIMITS.perPost - attachments.length }
                  : undefined
              }
              pending={attachments}
            >
              {canPoll && (
                <PollFields slot="extra" draft={poll} errors={pollErrors} />
              )}
            </PostForm>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
