---
/**
 * The forum's front page: announcements, then each category's forums (counts and
 * the newest post), with recent topics and the forum's numbers beside them.
 * Server-rendered: it depends on who's looking (hidden forums, their own topics
 * waiting for approval).
 */
import { buttonClasses } from "@trilleo/ui";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";
import ForumRows from "../../components/forum/ForumRows.astro";
import TopicList from "../../components/forum/TopicList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDb } from "../../lib/db";
import {
  FORUM_DESCRIPTION,
  FORUM_NUMBER,
  counted,
} from "../../lib/forum/public";
import {
  forumStats,
  forumViewer,
  lastPostsById,
  loadTree,
  recentTopics,
} from "../../lib/forum/store";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const db = await getDb();
const user = Astro.locals.user;
const fullTree = await loadTree(db);
const viewer = await forumViewer(db, fullTree, user);
const tree = fullTree.visible(viewer);
const [announcements, recent, stats] = await Promise.all([
  recentTopics(db, { tree, viewer, limit: 5, announcements: true }),
  recentTopics(db, { tree, viewer, limit: 8 }),
  forumStats(db, tree),
]);
const lastIds = tree
  .flat()
  .flatMap((node) => (node.lastPostId === null ? [] : [node.lastPostId]));
const lastPosts = await lastPostsById(db, [...new Set(lastIds)]);
const now = new Date();
const canPost = user !== undefined && user !== null && user.blockedAt === null;
---

<BaseLayout title="Forum" description={FORUM_DESCRIPTION}>
  <section
    aria-labelledby="forum-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <Breadcrumb
      items={[{ label: `(${FORUM_NUMBER}) Forum` }]}
      class="type-label"
    />
    <DisplayTitle id="forum-title">Forum</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-lead col-span-4 md:col-span-8 xl:col-span-9">
        {FORUM_DESCRIPTION}
      </p>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-8 xl:col-span-3">
        <p class="type-label flex flex-wrap gap-x-4 gap-y-1 text-muted">
          <span>{counted(stats.topics, "topic")}</span>
          <span>{counted(stats.posts, "post")}</span>
          <span>{counted(stats.members, "member")}</span>
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/forum/recent/"
            class={buttonClasses({ variant: "secondary" })}
          >
            Recent topics
          </a>
          {!canPost && (
            <a
              href={`/sign-in?next=${encodeURIComponent("/forum/")}`}
              class={buttonClasses()}
            >
              Sign in to post
            </a>
          )}
        </div>
        <form
          method="get"
          action="/forum/search/"
          role="search"
          class="flex gap-2"
        >
          <label for="forum-search" class="sr-only">
            Search the forum
          </label>
          <input
            id="forum-search"
            type="search"
            name="q"
            placeholder="Search the forum"
            class="h-11 min-w-0 flex-1 border-b border-ink bg-transparent text-base focus:outline-none focus-visible:border-accent"
          />
          <button type="submit" class={buttonClasses({ variant: "secondary" })}>
            Search
          </button>
        </form>
      </div>
    </div>

    {announcements.length > 0 && (
      <section aria-labelledby="announcements-title" class="mt-14 md:mt-16">
        <h2 id="announcements-title" class="type-label mb-3">
          Announcements
        </h2>
        <TopicList topics={announcements} showForum now={now} />
      </section>
    )}

    {tree.roots.length === 0 && (
      <p class="mt-14 text-muted">There are no forums yet.</p>
    )}

    {tree.roots.map((root) => (
      <section
        aria-labelledby={`category-${root.forum.slug}`}
        class="mt-14 md:mt-16"
      >
        <div class="grid-swiss mb-3 items-baseline gap-y-1">
          <h2
            id={`category-${root.forum.slug}`}
            class="type-card col-span-4 md:col-span-5 xl:col-span-7"
          >
            {root.forum.kind === "category" ? (
              root.forum.name
            ) : (
              <a href={`/forum/${root.forum.slug}/`} class="group">
                <span class="link-wipe">{root.forum.name}</span>
              </a>
            )}
          </h2>
          {root.forum.description && (
            <p class="col-span-4 text-muted md:col-span-3 xl:col-span-5">
              {root.forum.description}
            </p>
          )}
        </div>
        {root.children.length > 0 ? (
          <ForumRows nodes={root.children} lastPosts={lastPosts} now={now} />
        ) : (
          <p class="border-t border-ink pt-4 text-muted">Nothing here yet.</p>
        )}
      </section>
    ))}

    {recent.length > 0 && (
      <section aria-labelledby="recent-title" class="mt-16 md:mt-20">
        <div class="mb-3 flex items-baseline justify-between gap-4">
          <h2 id="recent-title" class="type-card">
            Recent topics
          </h2>
          <a href="/forum/recent/" class="group type-label">
            <span class="link-wipe">All recent topics</span>
          </a>
        </div>
        <TopicList topics={recent} showForum now={now} />
      </section>
    )}
  </section>
</BaseLayout>
