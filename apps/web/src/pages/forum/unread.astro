---
/**
 * What's new for the signed-in person: recent topics with posts they haven't read,
 * and "Mark all read".
 */
import { buttonClasses } from "@trilleo/ui";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";
import TopicList from "../../components/forum/TopicList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireUser } from "../../lib/auth/guard";
import { getDb } from "../../lib/db";
import { FORUM_NUMBER } from "../../lib/forum/public";
import { unreadOf } from "../../lib/forum/reads";
import { forumViewer, loadTree, recentTopics } from "../../lib/forum/store";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;
Astro.response.headers.set("Cache-Control", "private, no-store");

const LOOK_AT = 200;
const db = await getDb();
const tree = await loadTree(db);
const viewer = await forumViewer(db, tree, user);
const recent = await recentTopics(db, { tree, viewer, limit: LOOK_AT });
const unread = await unreadOf(
  db,
  user,
  recent.map((row) => row.topic),
);
const topics = recent.filter((row) => unread.has(row.topic.id));
---

<BaseLayout title="Unread · Forum" noindex>
  <section
    aria-labelledby="unread-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <Breadcrumb
      items={[
        { label: `(${FORUM_NUMBER}) Forum`, href: "/forum/" },
        { label: "Unread" },
      ]}
      class="type-label"
    />
    <DisplayTitle id="unread-title">Unread</DisplayTitle>
    <div class="mt-7 flex flex-wrap items-center justify-between gap-4 md:mt-8 xl:mt-12">
      <p class="text-muted">
        Topics with posts you haven’t read yet, newest first.
      </p>
      {topics.length > 0 && (
        <form method="post" action="/forum/engage">
          <input type="hidden" name="do" value="read-all" />
          <input type="hidden" name="back" value="/forum/unread/" />
          <button type="submit" class={buttonClasses({ variant: "secondary" })}>
            Mark all read
          </button>
        </form>
      )}
    </div>
    <div class="mt-6">
      <TopicList
        topics={topics}
        showForum
        unread={unread}
        empty="You’re all caught up."
      />
    </div>
  </section>
</BaseLayout>
