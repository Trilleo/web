---
/** One release: its changelog, files, Minecraft versions, loaders and dependencies. */
import { formatBytes } from "@trilleo/tool-kit/files";
import { buttonClasses } from "@trilleo/ui";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import MinecraftHeader from "../../../../../components/minecraft/MinecraftHeader.astro";
import BuildMaterials from "../../../../../components/minecraft/BuildMaterials.astro";
import BuildViewer from "../../../../../components/minecraft/BuildViewer";
import { previewFor, previewPath } from "../../../../../lib/minecraft/previews";
import { getDb } from "../../../../../lib/db";
import { formatPostDate } from "../../../../../lib/listings";
import {
  channelLabel,
  dependencyKindLabel,
  loaderLabel,
  typeInfo,
} from "../../../../../lib/minecraft/catalog";
import { compareVersions } from "../../../../../lib/minecraft/game-versions";
import { lookupProject } from "../../../../../lib/minecraft/page";
import {
  MINECRAFT_PATH,
  projectPath,
  releaseEditPath,
  releasesPath,
  typePath,
} from "../../../../../lib/minecraft/paths";
import { SECTION_LABEL } from "../../../../../lib/minecraft/public";
import { plainText } from "../../../../../lib/minecraft/render";
import { findRelease, releasesOf } from "../../../../../lib/minecraft/store";
import { breadcrumbJsonLd, truncate } from "../../../../../lib/seo";
import { STATUS_LABELS } from "../../../../../lib/storage/labels";
import { downloadPath } from "../../../../../lib/storage/service";

export const prerender = false;

const db = await getDb();
const version = decodeURIComponent(Astro.params.version ?? "");
const lookup = await lookupProject(
  db,
  Astro.params,
  Astro.locals.user,
  `releases/${encodeURIComponent(version)}/`,
);
if (lookup.kind === "missing") return Astro.rewrite("/404");
if (lookup.kind === "redirect") return Astro.redirect(lookup.location, 301);
const { project, viewer, editable, listed } = lookup;
if (editable) Astro.response.headers.set("Cache-Control", "private, no-store");

const release = await findRelease(db, project.id, version);
const entry = release
  ? (await releasesOf(db, project, viewer, { releaseId: release.id }))[0]
  : undefined;
if (!release || !entry) return Astro.rewrite("/404");

const info = typeInfo(project.type);
const preview =
  project.type === "build"
    ? await previewFor(db, project, viewer, release.id)
    : null;
const path = Astro.url.pathname;
const versions = [...release.gameVersions].sort(compareVersions);
const title = `${project.name} ${release.version}`;
const description = truncate(
  release.changelog
    ? plainText(release.changelog)
    : `${project.name} ${release.version} for Minecraft ${versions.at(-1) ?? ""}–${versions[0] ?? ""}.`,
);
const body = "col-span-4 md:col-span-6 xl:col-span-7";
---

<BaseLayout
  title={`${title} · Minecraft ${info.label}`}
  {description}
  noindex={!listed || !entry.live}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Minecraft", path: MINECRAFT_PATH },
      { name: info.plural, path: typePath(project.type) },
      { name: project.name, path: projectPath(project) },
      { name: release.version, path },
    ]),
  ]}
>
  <article
    aria-labelledby="page-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <MinecraftHeader
      crumbs={[
        { label: SECTION_LABEL, href: MINECRAFT_PATH },
        { label: info.plural, href: typePath(project.type) },
        { label: project.name, href: projectPath(project) },
        { label: "Releases", href: releasesPath(project) },
        { label: release.version },
      ]}
      title={title}
      size="title"
      note={channelLabel(release.channel)}
    />
    {release.title && <p class="type-dek mt-4 text-muted">{release.title}</p>}

    {editable && !entry.live && (
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-l-2 border-accent pl-4">
        <p class="type-lead">Not out yet: its main file isn’t published.</p>
        <a
          href={releaseEditPath(project.id, release.id)}
          class={buttonClasses({ variant: "secondary" })}
        >
          Edit release
        </a>
      </div>
    )}

    <div class="grid-swiss mt-8 gap-y-8 border-t border-ink pt-4 md:mt-10 md:pt-5 xl:mt-12 xl:pt-6">
      <dl class="col-span-4 grid content-start grid-cols-2 gap-x-4 gap-y-3 md:col-span-2 md:grid-cols-1 xl:col-span-2">
        <div class="flex flex-col gap-0.5">
          <dt class="type-label text-muted">Released</dt>
          <dd>{formatPostDate(release.releasedAt ?? release.createdAt)}</dd>
        </div>
        <div class="flex flex-col gap-0.5">
          <dt class="type-label text-muted">Channel</dt>
          <dd>{channelLabel(release.channel)}</dd>
        </div>
        {release.loaders.length > 0 && (
          <div class="flex flex-col gap-0.5">
            <dt class="type-label text-muted">
              {project.type === "plugin" ? "Platforms" : "Loaders"}
            </dt>
            <dd>{release.loaders.map(loaderLabel).join(", ")}</dd>
          </div>
        )}
        <div class="col-span-2 flex flex-col gap-1 md:col-span-1">
          <dt class="type-label text-muted">Minecraft</dt>
          <dd
            class="type-label flex flex-wrap gap-1.5"
            data-testid="release-versions"
          >
            {versions.map((id) => (
              <span class="border border-hair px-1.5 py-0.5">{id}</span>
            ))}
          </dd>
        </div>
      </dl>

      <div class:list={[body, "flex flex-col gap-10"]}>
        {preview && (
          <BuildViewer
            client:visible
            previewUrl={previewPath(preview.fileId)}
            size={[preview.width, preview.height, preview.length]}
            blocks={preview.blocks}
            name={title}
          />
        )}
        {preview && (
          <BuildMaterials
            materials={preview.materials}
            blocks={preview.blocks}
          />
        )}
        <section aria-labelledby="files-title" class="flex flex-col gap-3">
          <h2 id="files-title" class="type-label">
            Files
          </h2>
          <ol class="border-b border-ink">
            {entry.files.map(({ file, primary }) => (
              <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-ink py-4">
                <div class="flex min-w-0 flex-col gap-1">
                  <p class="font-medium break-all">
                    {primary && (
                      <span class="type-label mr-2 bg-accent px-1.5 py-0.5 align-middle text-on-accent">
                        Main
                      </span>
                    )}
                    {file.name}
                  </p>
                  <p class="type-label flex flex-wrap gap-x-4 text-muted">
                    <span>{file.label}</span>
                    <span>{formatBytes(file.size)}</span>
                    {file.sha256 && file.status === "published" && (
                      <span title={file.sha256}>
                        SHA-256 {file.sha256.slice(0, 12)}…
                      </span>
                    )}
                    {file.status !== "published" && (
                      <span>{STATUS_LABELS[file.status]}</span>
                    )}
                  </p>
                </div>
                {file.status === "published" && (
                  <a
                    href={downloadPath(file.id)}
                    rel="nofollow"
                    class={buttonClasses({
                      variant: primary ? "primary" : "secondary",
                    })}
                    aria-label={`Download ${file.name}`}
                  >
                    Download
                  </a>
                )}
              </li>
            ))}
          </ol>
        </section>

        {entry.dependencies.length > 0 && (
          <section aria-labelledby="deps-title" class="flex flex-col gap-3">
            <h2 id="deps-title" class="type-label">
              Dependencies
            </h2>
            <ul class="border-b border-hair">
              {entry.dependencies.map((dep) => (
                <li class="flex items-baseline justify-between gap-4 border-t border-hair py-3">
                  {dep.slug && dep.type ? (
                    <a
                      href={`/minecraft/${typeInfo(dep.type).segment}/${dep.slug}/`}
                      class="link-wipe"
                    >
                      {dep.name}
                    </a>
                  ) : dep.url ? (
                    <a
                      href={dep.url}
                      rel="nofollow ugc noopener noreferrer"
                      class="link-wipe"
                    >
                      {dep.name}
                    </a>
                  ) : (
                    <span>{dep.name}</span>
                  )}
                  <span class="type-label text-muted">
                    {dependencyKindLabel(dep.kind)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="changelog-title" class="flex flex-col gap-3">
          <h2 id="changelog-title" class="type-label">
            Changelog
          </h2>
          {release.changelogHtml ? (
            <div class="prose" set:html={release.changelogHtml} />
          ) : (
            <p class="text-muted">No notes for this release.</p>
          )}
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
