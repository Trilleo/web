---
import CommentSection from "../../components/comments/CommentSection.astro";
import PostArticle from "../../components/PostArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdmin } from "../../lib/auth/guard";
import {
  findPublicPost,
  listPublicPosts,
  toBlogPost,
} from "../../lib/blog/store";
import { getDb } from "../../lib/db";
import { adjacentPosts, numberPosts, postHref } from "../../lib/posts";
import {
  blogPostingJsonLd,
  breadcrumbJsonLd,
  describe,
  htmlToText,
  ogImagePath,
  postCard,
} from "../../lib/seo";

// Posts live in the database, so their pages render per request.
export const prerender = false;

const db = await getDb();
const now = new Date();
const lookup = await findPublicPost(db, Astro.params.slug ?? "", now);
if (lookup.found === "redirect") {
  return Astro.redirect(postHref(lookup.slug), 301);
}
if (lookup.found === "none") {
  return Astro.rewrite("/404");
}

const post = toBlogPost(lookup.post, now);
const posts = await listPublicPosts(db, now);
const numbers = numberPosts(posts);
const { newer, older } = adjacentPosts(posts, post.id);
const next = newer ?? older;
const { commentMode, id } = lookup.post;
const admin = isAdmin(Astro.locals.user);

const number = numbers.get(post.id) ?? "—";
const path = postHref(post.id);
// The editor's search title and description, when set, are for search engines and
// link previews; the page itself (and its structured data) keeps the real ones.
const searchTitle = lookup.post.seoTitle ?? post.data.title;
const description = describe(
  lookup.post.seoDescription ?? post.data.description,
  lookup.post.html,
);
const image = ogImagePath(`posts/${post.id}`, postCard(post, number));
const published = post.data.pubDate ?? lookup.post.publishedAt ?? now;
const jsonLd = [
  blogPostingJsonLd({
    title: post.data.title,
    description,
    path,
    image,
    published,
    modified: post.data.updatedDate,
    tags: post.data.tags,
    words: htmlToText(lookup.post.html).split(" ").filter(Boolean).length,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Writing", path: "/writing/" },
    { name: post.data.title, path },
  ]),
];
if (admin) Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout
  title={searchTitle}
  {description}
  imageAlt={post.data.title}
  {image}
  article={{
    published,
    modified: post.data.updatedDate,
    tags: post.data.tags,
  }}
  {jsonLd}
>
  <PostArticle
    {post}
    {number}
    next={
      next && {
        post: next,
        number: numbers.get(next.id) ?? "—",
        newer: next === newer,
      }
    }
    editHref={admin ? `/admin/posts/${String(id)}/` : undefined}
  />

  {commentMode !== "off" && (
    <section
      id="comments"
      aria-labelledby="comments-title"
      class="grid-swiss mx-page scroll-mt-6 gap-y-6 border-t-2 border-ink pt-4 pb-16 md:pb-24"
      data-reveal
    >
      <h2
        id="comments-title"
        class="type-label col-span-4 md:col-span-2 xl:col-span-2"
      >
        (Comments)
      </h2>
      <div class="col-span-4 md:col-span-6 xl:col-span-6">
        <CommentSection server:defer slug={post.id}>
          <p slot="fallback" class="text-muted">
            Loading comments…
            <noscript>Comments need JavaScript to load.</noscript>
          </p>
        </CommentSection>
      </div>
    </section>
  )}
</BaseLayout>
