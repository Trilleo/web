---
import CommentSection from "../../components/comments/CommentSection.astro";
import PostArticle from "../../components/PostArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdmin } from "../../lib/auth/guard";
import {
  findPublicPost,
  listPublicPosts,
  toBlogPost,
} from "../../lib/blog/store";
import { getDb } from "../../lib/db";
import { adjacentPosts, numberPosts, postHref } from "../../lib/posts";

// Posts live in the database, so their pages render per request.
export const prerender = false;

const db = await getDb();
const now = new Date();
const lookup = await findPublicPost(db, Astro.params.slug ?? "", now);
if (lookup.found === "redirect") {
  return Astro.redirect(postHref(lookup.slug), 301);
}
if (lookup.found === "none") {
  return Astro.rewrite("/404");
}

const post = toBlogPost(lookup.post, now);
const posts = await listPublicPosts(db, now);
const numbers = numberPosts(posts);
const { newer, older } = adjacentPosts(posts, post.id);
const next = newer ?? older;
const { commentMode, id } = lookup.post;
const admin = isAdmin(Astro.locals.user);
if (admin) Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <PostArticle
    post={post}
    number={numbers.get(post.id) ?? "—"}
    next={
      next && {
        post: next,
        number: numbers.get(next.id) ?? "—",
        newer: next === newer,
      }
    }
    editHref={admin ? `/admin/posts/${String(id)}/` : undefined}
  />

  {commentMode !== "off" && (
    <section
      id="comments"
      aria-labelledby="comments-title"
      class="grid-swiss mx-page scroll-mt-6 gap-y-6 border-t-2 border-ink pt-4 pb-16 md:pb-24"
      data-reveal
    >
      <h2
        id="comments-title"
        class="type-label col-span-4 md:col-span-2 xl:col-span-2"
      >
        (Comments)
      </h2>
      <div class="col-span-4 md:col-span-6 xl:col-span-6">
        <CommentSection server:defer slug={post.id}>
          <p slot="fallback" class="text-muted">
            Loading comments…
            <noscript>Comments need JavaScript to load.</noscript>
          </p>
        </CommentSection>
      </div>
    </section>
  )}
</BaseLayout>
