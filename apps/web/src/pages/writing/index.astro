---
import DisplayTitle from "../../components/DisplayTitle.astro";
import PostList from "../../components/PostList.astro";
import PostSearch from "../../components/PostSearch.astro";
import TagLinks from "../../components/TagLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublicPosts, searchPosts } from "../../lib/blog/store";
import { getDb } from "../../lib/db";
import {
  collectTags,
  postHref,
  searchSummary,
  toListings,
} from "../../lib/posts";
import { breadcrumbJsonLd } from "../../lib/seo";

export const prerender = false;

const db = await getDb();
const posts = await listPublicPosts(db);
// Without JavaScript, the search box submits here (?q=…) and the results render below.
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const found = query ? await searchPosts(db, query) : null;
// Result pages are thin and endless: fine to follow, not to index.
const noindex = query !== "";
const listings = toListings(posts);
const tags = collectTags(posts);
const count = `${String(posts.length)} ${posts.length === 1 ? "post" : "posts"}`;
---

<BaseLayout
  title="Writing"
  description="All posts, newest first."
  {noindex}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Writing", path: "/writing/" },
    ]),
  ]}
>
  <section aria-labelledby="writing-title" class="px-page pt-4 xl:pt-5">
    <div class="grid-swiss type-label text-muted">
      <span class="col-span-2 text-ink md:col-span-4 xl:col-span-2">
        (01) Writing
      </span>
      <span class="hidden xl:col-span-4 xl:block">Index</span>
      <span class="col-span-2 text-right md:col-span-4 xl:col-span-6">
        {count}
      </span>
    </div>

    <DisplayTitle id="writing-title">Writing</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-6 border-t border-ink pt-4 pb-10 md:mt-8 md:gap-y-8 md:pt-5 md:pb-14 xl:mt-12 xl:pt-6 xl:pb-16">
      <p class="type-label col-span-4 flex items-start gap-2 md:col-span-2 xl:col-span-2">
        <span
          class="mt-0.5 size-2 bg-accent xl:size-2.5"
          aria-hidden="true"
        ></span>
        Index
      </p>
      <p class="type-lead col-span-4 md:col-span-6">All posts, newest first.</p>
      {posts.length > 0 && (
        <div class="col-span-4 md:col-span-6 md:col-start-3 xl:col-span-3 xl:col-start-10 xl:row-start-1">
          <PostSearch
            query={query}
            status={found ? searchSummary(found.length, query) : ""}
          />
        </div>
      )}
      {tags.length > 0 && (
        <div class="col-span-4 md:col-span-6 md:col-start-3 xl:col-span-7 xl:col-start-3">
          <TagLinks tags={tags} />
        </div>
      )}
    </div>
  </section>

  <section aria-label="Posts" class="px-page pb-16 md:pb-24">
    <ol hidden={found === null} class="border-b border-ink" data-search-results>
      {found?.map((result) => (
        <li class="border-t border-ink">
          <a
            href={postHref(result.slug)}
            class="group flex flex-col gap-2 py-5 md:py-6"
          >
            <span class="type-row">
              <span class="link-wipe">{result.title}</span>
            </span>
            <span class="text-[15px] leading-normal text-muted">
              <Fragment set:html={result.excerpt} />
            </span>
          </a>
        </li>
      ))}
    </ol>
    <div hidden={found !== null} data-search-hides>
      <PostList posts={listings} />
    </div>
  </section>
</BaseLayout>
