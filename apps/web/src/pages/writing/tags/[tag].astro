---
import PostList from "../../../components/PostList.astro";
import TagLinks from "../../../components/TagLinks.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { listPublicPosts } from "../../../lib/blog/store";
import { getDb } from "../../../lib/db";
import { collectTags, hasTag, tagHref, toListings } from "../../../lib/posts";
import { TAG_INDEX_MIN_POSTS, breadcrumbJsonLd } from "../../../lib/seo";

export const prerender = false;

const tag = Astro.params.tag ?? "";
const posts = await listPublicPosts(await getDb());
const name = collectTags(posts).find((summary) => summary.slug === tag)?.name;
if (name === undefined) return Astro.rewrite("/404");
// Number within the full index so a post keeps the same No. everywhere.
const listings = toListings(posts).filter((_, index) => {
  const post = posts[index];
  return post !== undefined && hasTag(post, tag);
});
const count = `${String(listings.length)} ${listings.length === 1 ? "post" : "posts"}`;
// A tag with one post only repeats that post: crawlers may follow it, not index it.
const noindex = listings.length < TAG_INDEX_MIN_POSTS;
---

<BaseLayout
  title={`${name} · Writing`}
  description={`Posts tagged ${name}.`}
  {noindex}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Writing", path: "/writing/" },
      { name, path: tagHref(name) },
    ]),
  ]}
>
  <section aria-labelledby="tag-title" class="px-page pt-4 xl:pt-5">
    <div class="grid-swiss type-label text-muted">
      <a
        href="/writing/"
        class="group col-span-2 text-ink md:col-span-4 xl:col-span-2"
      >
        <span class="link-wipe">(01) Writing</span>
      </a>
      <span class="hidden xl:col-span-4 xl:block">Tag</span>
      <span class="col-span-2 text-right md:col-span-4 xl:col-span-6">
        {count}
      </span>
    </div>

    <div class="grid-swiss mt-10 gap-y-6 pb-10 md:mt-14 md:pb-14 xl:mt-16 xl:pb-16">
      <p class="type-label col-span-4 flex items-start gap-2 md:col-span-2 xl:col-span-2">
        <span
          class="mt-0.5 size-2 bg-accent xl:size-2.5"
          aria-hidden="true"
        ></span>
        Tag
      </p>
      <h1
        id="tag-title"
        class="type-headline col-span-4 md:col-span-6 xl:col-span-10"
      >
        {name}
      </h1>
      <div class="col-span-4 md:col-span-8 xl:col-span-12">
        <TagLinks tags={collectTags(posts)} current={tag} label="All tags" />
      </div>
    </div>
  </section>

  <section aria-label={`Posts tagged ${name}`} class="px-page pb-16 md:pb-24">
    <PostList posts={listings} />
  </section>
</BaseLayout>
