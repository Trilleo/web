---
/**
 * Signing in, and creating an account: the same first step. Type your address and
 * get a code (POST here, then /sign-in/code), or continue with GitHub. Works without
 * JavaScript; looks the same whether or not the address has an account.
 */
import {
  ArrowRightIcon,
  GitHubIcon,
  KeyIcon,
  buttonClasses,
} from "@trilleo/ui";
import AuthCard from "../components/account/AuthCard.astro";
import EmailStep from "../components/account/EmailStep.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authConfig } from "../lib/auth/config";
import { setPendingCookie } from "../lib/auth/cookies";
import {
  SIGN_IN_CODE_ERRORS,
  requestSignInCode,
} from "../lib/auth/email-sign-in";
import { noStoreRedirect, safeNextPath } from "../lib/auth/redirect";
import { signInErrorMessage } from "../lib/auth/sign-in";
import { field } from "../lib/comments/form";
import { getDb } from "../lib/db";
import { mailSetup } from "../lib/mail/config";
import { sendNow } from "../lib/mail/delivery";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { user } = Astro.locals;
const params = Astro.url.searchParams;
const github = authConfig().github !== null;
const emailWorks = mailSetup().config.available;
let next = safeNextPath(params.get("next"));
let error = signInErrorMessage(params.get("error"));
let typed = "";

if (Astro.request.method === "POST" && !user) {
  const form = await Astro.request.formData();
  next = safeNextPath(field(form, "next"));
  typed = field(form, "email");
  let ip = "";
  try {
    ip = Astro.clientAddress;
  } catch {
    // Not available (some test setups): everyone shares one limit.
  }
  const result = await requestSignInCode(await getDb(), typed, {
    available: emailWorks,
    ip,
  });
  if (result.ok) {
    setPendingCookie(Astro.cookies, Astro.url, { email: result.email, next });
    const sent = await sendNow(result.messageId);
    const went = sent?.status === "sent" || sent?.status === "captured";
    return noStoreRedirect(`/sign-in/code${went ? "" : "?delayed=1"}`, 303);
  }
  error = SIGN_IN_CODE_ERRORS[result.error];
  Astro.response.status = result.error === "invalid" ? 422 : 429;
}

const signedOut = params.has("signed-out") && !user;
const accountDeleted = params.has("account-deleted") && !user;
const notice = signedOut
  ? "You’ve signed out."
  : accountDeleted
    ? "Your account and comments have been deleted."
    : null;
---

<BaseLayout title="Sign in" noindex>
  <AuthCard
    id="sign-in-title"
    title={user ? "You’re signed in" : "Sign in"}
    description={
      user
        ? `As @${user.username}.`
        : "Or make an account: it’s the same first step. We’ll email you a code, so there’s no password."
    }
  >
    {(error || notice) && (
      <p
        slot="notice"
        role={error ? "alert" : "status"}
        class="border-l-2 border-accent pl-3"
      >
        {error ?? notice}
      </p>
    )}

    {user ? (
      <div class="flex flex-col gap-3">
        <a
          href={next}
          class={buttonClasses({ hover: "plain", className: "w-full" })}
        >
          Continue
          <ArrowRightIcon size={16} />
        </a>
        <form method="post" action="/auth/logout">
          <button
            type="submit"
            class={buttonClasses({
              hover: "plain",
              variant: "secondary",
              className: "w-full",
            })}
          >
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <>
        <EmailStep
          action="/sign-in"
          next={next}
          value={typed}
          invalid={error !== null && typed !== ""}
          disabled={!emailWorks}
        />
        {/* Shown when there's GitHub, or (by the script) when passkeys work here. */}
        <div
          class="flex flex-col gap-3"
          hidden={!github}
          data-alternatives
          data-next={next}
        >
          <p class="type-label flex items-center gap-3 text-muted before:h-px before:flex-1 before:bg-ink after:h-px after:flex-1 after:bg-ink">
            Or
          </p>
          <button
            type="button"
            hidden
            data-passkey-sign-in
            class={buttonClasses({
              hover: "plain",
              variant: "secondary",
              className: "w-full",
            })}
          >
            <KeyIcon size={16} />
            Sign in with a passkey
          </button>
          {github && (
            <a
              href={`/auth/github?next=${encodeURIComponent(next)}`}
              class={buttonClasses({
                hover: "plain",
                variant: "secondary",
                className: "w-full",
              })}
            >
              <GitHubIcon size={16} />
              Sign in with GitHub
            </a>
          )}
          <p role="alert" class="text-sm" hidden data-passkey-error></p>
        </div>
      </>
    )}

    {!user && (
      <p slot="footer">
        By signing in you agree to the{" "}
        <a href="/legal/terms/" class="text-ink underline">
          terms
        </a>{" "}
        and{" "}
        <a href="/legal/privacy/" class="text-ink underline">
          privacy policy
        </a>
        . You must be 14 or older.
      </p>
    )}
  </AuthCard>
</BaseLayout>

<script>
  import {
    autofillSupported,
    passkeysSupported,
    problemMessage,
    signInWithPasskey,
    wasCancelled,
  } from "../lib/auth/passkey-client";

  // Passkeys: a button, and (where browsers allow) suggestions in the email field.
  const alternatives = document.querySelector<HTMLElement>(
    "[data-alternatives]",
  );
  const button = document.querySelector<HTMLButtonElement>(
    "[data-passkey-sign-in]",
  );
  const problem = document.querySelector<HTMLElement>("[data-passkey-error]");
  if (alternatives && button && problem && passkeysSupported()) {
    const next = alternatives.dataset.next ?? "/account";
    alternatives.hidden = false;
    button.hidden = false;
    let autofill: AbortController | null = null;

    const go = async (options: {
      autofill?: boolean;
      signal?: AbortSignal;
    }) => {
      try {
        problem.textContent = "";
        problem.hidden = true;
        location.assign(await signInWithPasskey(next, options));
      } catch (error) {
        // Autofill is a background nicety: its failures stay quiet.
        if (!options.autofill && !wasCancelled(error)) {
          problem.textContent = problemMessage(error);
          problem.hidden = false;
        }
      }
    };

    void autofillSupported().then((available) => {
      if (!available) return;
      autofill = new AbortController();
      void go({ autofill: true, signal: autofill.signal });
    });

    button.addEventListener("click", () => {
      // Only one request at a time: the button's replaces the autofill one.
      autofill?.abort();
      autofill = null;
      button.disabled = true;
      void go({}).finally(() => {
        button.disabled = false;
      });
    });
  }
</script>
