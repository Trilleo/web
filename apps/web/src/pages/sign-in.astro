---
import DisplayTitle from "../components/DisplayTitle.astro";
import { ArrowRightIcon, GitHubIcon, buttonClasses } from "@trilleo/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authConfig } from "../lib/auth/config";
import { safeNextPath } from "../lib/auth/redirect";
import { signInErrorMessage } from "../lib/auth/sign-in";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { user } = Astro.locals;
const params = Astro.url.searchParams;
const configured = authConfig() !== null;
const next = safeNextPath(params.get("next"));
const error = signInErrorMessage(
  configured ? params.get("error") : "not-configured",
);
const signedOut = params.has("signed-out") && !user;
const accountDeleted = params.has("account-deleted") && !user;
---

<BaseLayout title="Sign in" noindex>
  <section
    aria-labelledby="sign-in-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <p class="type-label text-ink">(Account) Sign in</p>

    <DisplayTitle id="sign-in-title">Sign in</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-6 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 md:col-start-3 xl:col-start-3">
        {error && (
          <p role="alert" class="type-lead border-l-2 border-accent pl-4">
            {error}
          </p>
        )}
        {signedOut && (
          <p role="status" class="type-lead">
            You’ve signed out.
          </p>
        )}
        {accountDeleted && (
          <p role="status" class="type-lead">
            Your account and comments have been deleted.
          </p>
        )}
        {user ? (
          <p class="type-lead">
            You’re signed in as <strong>@{user.githubLogin}</strong>.
          </p>
        ) : (
          <p class="type-lead">
            Sign in with your GitHub account to comment. Only your public name
            and username are kept.
          </p>
        )}
      </div>

      <div class="col-span-4 flex flex-col gap-3 md:col-span-6 md:col-start-3 xl:col-span-3 xl:col-start-10">
        {user ? (
          <>
            <a href={next} class={buttonClasses()}>
              Continue
              <ArrowRightIcon size={16} />
            </a>
            <form method="post" action="/auth/logout">
              <button
                type="submit"
                class={buttonClasses({
                  variant: "secondary",
                  className: "w-full",
                })}
              >
                Sign out
              </button>
            </form>
          </>
        ) : (
          configured && (
            <a
              href={`/auth/github?next=${encodeURIComponent(next)}`}
              class={buttonClasses()}
            >
              <GitHubIcon size={16} />
              Sign in with GitHub
            </a>
          )
        )}
        {!user && configured && (
          <p class="text-sm text-muted">
            By signing in you agree to the{" "}
            <a href="/legal/terms/" class="text-ink underline">
              terms
            </a>{" "}
            and{" "}
            <a href="/legal/privacy/" class="text-ink underline">
              privacy policy
            </a>
            . You must be 14 or older.
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
