---
/** The categories in use, with how many pages each has. */
import NoWiki from "../../../../components/wiki/NoWiki.astro";
import ToolHeading from "../../../../components/wiki/ToolHeading.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
import {
  mainSiteRedirect,
  openWiki,
  privateHeaders,
} from "../../../../lib/wiki/page";
import { allCategories } from "../../../../lib/wiki/store";
import { categoryName } from "../../../../lib/wiki/titles";
import { wikiHref } from "../../../../lib/wiki/wikis";

export const prerender = false;

const moved = mainSiteRedirect(Astro, Astro.params.wiki);
if (moved) return moved;
privateHeaders(Astro);
const context = await openWiki(Astro, Astro.params.wiki);
if (!context) Astro.response.status = 404;
const categories = context ? await allCategories(context.db, context.wiki) : [];
---

{!context ? (
  <NoWiki />
) : (
  <WikiLayout
    title="Categories"
    wiki={context.wiki}
    access={context.access}
    noindex
  >
    <div class="flex flex-col gap-6">
      <ToolHeading
        title="Categories"
        lead="Pages join a category with [[Category:Name]]."
      />
      {categories.length === 0 ? (
        <p class="text-muted">No categories yet.</p>
      ) : (
        <ul class="columns-1 gap-6 md:columns-2 xl:columns-3">
          {categories.map((category) => (
            <li class="break-inside-avoid py-0.5">
              <a
                href={wikiHref(context.wiki, category.title)}
                class="hover:underline"
              >
                {categoryName(category.title)}
              </a>{" "}
              <span class="text-sm text-muted">({category.pages})</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </WikiLayout>
)}
