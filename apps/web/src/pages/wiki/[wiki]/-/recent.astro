---
/** The wiki's latest edits, newest first. */
import NoWiki from "../../../../components/wiki/NoWiki.astro";
import ToolHeading from "../../../../components/wiki/ToolHeading.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
import {
  mainSiteRedirect,
  openWiki,
  privateHeaders,
} from "../../../../lib/wiki/page";
import { recentChanges } from "../../../../lib/wiki/store";
import {
  formatDelta,
  formatWikiDate,
  wikiTable,
} from "../../../../lib/wiki/ui";
import { toolHref, wikiHref } from "../../../../lib/wiki/wikis";

export const prerender = false;

const moved = mainSiteRedirect(Astro, Astro.params.wiki);
if (moved) return moved;
privateHeaders(Astro);
const context = await openWiki(Astro, Astro.params.wiki);
if (!context) Astro.response.status = 404;
const changes = context ? await recentChanges(context.db, context.wiki.id) : [];
---

{!context ? (
  <NoWiki />
) : (
  <WikiLayout
    title="Recent changes"
    wiki={context.wiki}
    access={context.access}
    noindex
  >
    <div class="flex flex-col gap-6">
      <ToolHeading
        title="Recent changes"
        lead="The latest edits to written pages. Generated pages change with their source."
      />
      {changes.length === 0 ? (
        <p class="text-muted">No edits yet.</p>
      ) : (
        <div class="relative overflow-x-auto">
          <table class={wikiTable} data-recent>
            <thead>
              <tr>
                <th>Page</th>
                <th>Saved</th>
                <th>By</th>
                <th>Size</th>
                <th>Summary</th>
              </tr>
            </thead>
            <tbody>
              {changes.map((change) => (
                <tr>
                  <td>
                    <a
                      href={wikiHref(context.wiki, change.title)}
                      class="font-medium underline"
                    >
                      {change.title}
                    </a>
                  </td>
                  <td class="whitespace-nowrap">
                    <a
                      href={
                        change.previousBytes === null
                          ? toolHref(
                              context.wiki,
                              `revision/${String(change.id)}`,
                            )
                          : `${toolHref(context.wiki, "diff")}?to=${String(change.id)}`
                      }
                      class="underline"
                    >
                      {formatWikiDate(change.createdAt)}
                    </a>
                  </td>
                  <td>
                    {change.author ? (
                      `@${change.author}`
                    ) : (
                      <span class="text-muted">the site</span>
                    )}
                  </td>
                  <td class="whitespace-nowrap font-mono text-xs">
                    {change.previousBytes === null ? (
                      <span class="type-label">New</span>
                    ) : (
                      formatDelta(change.bytes, change.previousBytes)
                    )}
                  </td>
                  <td>
                    {change.minor && (
                      <abbr
                        title="Minor edit"
                        class="type-label mr-2 no-underline"
                      >
                        m
                      </abbr>
                    )}
                    {change.summary || (
                      <span class="text-muted">No summary</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </WikiLayout>
)}
