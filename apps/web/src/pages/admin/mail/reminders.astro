---
/**
 * Every SkyBlock event reminder people have set up, for the admin: totals, the last
 * 24 hours' sends by result, subscriptions per event, and the list (?event=,
 * ?user=<username>), where any one can be removed and anyone's reminders paused or
 * resumed. POSTs to this page with `intent` (remove, pause, resume).
 */
import { formatLead } from "@trilleo/skyblock/events";
import { eventPath } from "@trilleo/tool-skyblock/meta";
import { buttonClasses } from "@trilleo/ui";
import AdminNav from "../../../components/admin/AdminNav.astro";
import MailNav from "../../../components/admin/MailNav.astro";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { normalizeUsername } from "../../../lib/auth/usernames";
import { field, parseId } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import {
  REMINDER_LOG_DAYS,
  SEND_STATUSES,
  adminReminders,
  reminderEvent,
  removeReminder,
  setPaused,
  type SendStatus,
} from "../../../lib/skyblock/reminders";
import { toast, toastError } from "../../../lib/toast";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const params = Astro.url.searchParams;
const eventParam = params.get("event");
const event = eventParam && reminderEvent(eventParam) ? eventParam : null;
const username = normalizeUsername(params.get("user") ?? "") || null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const back = new URL("/admin/mail/reminders/", Astro.url);
  if (event) back.searchParams.set("event", event);
  if (username) back.searchParams.set("user", username);
  const intent = field(form, "intent");
  let done = "unknown";
  if (intent === "remove") {
    const id = parseId(field(form, "id"));
    done =
      id !== null && (await removeReminder(db, id, null))
        ? "removed"
        : "missing";
  } else if (intent === "pause" || intent === "resume") {
    const userId = field(form, "userId");
    if (/^[0-9a-f-]{36}$/.test(userId)) {
      await setPaused(db, userId, intent === "pause");
      done = intent === "pause" ? "paused" : "resumed";
    }
  }
  back.searchParams.set("done", done);
  return noStoreRedirect(back.pathname + back.search, 303);
}

const DONE: Record<string, string> = {
  removed: "Reminder removed.",
  paused: "Their reminders are paused.",
  resumed: "Their reminders go out again.",
};
const done = params.get("done");
if (done && done in DONE) toast(Astro, DONE[done]);
else if (done) toastError(Astro, "Couldn't do that.");

const overview = await adminReminders(db, { event, username });
const when = (date: Date | null) =>
  date
    ? date.toLocaleString("en-GB", {
        day: "numeric",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "UTC",
      }) + " UTC"
    : "—";
const filterHref = (next: { event?: string | null; user?: string | null }) => {
  const query = new URLSearchParams();
  const e = next.event === undefined ? event : next.event;
  const u = next.user === undefined ? username : next.user;
  if (e) query.set("event", e);
  if (u) query.set("user", u);
  return `/admin/mail/reminders/${query.size > 0 ? `?${query.toString()}` : ""}`;
};
const row =
  "grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6";
const label = "type-label col-span-4 md:col-span-2 xl:col-span-2";
const body =
  "col-span-4 flex min-w-0 flex-col gap-4 md:col-span-6 xl:col-span-10";
const th = "type-label border-b border-ink py-2 pr-4 font-normal text-muted";
const td = "border-b border-hair py-2 pr-4 align-top";
/**
 * The table scrolls sideways on phones, so its box is a labelled region and a tab stop
 * (axe: scrollable-region-focusable); jsx-a11y only knows interactive roles.
 */
const scrollRegion = {
  role: "region",
  "aria-label": "Subscriptions",
  tabindex: 0,
} as const;
const statuses = Object.keys(SEND_STATUSES) as SendStatus[];
---

<BaseLayout title="SkyBlock reminders · Mail · Admin" noindex>
  <section
    aria-labelledby="reminders-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="mail" />
    <DisplayTitle id="reminders-title">Mail</DisplayTitle>
    <MailNav current="reminders" />

    <div class={row}>
      <h2 class={label}>Totals</h2>
      <div class={body}>
        <dl
          class="grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-3 xl:grid-cols-6"
          data-testid="reminder-totals"
        >
          <div>
            <dt class="type-label text-muted">Reminders</dt>
            <dd class="type-lead">{overview.total}</dd>
          </div>
          <div>
            <dt class="type-label text-muted">People</dt>
            <dd class="type-lead">{overview.people}</dd>
          </div>
          {statuses.map((status) => (
            <div>
              <dt class="type-label text-muted">{SEND_STATUSES[status]}</dt>
              <dd class="type-lead">{overview.sends[status] ?? 0}</dd>
            </div>
          ))}
        </dl>
        <p class="text-sm text-muted">
          Sends in the last 24 hours; the log is kept {REMINDER_LOG_DAYS} days.
        </p>
      </div>
    </div>

    <div class={row}>
      <h2 class={label}>By event</h2>
      <div class={body}>
        {overview.byEvent.length === 0 ? (
          <p class="text-muted">Nothing yet.</p>
        ) : (
          <ul class="flex flex-wrap gap-2">
            {event && (
              <li>
                <a
                  href={filterHref({ event: null })}
                  class="type-label border border-hair px-3 py-1.5 hover:border-ink"
                >
                  All events
                </a>
              </li>
            )}
            {overview.byEvent.map((row) => (
              <li>
                <a
                  href={filterHref({ event: row.event })}
                  aria-current={row.event === event ? "page" : undefined}
                  class:list={[
                    "type-label border px-3 py-1.5",
                    row.event === event
                      ? "border-ink bg-ink text-paper"
                      : "border-hair hover:border-ink",
                  ]}
                >
                  {reminderEvent(row.event)?.name ?? row.event} · {row.n}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class={row}>
      <h2 class={label}>Subscriptions</h2>
      <div class={body}>
        <form method="get" class="flex flex-wrap items-end gap-3">
          {event && <input type="hidden" name="event" value={event} />}
          <label class="flex flex-col gap-1">
            <span class="type-label">Username</span>
            <input
              name="user"
              value={username ?? ""}
              class="h-11 border border-ink bg-paper px-3"
            />
          </label>
          <button type="submit" class={buttonClasses({ variant: "secondary" })}>
            Show
          </button>
          {username && (
            <a href={filterHref({ user: null })} class="type-label underline">
              Everyone
            </a>
          )}
        </form>
        {overview.rows.length === 0 ? (
          <p class="text-muted" data-testid="admin-reminders-empty">
            Nothing yet.
          </p>
        ) : (
          <div class="overflow-x-auto" {...scrollRegion}>
            <table
              class="w-full min-w-[48rem] border-collapse text-left text-sm"
              data-testid="admin-reminders"
            >
              <thead>
                <tr>
                  <th class={th} scope="col">
                    Person
                  </th>
                  <th class={th} scope="col">
                    Event
                  </th>
                  <th class={th} scope="col">
                    Lead
                  </th>
                  <th class={th} scope="col">
                    Added
                  </th>
                  <th class={th} scope="col">
                    Last sent
                  </th>
                  <th class={th} scope="col">
                    <span class="sr-only">Actions</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {overview.rows.map((item) => (
                  <tr>
                    <th class={`${td} font-normal`} scope="row">
                      <a
                        href={filterHref({ user: item.username })}
                        class="underline"
                      >
                        @{item.username}
                      </a>
                      {item.paused && (
                        <span class="type-label ml-2 text-muted">Paused</span>
                      )}
                      <span class="block text-muted">
                        {item.email ?? "No address"}
                      </span>
                    </th>
                    <td class={td}>
                      <a href={eventPath(item.eventSlug)} class="underline">
                        {reminderEvent(item.eventSlug)?.name ?? item.eventSlug}
                      </a>
                    </td>
                    <td class={td}>{formatLead(item.leadMinutes)}</td>
                    <td class={td}>{when(item.createdAt)}</td>
                    <td class={td}>{when(item.lastSentAt)}</td>
                    <td class={`${td} whitespace-nowrap`}>
                      <form method="post" class="inline">
                        <input type="hidden" name="intent" value="remove" />
                        <input
                          type="hidden"
                          name="id"
                          value={String(item.id)}
                        />
                        <button type="submit" class="type-label underline">
                          Remove
                        </button>
                      </form>
                      <form method="post" class="ml-3 inline">
                        <input
                          type="hidden"
                          name="intent"
                          value={item.paused ? "resume" : "pause"}
                        />
                        <input
                          type="hidden"
                          name="userId"
                          value={item.userId}
                        />
                        <button type="submit" class="type-label underline">
                          {item.paused ? "Resume person" : "Pause person"}
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {overview.more && (
          <p class="text-sm text-muted">
            Showing the newest 100: filter to see others.
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
