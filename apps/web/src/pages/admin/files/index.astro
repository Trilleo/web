---
/**
 * The admin's files: upload site files, see every stored file (filter by status or
 * name), and act on them (approve, reject, take down, restore, delete, visibility).
 */
import {
  FILE_STATUSES,
  FILE_VISIBILITIES,
  availableActions,
  type FileAction,
  type FileStatus,
  type FileVisibility,
} from "@trilleo/storage";
import { formatBytes } from "@trilleo/tool-kit/files";
import { buttonClasses, fieldClasses } from "@trilleo/ui";
import AdminNav from "../../../components/admin/AdminNav.astro";
import FileUploader from "../../../components/admin/FileUploader";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { formatPostDate } from "../../../lib/listings";
import { getStorage } from "../../../lib/storage/config";
import { storageDeps } from "../../../lib/storage/deps";
import { STATUS_LABELS } from "../../../lib/storage/labels";
import { filePagePath } from "../../../lib/storage/service";
import { listFiles, statusTotals } from "../../../lib/storage/store";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const PAGE_SIZE = 50;
const params = Astro.url.searchParams;
const statusParam = params.get("status") ?? "";
const status = FILE_STATUSES.includes(statusParam as FileStatus)
  ? (statusParam as FileStatus)
  : undefined;
const query = params.get("q")?.trim().slice(0, 200) ?? "";
const page = Math.max(1, Math.floor(Number(params.get("page")) || 1));
const done = params.get("done");
const error = params.get("error");

const deps = await storageDeps();
const storageKind = getStorage()?.kind ?? null;
const totals = deps ? await statusTotals(deps.db) : {};
const { items, total } = deps
  ? await listFiles(
      deps.db,
      { status, ...(query ? { query } : {}) },
      { limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE },
    )
  : { items: [], total: 0 };
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const here = Astro.url.pathname + Astro.url.search;

const stored = Object.values(totals).reduce(
  (sum, entry) => ({
    files: sum.files + entry.files,
    bytes: sum.bytes + entry.bytes,
  }),
  { files: 0, bytes: 0 },
);
const overview = FILE_STATUSES.filter((s) => totals[s]).map((s) => ({
  status: s,
  files: totals[s]?.files ?? 0,
}));

const ACTION_LABELS: Record<FileAction, string> = {
  complete: "Complete",
  processed: "Processed",
  fail: "Fail",
  abandon: "Abandon",
  approve: "Approve",
  reject: "Reject",
  remove: "Take down",
  restore: "Restore",
  delete: "Delete",
};
const NEEDS_REASON: readonly FileAction[] = ["reject", "remove"];
/** The actions that put a file (back) into circulation, drawn filled. */
const PRIMARY_ACTIONS: readonly FileAction[] = ["approve", "restore"];
const VISIBILITY_SHORT: Record<FileVisibility, string> = {
  public: "Public",
  unlisted: "Unlisted",
  private: "Private",
};
const smallButton =
  "type-label inline-flex h-8 cursor-pointer items-center border border-ink px-3 press";
// Joined toggles: neighbours share a border.
const segment =
  "type-label -ml-px inline-flex h-8 items-center border border-ink px-3 first:ml-0";
const DONE_LABELS: Record<string, string> = {
  approve: "Approved.",
  reject: "Refused.",
  remove: "Taken down.",
  restore: "Restored.",
  delete: "Deleted.",
  visibility: "Visibility changed.",
};
const pageHref = (n: number) => {
  const url = new URL(Astro.url);
  url.searchParams.delete("done");
  url.searchParams.delete("error");
  url.searchParams.set("page", String(n));
  return url.pathname + url.search;
};
const dot = (s: FileStatus) =>
  s === "published"
    ? "bg-ink"
    : s === "pending_review" || s === "processing"
      ? "bg-accent"
      : "bg-transparent border border-ink";
---

<BaseLayout title="Files · Admin" noindex>
  <section
    aria-labelledby="files-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="files" />

    <DisplayTitle id="files-title">Files</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-6 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <p class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        {stored.files} {stored.files === 1 ? "file" : "files"} ·{" "}
        {formatBytes(stored.bytes)}
      </p>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 xl:col-span-7">
        {done && DONE_LABELS[done] && (
          <p role="status" class="type-lead border-l-2 border-accent pl-4">
            {DONE_LABELS[done]}
          </p>
        )}
        {error && (
          <p role="alert" class="type-lead border-l-2 border-accent pl-4">
            {error}
          </p>
        )}
        {storageKind === null ? (
          <p class="type-lead border-l-2 border-accent pl-4">
            File storage isn’t set up on this server yet (deploy/storage.md).
          </p>
        ) : (
          <>
            {storageKind === "local" && (
              <p class="text-muted">
                Files are kept by this server’s local storage (dev or tests),
                not OBS.
              </p>
            )}
            <FileUploader client:load />
          </>
        )}
      </div>
    </div>

    <form
      method="get"
      class="grid-swiss mt-12 items-end gap-y-4 border-t border-ink pt-4 md:pt-5 xl:pt-6"
      role="search"
      aria-label="Filter files"
    >
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">Find</h2>
      <label class="col-span-4 flex flex-col gap-1.5 md:col-span-3 xl:col-span-4">
        <span class="type-label">Name or id</span>
        <input
          type="search"
          name="q"
          value={query}
          class:list={[fieldClasses, "h-11 px-3"]}
        />
      </label>
      <label class="col-span-4 flex flex-col gap-1.5 md:col-span-2 xl:col-span-3">
        <span class="type-label">Status</span>
        <select name="status" class:list={[fieldClasses, "h-11 px-3"]}>
          <option value="">Any</option>
          {FILE_STATUSES.map((s) => (
            <option value={s} selected={s === status}>
              {STATUS_LABELS[s]}
              {totals[s] ? ` (${String(totals[s].files)})` : ""}
            </option>
          ))}
        </select>
      </label>
      <div class="col-span-4 md:col-span-1 xl:col-span-3">
        <button type="submit" class={buttonClasses({ variant: "secondary" })}>
          Filter
        </button>
      </div>
      {overview.length > 0 && (
        <p class="type-label col-span-4 flex flex-wrap gap-x-4 gap-y-1 text-muted md:col-span-6 md:col-start-3 xl:col-span-10 xl:col-start-3">
          {overview.map((entry) => (
            <a href={`?status=${entry.status}`} class="hover:text-ink">
              {STATUS_LABELS[entry.status]} {entry.files}
            </a>
          ))}
        </p>
      )}
    </form>

    {items.length === 0 ? (
      <p class="mt-10 text-muted">
        No files{query || status ? " match" : " yet"}.
      </p>
    ) : (
      <ol aria-label="Files" class="mt-10 border-b border-ink">
        {items.map((file) => {
          const fileStatus = file.status as FileStatus;
          // Once the bytes are purged there's nothing left to act on.
          const actions = file.purgedAt
            ? []
            : availableActions(fileStatus, "admin");
          const visibilityEditable =
            !file.purgedAt &&
            (fileStatus === "processing" ||
              fileStatus === "pending_review" ||
              fileStatus === "published");
          return (
            <li
              class="grid-swiss items-baseline gap-y-3 border-t border-ink py-4 md:py-5"
              data-file={file.id}
            >
              <p class="type-label col-span-4 inline-flex items-center gap-2 md:col-span-2 xl:col-span-2">
                <span
                  class:list={["size-2 shrink-0", dot(fileStatus)]}
                  aria-hidden="true"
                ></span>
                {STATUS_LABELS[fileStatus]}
              </p>
              <div class="col-span-4 flex min-w-0 flex-col gap-1.5 md:col-span-6 xl:col-span-10">
                <a
                  href={filePagePath(file.id)}
                  class="group type-row break-all"
                >
                  <span class="link-wipe">{file.name}</span>
                </a>
                <p class="type-label flex flex-wrap gap-x-4 gap-y-1 text-muted">
                  <span>{file.label}</span>
                  <span>{formatBytes(file.size)}</span>
                  <span>{formatPostDate(file.createdAt)}</span>
                  {file.ownerLogin && <span>@{file.ownerLogin}</span>}
                  <span>
                    {file.downloads}{" "}
                    {file.downloads === 1 ? "download" : "downloads"}
                  </span>
                  <span>{file.id}</span>
                </p>
                {file.statusReason && (
                  <p class="text-muted">{file.statusReason}</p>
                )}
              </div>
              {(visibilityEditable || actions.length > 0) && (
                <div class="col-span-4 flex flex-wrap items-center gap-x-8 gap-y-3 md:col-span-6 md:col-start-3 xl:col-span-10 xl:col-start-3">
                  {visibilityEditable && (
                    <form
                      method="post"
                      action="/admin/files/action"
                      class="flex items-center gap-3"
                    >
                      <input type="hidden" name="id" value={file.id} />
                      <input type="hidden" name="action" value="visibility" />
                      <input type="hidden" name="back" value={here} />
                      <span class="type-label text-muted" id={`vis-${file.id}`}>
                        Visibility
                      </span>
                      <div
                        role="group"
                        aria-labelledby={`vis-${file.id}`}
                        class="flex"
                      >
                        {FILE_VISIBILITIES.map((v: FileVisibility) =>
                          v === file.visibility ? (
                            <span
                              class:list={[segment, "bg-ink text-paper"]}
                              aria-current="true"
                            >
                              {VISIBILITY_SHORT[v]}
                            </span>
                          ) : (
                            <button
                              type="submit"
                              name="visibility"
                              value={v}
                              class:list={[
                                segment,
                                "press cursor-pointer hover:bg-chip",
                              ]}
                              aria-label={`Make ${file.name} ${v}`}
                            >
                              {VISIBILITY_SHORT[v]}
                            </button>
                          ),
                        )}
                      </div>
                    </form>
                  )}
                  {actions.length > 0 && (
                    <div class="flex flex-wrap items-center gap-2 md:ml-auto">
                      {actions.map((action) =>
                        NEEDS_REASON.includes(action) ? (
                          <details class="group/reason relative">
                            <summary
                              class:list={[
                                smallButton,
                                "list-none hover:bg-chip group-open/reason:bg-ink group-open/reason:text-paper [&::-webkit-details-marker]:hidden",
                              ]}
                            >
                              {ACTION_LABELS[action]}…
                            </summary>
                            <form
                              method="post"
                              action="/admin/files/action"
                              class="absolute left-0 z-10 mt-2 flex w-72 max-w-[calc(100vw-2rem)] flex-col gap-3 border border-ink bg-paper p-4 md:right-0 md:left-auto"
                            >
                              <input type="hidden" name="id" value={file.id} />
                              <input
                                type="hidden"
                                name="action"
                                value={action}
                              />
                              <input type="hidden" name="back" value={here} />
                              <label class="flex flex-col gap-1.5">
                                <span class="type-label">
                                  Why? (shown to the uploader)
                                </span>
                                <textarea
                                  name="reason"
                                  required
                                  maxlength={500}
                                  rows={3}
                                  aria-label={`Reason to ${ACTION_LABELS[action].toLowerCase()} ${file.name}`}
                                  class:list={[
                                    fieldClasses,
                                    "px-2 py-1.5 text-sm",
                                  ]}
                                ></textarea>
                              </label>
                              <button
                                type="submit"
                                class={buttonClasses({
                                  className: "h-9 self-end",
                                })}
                                aria-label={`${ACTION_LABELS[action]} ${file.name}`}
                              >
                                {ACTION_LABELS[action]}
                              </button>
                            </form>
                          </details>
                        ) : (
                          <form method="post" action="/admin/files/action">
                            <input type="hidden" name="id" value={file.id} />
                            <input type="hidden" name="action" value={action} />
                            <input type="hidden" name="back" value={here} />
                            <button
                              type="submit"
                              class:list={[
                                smallButton,
                                PRIMARY_ACTIONS.includes(action)
                                  ? "bg-ink text-paper hover:bg-accent hover:text-on-accent"
                                  : "hover:bg-chip",
                              ]}
                              aria-label={`${ACTION_LABELS[action]} ${file.name}`}
                            >
                              {ACTION_LABELS[action]}
                            </button>
                          </form>
                        ),
                      )}
                    </div>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ol>
    )}

    {pages > 1 && (
      <nav aria-label="Pages" class="type-label mt-6 flex gap-6">
        {page > 1 && (
          <a href={pageHref(page - 1)} class="group">
            <span class="link-wipe">Newer</span>
          </a>
        )}
        <span class="text-muted">
          Page {page} of {pages}
        </span>
        {page < pages && (
          <a href={pageHref(page + 1)} class="group">
            <span class="link-wipe">Older</span>
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
