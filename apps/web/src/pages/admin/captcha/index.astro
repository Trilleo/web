---
/**
 * The human check, for the admin: its mode (Normal, Raised, Under attack; for a
 * while or until changed), what each guarded route asks for, and daily counts.
 * A flood raises the mode by itself for an hour (lib/captcha/store.ts).
 */
import {
  CHECK_MODES,
  CHECK_MODE_DESCRIPTIONS,
  CHECK_MODE_LABELS,
  POW_BITS,
  isCheckMode,
} from "@trilleo/captcha";
import { buttonClasses } from "@trilleo/ui";
import AdminNav from "../../../components/admin/AdminNav.astro";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { CHECK_LIMITS } from "../../../lib/captcha/checker";
import { checker } from "../../../lib/captcha/gate";
import { CHECK_ROUTES, isCheckRoute } from "../../../lib/captcha/routes";
import {
  CHECK_FLOOD,
  CHECK_STATS_DAYS,
  MODE_DURATIONS,
  flushChecks,
  readMode,
  recentStats,
  setMode,
} from "../../../lib/captcha/store";
import { field } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import { toast } from "../../../lib/toast";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const mode = field(form, "mode");
  const hours = Number(field(form, "hours"));
  if (isCheckMode(mode)) {
    const until =
      Number.isFinite(hours) && hours > 0
        ? new Date(Date.now() + hours * 3_600_000)
        : null;
    await setMode(db, { mode, until, setBy: "admin" });
  }
  return noStoreRedirect("/admin/captcha/?done=mode", 303);
}

// Counts gathered since the last write show at once.
await flushChecks(db, checker);
const state = await readMode(db);
const days = 14;
const stats = await recentStats(db, days);
const totals = new Map<
  string,
  { challenged: number; passed: number; failed: number; puzzles: number }
>();
for (const row of stats) {
  const total = totals.get(row.route) ?? {
    challenged: 0,
    passed: 0,
    failed: 0,
    puzzles: 0,
  };
  total.challenged += row.challenged;
  total.passed += row.passed;
  total.failed += row.failed;
  total.puzzles += row.puzzles;
  totals.set(row.route, total);
}
const routeLabel = (route: string) =>
  isCheckRoute(route) ? CHECK_ROUTES[route].label : route;
const when = (date: Date) =>
  date.toISOString().slice(0, 16).replace("T", " ") + " UTC";
if (Astro.url.searchParams.get("done") === "mode") toast(Astro, "Mode saved.");
const body = "col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7";
const label = "type-label col-span-4 md:col-span-2 xl:col-span-2";
---

<BaseLayout title="Human check · Admin" noindex>
  <section
    aria-labelledby="captcha-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="captcha" />

    <DisplayTitle id="captcha-title">Human check</DisplayTitle>

    <div class="grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6">
      <h2 class={label}>Mode</h2>
      <div class={body}>
        <p data-mode-now>
          Now: <strong>{CHECK_MODE_LABELS[state.mode]}</strong>
          {state.until && <> until {when(state.until)}</>}
          {state.setBy === "auto" && (
            <>
              {" "}
              (raised by itself: {CHECK_FLOOD.failuresPerHour}+ failed checks in
              an hour)
            </>
          )}
        </p>
        <form method="post" class="flex flex-col gap-5">
          <fieldset class="flex flex-col gap-3">
            <legend class="mb-2 font-medium">Mode</legend>
            {CHECK_MODES.map((mode) => (
              <div class="flex items-start gap-3">
                <input
                  id={`mode-${mode}`}
                  type="radio"
                  name="mode"
                  value={mode}
                  checked={state.mode === mode}
                  aria-describedby={`mode-${mode}-hint`}
                  class="mt-1 size-4 shrink-0 accent-accent"
                />
                <div>
                  <label for={`mode-${mode}`} class="font-medium">
                    {CHECK_MODE_LABELS[mode]}
                  </label>
                  <p id={`mode-${mode}-hint`} class="text-sm text-muted">
                    {CHECK_MODE_DESCRIPTIONS[mode]}
                  </p>
                </div>
              </div>
            ))}
          </fieldset>
          <div class="flex flex-col gap-1">
            <label for="mode-hours" class="type-label">
              For
            </label>
            <select
              id="mode-hours"
              name="hours"
              class="w-full border border-ink bg-paper px-3 py-2 text-base text-ink md:w-60"
            >
              {MODE_DURATIONS.map((hours) => (
                <option value={hours === null ? "" : String(hours)}>
                  {hours === null
                    ? "Until changed"
                    : `${String(hours)} ${hours === 1 ? "hour" : "hours"}`}
                </option>
              ))}
            </select>
          </div>
          <button type="submit" class={buttonClasses({ className: "w-fit" })}>
            Save mode
          </button>
        </form>
      </div>

      <h2 class={label}>Routes</h2>
      <div class={body}>
        <p class="text-muted">
          Actions an hour from one visitor before each level: a light
          proof-of-work ({POW_BITS[1]} bits), a heavy one ({POW_BITS[2]} bits),
          then the puzzle. Without JavaScript every level is the puzzle. A pass
          lasts {CHECK_LIMITS.passMs / 60_000} minutes or{" "}
          {CHECK_LIMITS.passUses} actions; {CHECK_LIMITS.failuresToRefuse}{" "}
          failures in an hour turn a visitor away for a while.
        </p>
        <table class="w-full text-sm">
          <caption class="sr-only">Guarded routes</caption>
          <thead>
            <tr class="type-label text-muted">
              <th scope="col" class="text-left font-normal">
                Route
              </th>
              <th scope="col" class="text-left font-normal">
                Pages
              </th>
              <th scope="col" class="text-right font-normal">
                Light
              </th>
              <th scope="col" class="text-right font-normal">
                Heavy
              </th>
              <th scope="col" class="text-right font-normal">
                Puzzle
              </th>
            </tr>
          </thead>
          <tbody>
            {Object.values(CHECK_ROUTES).map((route) => (
              <tr class="border-t border-hair align-baseline">
                <td class="py-2 pr-3">{route.label}</td>
                <td class="py-2 pr-3 font-mono text-xs">{route.where}</td>
                {route.steps.map((step) => (
                  <td class="py-2 text-right">{step}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class={label}>Last {days} days</h2>
      <div class={body}>
        {totals.size === 0 ? (
          <p class="text-muted">Nobody has been checked.</p>
        ) : (
          <table class="w-full text-sm" data-check-stats>
            <caption class="sr-only">Checks in the last {days} days</caption>
            <thead>
              <tr class="type-label text-muted">
                <th scope="col" class="text-left font-normal">
                  Route
                </th>
                <th scope="col" class="text-right font-normal">
                  Checked
                </th>
                <th scope="col" class="text-right font-normal">
                  Passed
                </th>
                <th scope="col" class="text-right font-normal">
                  Failed
                </th>
                <th scope="col" class="text-right font-normal">
                  Puzzles
                </th>
              </tr>
            </thead>
            <tbody>
              {[...totals].map(([route, total]) => (
                <tr class="border-t border-hair align-baseline">
                  <td class="py-2 pr-3">{routeLabel(route)}</td>
                  <td class="py-2 text-right">{total.challenged}</td>
                  <td class="py-2 text-right">{total.passed}</td>
                  <td class="py-2 text-right">{total.failed}</td>
                  <td class="py-2 text-right">{total.puzzles}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <p class="text-sm text-muted">
          Failed checks in the last hour: {checker.failuresLastHour()}. Daily
          counts are kept {CHECK_STATS_DAYS} days.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
