---
import DisplayTitle from "../../components/DisplayTitle.astro";
import { buttonClasses } from "@trilleo/ui";
import AdminNav from "../../components/admin/AdminNav.astro";
import Moderation from "../../components/admin/Moderation.astro";
import SeoChecklist from "../../components/admin/SeoChecklist.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { authConfig } from "../../lib/auth/config";
import { requireAdmin } from "../../lib/auth/guard";
import { MIGRATION_LIST, accountMigration } from "../../lib/auth/migration";
import { formatPostDate } from "../../lib/listings";
import { profileHref } from "../../lib/profile/profile";
import {
  listOldSlugs,
  listPublicPosts,
  postTitles,
} from "../../lib/blog/store";
import { moderationOverview } from "../../lib/comments/store";
import { getDb } from "../../lib/db";
import { indexNowKey } from "../../lib/indexnow";
import { infoPaths } from "../../lib/info-pages";
import { mailSetup } from "../../lib/mail/config";
import { mailCounts } from "../../lib/mail/outbox";
import { postHref } from "../../lib/posts";
import { auditPosts, knownPages, tagPaths } from "../../lib/seo-audit";
import { toolPath, TOOLS } from "../../lib/tools/registry";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const overview = await moderationOverview(db);
const titles = await postTitles(db);

const publicPosts = (await listPublicPosts(db)).map((post) => post.row);
const known = knownPages(
  [
    "/",
    "/writing/",
    "/tools/",
    "/about/",
    "/rss.xml",
    "/llms.txt",
    "/sign-in/",
    "/sign-up/",
    "/sitemap/",
    ...infoPaths(),
    ...publicPosts.map((post) => postHref(post.slug)),
    ...(await listOldSlugs(db)).map((slug) => postHref(slug)),
    ...tagPaths(publicPosts),
    ...TOOLS.map((tool) => toolPath(tool.slug)),
  ],
  // Served by routes that decide per address (uploads, profiles, accounts, …).
  [
    "/media/",
    "/people/",
    "/account",
    "/admin",
    "/auth/",
    "/og/",
    "/files/",
    "/d/",
    "/minecraft/",
  ],
);
const seoIssues = auditPosts(publicPosts, known);
const mail = mailSetup().config;
const mailed = await mailCounts(db);
const mailState =
  mail.transport.kind === "smtp"
    ? `Sending through ${mail.transport.smtp.host}.`
    : mail.available
      ? "Capturing: messages are kept on /admin/mail/, not sent."
      : "Off: nothing is sent.";
const alertsTo =
  mail.adminTo.length > 0 ? mail.adminTo.join(", ") : (admin.email ?? null);

const dateTime = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "UTC",
});
const expiresAt = Astro.locals.session?.expiresAt;

const migration = await accountMigration(db, admin, authConfig());

type Fact = { term: string; value: string } | { term: string; date: Date };
const facts: Fact[] = [
  { term: "Username", value: `@${admin.username}` },
  { term: "Email", value: admin.email ?? "—" },
  {
    term: "Admin by",
    value:
      admin.email && authConfig().adminEmails.has(admin.email)
        ? "ADMIN_EMAILS"
        : "ADMIN_GITHUB_IDS",
  },
  {
    term: "GitHub ID",
    value: admin.githubId === null ? "—" : String(admin.githubId),
  },
  { term: "First signed in", date: admin.createdAt },
  ...(expiresAt ? [{ term: "Signed in until", date: expiresAt }] : []),
];
---

<BaseLayout title="Admin" noindex>
  <section
    aria-labelledby="admin-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="dashboard" />

    <DisplayTitle id="admin-title">Admin</DisplayTitle>

    <div class="mt-7 md:mt-8 xl:mt-12">
      <Moderation {...overview} titles={titles} adminId={admin.id} />
    </div>

    <div class="mt-12">
      <SeoChecklist
        issues={seoIssues}
        checked={publicPosts.length}
        indexNow={indexNowKey() !== undefined}
      />
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">Mail</h2>
      <div class="col-span-4 flex flex-col gap-3 md:col-span-6 xl:col-span-7">
        <p>
          {mailState}{" "}
          {mailed.failed > 0 && <strong>{mailed.failed} failed.</strong>}{" "}
          {mailed.queued > 0 && <span>{mailed.queued} waiting.</span>}
        </p>
        {mail.problem && (
          <p class="border-l-2 border-accent pl-4">{mail.problem}</p>
        )}
        <p class="text-muted">
          {alertsTo
            ? `Alerts go to ${alertsTo}.`
            : "Alerts go nowhere yet: add your address in your account."}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/admin/mail/"
            class={buttonClasses({ variant: "secondary" })}
          >
            Outbox
          </a>
          <a
            href="/account/email/"
            class={buttonClasses({ variant: "secondary" })}
          >
            Your email
          </a>
        </div>
      </div>
    </div>

    <div
      class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6"
      data-account-migration
    >
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
        Accounts
      </h2>
      <div class="col-span-4 flex flex-col gap-3 md:col-span-6 xl:col-span-7">
        <p>
          {migration.withEmail} of {migration.total}{" "}
          {migration.total === 1 ? "account has" : "accounts have"} an email
          address.{" "}
          {migration.waiting > 0
            ? `${String(migration.waiting)} from before email sign-in will be asked for one when they next sign in (GitHub’s verified address is used when it’s free).`
            : "Every active account has moved to email sign-in."}
        </p>
        {migration.admin === "add-email" && (
          <p class="border-l-2 border-accent pl-4">
            Your account has no address yet.{" "}
            <a href="/account/email/" class="underline">
              Add one
            </a>
            , then put it in ADMIN_EMAILS (app.env) so admin access doesn’t
            depend on GitHub.
          </p>
        )}
        {migration.admin === "set-admin-emails" && (
          <p class="border-l-2 border-accent pl-4">
            You’re the admin through ADMIN_GITHUB_IDS. Add{" "}
            <code class="font-mono">ADMIN_EMAILS={admin.email}</code> to app.env
            so it works by email too; ADMIN_GITHUB_IDS can then go.
          </p>
        )}
        {migration.recent.length > 0 && (
          <>
            <p class="type-label text-muted">
              Waiting
              {migration.waiting > MIGRATION_LIST
                ? ` (latest ${String(MIGRATION_LIST)})`
                : ""}
            </p>
            <ul class="flex flex-col gap-1">
              {migration.recent.map((account) => (
                <li>
                  <a href={profileHref(account.username)} class="link-wipe">
                    @{account.username}
                  </a>{" "}
                  <span class="text-muted">
                    · last signed in {formatPostDate(account.lastSignInAt)}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>

    <div class="grid-swiss mt-12 gap-y-6 border-t border-ink pt-4 md:pt-5 xl:pt-6">
      <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">Account</h2>
      <dl class="col-span-4 grid grid-cols-2 gap-x-5 gap-y-4 md:col-span-6 xl:col-span-10 xl:grid-cols-3 xl:gap-x-6">
        {facts.map((fact) => (
          <div class="flex flex-col gap-1 xl:gap-1.5">
            <dt class="type-label text-muted">{fact.term}</dt>
            <dd class="text-base font-medium md:text-[17px] xl:text-lg">
              {"date" in fact ? (
                <time datetime={fact.date.toISOString()}>
                  {dateTime.format(fact.date)} UTC
                </time>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))}
      </dl>

      <div class="col-span-4 flex flex-wrap gap-3 md:col-span-6 md:col-start-3 xl:col-span-10 xl:col-start-3">
        <form method="post" action="/auth/logout">
          <button type="submit" class={buttonClasses()}>
            Sign out
          </button>
        </form>
        <form method="post" action="/auth/logout">
          <input type="hidden" name="everywhere" value="1" />
          <button type="submit" class={buttonClasses({ variant: "secondary" })}>
            Sign out everywhere
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
