---
/**
 * Importing CHUNITHM chart pictures built on the admin's computer: how to make
 * bundles (the to-do list and the bundling script), uploading them, importing them
 * (in the background, one at a time), and what recent imports came to. Every button
 * is a POST to this page with an `intent`.
 */
import AdminNav from "../../../components/admin/AdminNav.astro";
import BundleUpload from "../../../components/admin/chunithm/BundleUpload";
import {
  primaryButton,
  secondaryButton,
} from "../../../components/admin/files/styles";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { BUNDLE_LIMITS } from "../../../lib/chunithm/bundle";
import {
  chartLabels,
  importRunning,
  kickImports,
  queueImport,
  recentImports,
  siteImportDeps,
  waitingBundles,
} from "../../../lib/chunithm/imports";
import { field } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import { getStorage } from "../../../lib/storage/config";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const storageOn = getStorage() !== null;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = field(form, "intent");
  if (intent === "import" || intent === "import-all") {
    const ids =
      intent === "import"
        ? [field(form, "file")]
        : (await waitingBundles(db))
            .filter((bundle) => bundle.status === "published")
            .map((bundle) => bundle.fileId);
    let queued = 0;
    for (const id of ids) if (await queueImport(db, id, new Date())) queued++;
    if (queued > 0) {
      kickImports(siteImportDeps);
      return noStoreRedirect("/admin/chunithm/import/?done=queued", 303);
    }
    error = "Nothing to import: the bundle is still being checked, or gone.";
  } else {
    error = "Unknown action.";
  }
}

const waiting = await waitingBundles(db);
const imports = await recentImports(db);
// Imports left queued (a restart, say) start when the page is opened.
if (!importRunning() && imports.some((row) => row.status === "queued"))
  kickImports(siteImportDeps);
const busy = imports.some(
  (row) => row.status === "queued" || row.status === "running",
);
const done = Astro.url.searchParams.get("done");
const labels = await chartLabels(
  db,
  imports.flatMap((item) =>
    [...(item.summary?.refused ?? []), ...(item.summary?.skipped ?? [])].map(
      (note) => note.chartId,
    ),
  ),
);

const megabytes = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const when = (date: Date | null | undefined) =>
  date
    ? date.toLocaleString("en-GB", {
        day: "numeric",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "UTC",
      }) + " UTC"
    : "—";
const STATUS_WORDS: Record<string, string> = {
  queued: "Waiting",
  running: "Importing",
  done: "Done",
  failed: "Refused",
};

const row =
  "grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6";
const label = "type-label col-span-4 md:col-span-2 xl:col-span-2";
const body =
  "col-span-4 flex min-w-0 flex-col gap-4 md:col-span-6 xl:col-span-10";
---

<BaseLayout title="CHUNITHM import · Admin" noindex>
  <section
    aria-labelledby="admin-import-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="chunithm" />
    <p class="type-label mt-6">
      <a href="/admin/chunithm/" class="group">
        <span class="link-wipe">CHUNITHM</span>
      </a>
      <span class="text-muted"> / Import</span>
    </p>

    <DisplayTitle id="admin-import-title">Import</DisplayTitle>
    <p class="type-lead mt-6 max-w-prose">
      Chart pictures built on your own computer, over your own network, then
      uploaded here. Charts that already have a picture are skipped.
    </p>

    <div class={row}>
      <p class={label}>Make bundles</p>
      <div class={body}>
        <ol class="flex list-decimal flex-col gap-2 pl-5">
          <li>
            <a
              href="/admin/chunithm/todo.json"
              download
              class="underline"
              data-testid="chunithm-todo"
            >
              Download the to-do list
            </a>
            : in-game Master charts without a picture.
          </li>
          <li>
            From a checkout of the site on your computer, run
            <code class="font-mono text-sm">
              pnpm --filter @trilleo/web chunithm:bundle chunithm-todo-….json
            </code>
            . It downloads a few at once, builds them, and writes bundles of
            about {BUNDLE_LIMITS.targetBytes / 1024 / 1024} MB; running it again
            carries on.
          </li>
          <li>Upload the bundles below and import them.</li>
        </ol>
      </div>
    </div>

    <div class={row}>
      <p class={label}>Upload</p>
      <div class={body}>
        {storageOn ? (
          <BundleUpload
            client:load
            maxMegabytes={BUNDLE_LIMITS.maxBytes / 1024 / 1024}
          />
        ) : (
          <p class="text-muted">
            Storage is off here, so nothing can be uploaded.
          </p>
        )}
      </div>
    </div>

    <div class={row}>
      <p class={label}>Ready</p>
      <div class={body}>
        {done === "queued" && (
          <p role="status" class="type-lead border-l-2 border-accent pl-4">
            Importing in the background. Reload in a minute to see what it came
            to.
          </p>
        )}
        {error && (
          <p role="alert" class="type-lead border-l-2 border-accent pl-4">
            {error}
          </p>
        )}
        {waiting.length === 0 ? (
          <p class="text-muted">No bundles waiting.</p>
        ) : (
          <>
            <ul class="flex flex-col" data-testid="chunithm-bundles">
              {waiting.map((bundle) => (
                <li class="flex flex-wrap items-center justify-between gap-3 border-b border-hair py-3">
                  <span>
                    {bundle.name}
                    <span class="block text-muted">
                      {megabytes(bundle.bytes)} · uploaded{" "}
                      {when(bundle.uploadedAt)}
                      {bundle.status === "processing" && " · being checked"}
                    </span>
                  </span>
                  {bundle.status === "published" && (
                    <form method="post">
                      <input type="hidden" name="intent" value="import" />
                      <input type="hidden" name="file" value={bundle.fileId} />
                      <button type="submit" class={secondaryButton}>
                        Import
                      </button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
            {waiting.filter((bundle) => bundle.status === "published").length >
              1 && (
              <form method="post">
                <input type="hidden" name="intent" value="import-all" />
                <button type="submit" class={primaryButton}>
                  Import all
                </button>
              </form>
            )}
          </>
        )}
      </div>
    </div>

    <div class={row}>
      <p class={label}>Imports</p>
      <div class={body}>
        {busy && (
          <p class="text-muted">
            An import is running; reload to follow it. Each bundle’s upload is
            deleted once it’s imported.
          </p>
        )}
        {imports.length === 0 ? (
          <p class="text-muted">Nothing imported yet.</p>
        ) : (
          <ul class="flex flex-col" data-testid="chunithm-imports">
            {imports.map((item) => (
              <li class="flex flex-col gap-2 border-b border-hair py-3">
                <p>
                  {item.name}{" "}
                  <span class="text-muted">
                    · {STATUS_WORDS[item.status] ?? item.status} ·{" "}
                    {when(
                      item.finishedAt ?? item.startedAt ?? item.requestedAt,
                    )}
                  </span>
                </p>
                {item.summary && (
                  <p>
                    {item.summary.error ?? (
                      <>
                        {item.summary.imported} imported,{" "}
                        {item.summary.skipped.length} skipped,{" "}
                        {item.summary.refused.length} refused.
                      </>
                    )}
                  </p>
                )}
                {item.summary &&
                  item.summary.refused.length + item.summary.skipped.length >
                    0 && (
                    <details>
                      <summary class="cursor-pointer text-muted">
                        Skipped and refused charts
                      </summary>
                      <ul class="mt-2 flex flex-col gap-1 text-sm">
                        {[
                          ...item.summary.refused.map((note) => ({
                            ...note,
                            kind: "Refused",
                          })),
                          ...item.summary.skipped.map((note) => ({
                            ...note,
                            kind: "Skipped",
                          })),
                        ].map((note) => (
                          <li>
                            {note.kind}:{" "}
                            <span lang="ja">
                              {labels.get(note.chartId) ??
                                `chart ${String(note.chartId)}`}
                            </span>
                            {note.variant === "mirror" && " (mirror)"},{" "}
                            {note.reason}.
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
