---
/**
 * The admin's forum page. ?tab=forums (default): the whole tree, with counts,
 * reordering (up/down), and links to change or add a category or forum.
 * ?tab=bans: bans in force (lift one early). ?tab=log: the moderation log. The
 * queue of posts waiting and reports is /forum/moderate/ (moderators use it too).
 */
import { LOG_ACTIONS, forumLayout, forumPath, topicPath } from "@trilleo/forum";
import AdminNav from "../../../components/admin/AdminNav.astro";
import {
  primaryButton,
  secondaryButton,
} from "../../../components/admin/files/styles";
import DisplayTitle from "../../../components/DisplayTitle.astro";
import ForumAdminNav from "../../../components/forum/ForumAdminNav.astro";
import Pager from "../../../components/forum/Pager.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { getDb } from "../../../lib/db";
import { readLog } from "../../../lib/forum/log";
import { activeBans, openReportCount } from "../../../lib/forum/moderation";
import { counted, formatWhen, pageParam } from "../../../lib/forum/public";
import { loadTree, waitingCount } from "../../../lib/forum/store";
import { formatPostDate } from "../../../lib/listings";
import { profileHref } from "../../../lib/profile/profile";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const tabParam = Astro.url.searchParams.get("tab");
// The queue moved to /forum/moderate/; old links (alert emails) follow it.
if (tabParam === "waiting") return noStoreRedirect("/forum/moderate/", 301);
const tab =
  tabParam === "bans" ? "bans" : tabParam === "log" ? "log" : "forums";
const done = Astro.url.searchParams.get("done");
const error = Astro.url.searchParams.get("error");
const tree = await loadTree(db);
const everyForum = new Set(tree.flat().map((node) => node.forum.id));
const queue =
  (await waitingCount(db)) +
  (await openReportCount(db, {
    moderatedIds: everyForum,
    everywhere: true,
    admin: true,
  }));
const bans = tab === "bans" ? await activeBans(db) : [];
const page = pageParam(Astro.url);
const log = tab === "log" ? await readLog(db, page) : { rows: [], pages: 1 };
const now = new Date();

const DONE: Record<string, string> = {
  saved: "Saved.",
  created: "Created.",
  deleted: "Deleted.",
  moved: "Moved.",
  lifted: "Ban lifted.",
};
const MODERATION_LABELS = {
  none: "Nothing waits",
  newcomers: "Newcomers wait",
  all: "Everything waits",
} as const;
const row =
  "grid-swiss mt-7 gap-y-5 border-t border-ink pt-4 md:mt-8 md:pt-5 xl:mt-12 xl:pt-6";
const logLabel = (action: string) =>
  Object.hasOwn(LOG_ACTIONS, action)
    ? LOG_ACTIONS[action as keyof typeof LOG_ACTIONS]
    : action;
---

<BaseLayout title="Forum · Admin" noindex>
  <section
    aria-labelledby="admin-forum-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="forum" />
    <DisplayTitle id="admin-forum-title">Forum</DisplayTitle>

    <div class={row}>
      <p class="type-label col-span-4 md:col-span-2 xl:col-span-2">Overview</p>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-10">
        <ForumAdminNav current={tab} queue={queue} />
        {done && DONE[done] && (
          <p role="status" class="type-lead border-l-2 border-accent pl-4">
            {DONE[done]}
          </p>
        )}
        {error && (
          <p role="alert" class="type-lead border-l-2 border-accent pl-4">
            {error}
          </p>
        )}
      </div>
    </div>

    {tab === "forums" && (
      <div class={row}>
        <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
          Structure
        </h2>
        <div class="col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-10">
          <p class="flex flex-wrap gap-3">
            <a href="/admin/forum/new/" class={primaryButton}>
              New category
            </a>
          </p>
          {tree.roots.length === 0 ? (
            <p class="text-muted">No categories yet.</p>
          ) : (
            <ol class="border-b border-ink" data-testid="admin-forum-tree">
              {tree.flat().map((node) => {
                const siblings =
                  node.forum.parentId === null
                    ? tree.roots
                    : (tree.get(node.forum.parentId)?.children ?? []);
                const index = siblings.indexOf(node);
                return (
                  <li
                    class="grid gap-3 border-t border-ink py-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-center"
                    style={`padding-left: ${String(node.depth * 1.5)}rem`}
                    data-forum={node.forum.slug}
                  >
                    <div class="flex min-w-0 flex-col gap-1">
                      <p class="flex flex-wrap items-baseline gap-x-3">
                        <span class="type-label text-muted">
                          {node.forum.kind === "category"
                            ? "Category"
                            : "Forum"}
                        </span>
                        <a
                          href={`/admin/forum/${String(node.forum.id)}/`}
                          class="group font-semibold"
                        >
                          <span class="link-wipe">{node.forum.name}</span>
                        </a>
                        <a
                          href={forumPath(node.forum)}
                          class="group type-label text-muted"
                        >
                          <span class="link-wipe">{forumPath(node.forum)}</span>
                        </a>
                      </p>
                      <p class="type-label flex flex-wrap gap-x-4 text-muted">
                        <span>{counted(node.forum.topicCount, "topic")}</span>
                        <span>{counted(node.forum.postCount, "post")}</span>
                        {node.forum.kind === "forum" && (
                          <>
                            <span>{forumLayout(node.forum.layout).label}</span>
                            <span>
                              {MODERATION_LABELS[node.forum.moderation]}
                            </span>
                          </>
                        )}
                        {node.forum.locked && (
                          <span class="text-ink">Locked</span>
                        )}
                        {node.forum.hidden && (
                          <span class="text-ink">Hidden</span>
                        )}
                      </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                      {(["up", "down"] as const).map((direction) => (
                        <form method="post" action="/admin/forum/action">
                          <input
                            type="hidden"
                            name="forum"
                            value={String(node.forum.id)}
                          />
                          <input
                            type="hidden"
                            name="action"
                            value={direction}
                          />
                          <button
                            type="submit"
                            class={secondaryButton}
                            disabled={
                              direction === "up"
                                ? index <= 0
                                : index >= siblings.length - 1
                            }
                            aria-label={`Move ${node.forum.name} ${direction}`}
                          >
                            {direction === "up" ? "Up" : "Down"}
                          </button>
                        </form>
                      ))}
                      <a
                        href={`/admin/forum/new/?parent=${String(node.forum.id)}`}
                        class={secondaryButton}
                        aria-label={`Add a forum in ${node.forum.name}`}
                      >
                        Add forum
                      </a>
                    </div>
                  </li>
                );
              })}
            </ol>
          )}
        </div>
      </div>
    )}

    {tab === "bans" && (
      <div class={row}>
        <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
          In force
        </h2>
        <div class="col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-10">
          <p class="text-muted">
            Moderators ban people from a post’s menu. A ban stops them posting
            in the forum; they can still read it and use the rest of the site.
          </p>
          {bans.length === 0 ? (
            <p class="text-muted">Nobody is banned.</p>
          ) : (
            <ol class="border-b border-ink" data-testid="forum-bans">
              {bans.map(({ ban, username, by }) => (
                <li class="grid gap-3 border-t border-ink py-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
                  <div class="flex min-w-0 flex-col gap-1">
                    <p class="flex flex-wrap items-baseline gap-x-3">
                      <a
                        href={profileHref(username)}
                        class="group font-semibold"
                      >
                        <span class="link-wipe">@{username}</span>
                      </a>
                      <span class="type-label text-muted">
                        {ban.until
                          ? `Until ${formatPostDate(ban.until)}`
                          : "Permanent"}
                      </span>
                    </p>
                    <p class="text-sm">{ban.reason}</p>
                    <p class="text-sm text-muted">
                      By {by ? `@${by}` : "a deleted account"},{" "}
                      {formatWhen(ban.createdAt, now)}
                    </p>
                  </div>
                  <form method="post" action="/admin/forum/action">
                    <input type="hidden" name="ban" value={String(ban.id)} />
                    <input type="hidden" name="action" value="lift" />
                    <button
                      type="submit"
                      class={secondaryButton}
                      aria-label={`Lift @${username}’s ban`}
                    >
                      Lift ban
                    </button>
                  </form>
                </li>
              ))}
            </ol>
          )}
        </div>
      </div>
    )}

    {tab === "log" && (
      <div class={row}>
        <h2 class="type-label col-span-4 md:col-span-2 xl:col-span-2">
          Newest first
        </h2>
        <div class="col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-10">
          {log.rows.length === 0 ? (
            <p class="text-muted">Nothing yet.</p>
          ) : (
            <ol class="border-b border-ink" data-testid="forum-log">
              {log.rows.map(({ entry, actor, target, forum, topic }) => (
                <li class="flex flex-col gap-1 border-t border-hair py-3">
                  <p>
                    <strong class="font-medium">
                      {actor ? `@${actor}` : "The site"}
                    </strong>{" "}
                    {logLabel(entry.action)}
                    {target && (
                      <>
                        {" "}
                        (
                        <a href={profileHref(target)} class="link-wipe">
                          @{target}
                        </a>
                        )
                      </>
                    )}
                    {topic && forum && (
                      <>
                        {" "}
                        in{" "}
                        <a href={topicPath(forum, topic)} class="link-wipe">
                          {topic.title}
                        </a>
                      </>
                    )}
                  </p>
                  <p class="flex flex-wrap gap-x-3 text-sm text-muted">
                    <time datetime={entry.createdAt.toISOString()}>
                      {formatWhen(entry.createdAt, now)}
                    </time>
                    {entry.detail && <span>{entry.detail}</span>}
                  </p>
                </li>
              ))}
            </ol>
          )}
          <Pager
            page={page}
            pages={log.pages}
            base="/admin/forum/?tab=log"
            label="Log pages"
          />
        </div>
      </div>
    )}
  </section>
</BaseLayout>
