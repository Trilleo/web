---
/**
 * A category or forum, for the admin: /admin/forum/<id>/ to change it,
 * /admin/forum/new/ for a new category, /admin/forum/new/?parent=<id> for a new
 * forum inside another. POST saves (or shows the form again with what's wrong).
 * Also, for an existing one: who may do what there (`intent=permissions`: each
 * group allows, denies or inherits each permission) and who's assigned to moderate
 * it (`intent=add-moderator` / `remove-moderator`). An empty one can be deleted.
 */
import {
  DEFAULT_RULES,
  FORUM_LAYOUTS,
  FORUM_LIMITS,
  FORUM_PERMISSIONS,
  PERMISSION_KEYS,
  forumPath,
} from "@trilleo/forum";
import { buttonClasses } from "@trilleo/ui";
import AdminNav from "../../../components/admin/AdminNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/auth/guard";
import { noStoreRedirect } from "../../../lib/auth/redirect";
import { field, parseId, parseUserId } from "../../../lib/comments/form";
import { getDb } from "../../../lib/db";
import {
  createForum,
  forumDraft,
  readForumForm,
  updateForum,
  validateForum,
  type ForumDraft,
  type ForumField,
} from "../../../lib/forum/admin";
import {
  addModerator,
  forumModeratorList,
  removeModerator,
  saveOverrides,
} from "../../../lib/forum/groups";
import { loadTree } from "../../../lib/forum/store";
import { addPrefix, prefixesOf, removePrefix } from "../../../lib/forum/tags";
import { PREFIX_MAX, PREFIX_STYLES } from "@trilleo/forum";
import { profileHref } from "../../../lib/profile/profile";

export const prerender = false;

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const tree = await loadTree(db);
const isNew = Astro.params.id === "new";
const existing = isNew
  ? undefined
  : tree.get(parseId(Astro.params.id ?? "") ?? 0)?.forum;
if (!isNew && !existing) return Astro.rewrite("/404");
const parentParam = parseId(Astro.url.searchParams.get("parent") ?? "");
const parent = parentParam === null ? undefined : tree.get(parentParam)?.forum;

let draft: ForumDraft = forumDraft(existing, parent?.id);
let errors: Partial<Record<ForumField, string>> = {};
let moderatorError: string | null = null;
const self = existing ? `/admin/forum/${String(existing.id)}/` : "";
const form =
  Astro.request.method === "POST" ? await Astro.request.formData() : null;
const intent = form ? field(form, "intent") || "save" : null;
if (form && existing && intent === "permissions") {
  const groupIds = [...tree.groups.values()].flatMap((group) =>
    group.id === null ? [] : [group.id],
  );
  await saveOverrides(db, existing.id, form, groupIds);
  return noStoreRedirect(`${self}?done=permissions#permissions`, 303);
}
if (form && existing && intent === "add-moderator") {
  if (await addModerator(db, existing.id, field(form, "username")))
    return noStoreRedirect(`${self}?done=moderator#moderators`, 303);
  moderatorError = "There’s no account with that username.";
  Astro.response.status = 422;
}
let prefixError: string | null = null;
if (form && existing && intent === "add-prefix") {
  prefixError = await addPrefix(
    db,
    existing.id,
    field(form, "label"),
    field(form, "style"),
  );
  if (!prefixError) return noStoreRedirect(`${self}?done=prefix#prefixes`, 303);
  Astro.response.status = 422;
}
if (form && existing && intent === "remove-prefix") {
  const prefixId = parseId(field(form, "prefix"));
  if (prefixId !== null) await removePrefix(db, existing.id, prefixId);
  return noStoreRedirect(`${self}?done=prefix-removed#prefixes`, 303);
}
if (form && existing && intent === "remove-moderator") {
  const userId = parseUserId(field(form, "user"));
  if (userId) await removeModerator(db, existing.id, userId);
  return noStoreRedirect(`${self}?done=moderator-removed#moderators`, 303);
}
if (form && intent === "save") {
  draft = readForumForm(form, existing);
  const result = await validateForum(db, tree, draft, existing);
  if (result.ok) {
    const forum = existing
      ? await updateForum(db, existing, result.input)
      : await createForum(db, result.input);
    return noStoreRedirect(
      `/admin/forum/${String(forum.id)}/?done=${existing ? "saved" : "created"}`,
      303,
    );
  }
  errors = result.errors;
  Astro.response.status = 422;
}

const done = Astro.url.searchParams.get("done");
const error = Astro.url.searchParams.get("error");
const category = draft.kind === "category";
const node = existing ? tree.get(existing.id) : undefined;
// Where it can go: any forum or category except itself and what's inside it.
const inside = new Set(
  existing ? tree.descendants(existing.id).map((forum) => forum.id) : [],
);
const parents = tree.flat().filter((option) => !inside.has(option.forum.id));
const empty =
  existing !== undefined &&
  (node?.children.length ?? 0) === 0 &&
  existing.topicCount === 0;
const moderators = existing ? await forumModeratorList(db, existing.id) : [];
const prefixes =
  existing && existing.kind === "forum"
    ? await prefixesOf(db, existing.id)
    : [];
// What each group may do here before this forum's own choices: its parent's rules.
const parentForum = existing?.parentId
  ? tree.get(existing.parentId)?.forum
  : undefined;
const inherited = parentForum
  ? (tree.place(parentForum).rules ?? DEFAULT_RULES)
  : null;
const own = existing ? tree.overridesOf(existing.id) : new Map();
const groupList = [...tree.groups.values()].filter(
  (group) => group.id !== null,
);
const inheritedValue = (slug: string, key: (typeof PERMISSION_KEYS)[number]) =>
  (inherited ??
    Object.fromEntries(
      groupList.map((group) => [group.slug, group.permissions]),
    ))[slug]?.[key] === true;
const DONE_MESSAGES: Record<string, string> = {
  created: "Created.",
  saved: "Saved.",
  permissions: "Permissions saved.",
  moderator: "Moderator added.",
  "moderator-removed": "Moderator removed.",
  prefix: "Prefix added.",
  "prefix-removed": "Prefix removed.",
};
const heading = existing
  ? existing.name
  : category
    ? "New category"
    : `New forum${parent ? ` in ${parent.name}` : ""}`;

const input =
  "w-full border border-ink bg-paper px-3 py-2.5 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-invalid:border-accent";
const row = "grid-swiss gap-y-5 border-t border-ink pt-4 md:pt-5 xl:pt-6";
const label = "type-label col-span-4 md:col-span-2 xl:col-span-2";
const body = "col-span-4 flex flex-col gap-5 md:col-span-6 xl:col-span-7";
const hint = (name: ForumField, text: string) => ({
  id: `${name}-hint`,
  text: errors[name] ?? text,
  error: errors[name] !== undefined,
});
const slugHint = hint(
  "slug",
  `Its address: /forum/<address>/. Leave empty to make one from the name. Changing it breaks links to the old one.`,
);
const nameHint = hint(
  "name",
  `Up to ${String(FORUM_LIMITS.name.max)} characters.`,
);
const descriptionHint = hint(
  "description",
  `One line under its name. Up to ${String(FORUM_LIMITS.description.max)} characters.`,
);
const parentHint = hint("parentId", "The category or forum it sits in.");
---

<BaseLayout title={`${heading} · Forum · Admin`} noindex>
  <section
    aria-labelledby="forum-edit-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <AdminNav current="forum" />
    <p class="type-label mt-6">
      <a href="/admin/forum/" class="group">
        <span class="link-wipe">All forums</span>
      </a>
      {existing && (
        <>
          {" · "}
          <a href={forumPath(existing)} class="group">
            <span class="link-wipe">View it</span>
          </a>
        </>
      )}
    </p>
    <h1 id="forum-edit-title" class="type-band mt-4 break-words">
      {heading}
    </h1>

    {(done || error || Object.keys(errors).length > 0) && (
      <p
        role={error || Object.keys(errors).length > 0 ? "alert" : "status"}
        class="type-lead mt-6 border-l-2 border-accent pl-4"
      >
        {Object.keys(errors).length > 0
          ? "Not saved: check the fields marked below."
          : (error ?? DONE_MESSAGES[done ?? ""] ?? "Saved.")}
      </p>
    )}

    <form
      method="post"
      class="mt-7 flex flex-col gap-12 md:mt-8 xl:mt-12"
      novalidate
    >
      {!existing && <input type="hidden" name="kind" value={draft.kind} />}
      <div class={row}>
        <h2 class={label}>About it</h2>
        <div class={body}>
          <div class="flex flex-col gap-2">
            <label for="name" class="font-medium">
              Name
            </label>
            <input
              id="name"
              name="name"
              value={draft.name}
              required
              class={input}
              aria-invalid={nameHint.error ? "true" : undefined}
              aria-describedby={nameHint.id}
            />
            <p
              id={nameHint.id}
              class:list={[
                "text-sm",
                nameHint.error ? "font-medium" : "text-muted",
              ]}
            >
              {nameHint.text}
            </p>
          </div>
          <div class="flex flex-col gap-2">
            <label for="slug" class="font-medium">
              Address
            </label>
            <input
              id="slug"
              name="slug"
              value={draft.slug}
              class:list={[input, "font-mono"]}
              autocapitalize="none"
              spellcheck="false"
              aria-invalid={slugHint.error ? "true" : undefined}
              aria-describedby={slugHint.id}
            />
            <p
              id={slugHint.id}
              class:list={[
                "text-sm",
                slugHint.error ? "font-medium" : "text-muted",
              ]}
            >
              {slugHint.text}
            </p>
          </div>
          <div class="flex flex-col gap-2">
            <label for="description" class="font-medium">
              Description
            </label>
            <input
              id="description"
              name="description"
              value={draft.description}
              class={input}
              aria-invalid={descriptionHint.error ? "true" : undefined}
              aria-describedby={descriptionHint.id}
            />
            <p
              id={descriptionHint.id}
              class:list={[
                "text-sm",
                descriptionHint.error ? "font-medium" : "text-muted",
              ]}
            >
              {descriptionHint.text}
            </p>
          </div>
          {!category && (
            <div class="flex flex-col gap-2">
              <label for="parentId" class="font-medium">
                Inside
              </label>
              <select
                id="parentId"
                name="parentId"
                class={input}
                aria-invalid={parentHint.error ? "true" : undefined}
                aria-describedby={parentHint.id}
              >
                {parents.map((option) => (
                  <option
                    value={String(option.forum.id)}
                    selected={draft.parentId === String(option.forum.id)}
                  >
                    {"— ".repeat(option.depth)}
                    {option.forum.name}
                  </option>
                ))}
              </select>
              <p
                id={parentHint.id}
                class:list={[
                  "text-sm",
                  parentHint.error ? "font-medium" : "text-muted",
                ]}
              >
                {parentHint.text}
              </p>
            </div>
          )}
        </div>
      </div>

      {!category && (
        <div role="group" aria-labelledby="posting-heading" class={row}>
          <h2 id="posting-heading" class={label}>
            Posting
          </h2>
          <div class={body}>
            <fieldset class="flex flex-col gap-3">
              <legend class="mb-3 font-medium">Layout</legend>
              {FORUM_LAYOUTS.map((layout) => (
                <div
                  class:list={[
                    "flex items-start gap-3",
                    !layout.ready && "text-muted",
                  ]}
                >
                  <input
                    id={`layout-${layout.id}`}
                    type="radio"
                    name="layout"
                    value={layout.id}
                    checked={draft.layout === layout.id}
                    disabled={!layout.ready}
                    aria-describedby={`layout-${layout.id}-hint`}
                    class="mt-1 size-4 shrink-0 accent-accent"
                  />
                  <div>
                    <label for={`layout-${layout.id}`} class="font-medium">
                      {layout.label}
                    </label>
                    {!layout.ready && (
                      <span class="type-label ml-2">Coming later</span>
                    )}
                    <p
                      id={`layout-${layout.id}-hint`}
                      class="text-sm text-muted"
                    >
                      {layout.description}
                    </p>
                  </div>
                </div>
              ))}
              {errors.layout && (
                <p class="text-sm font-medium">{errors.layout}</p>
              )}
            </fieldset>
            <fieldset class="flex flex-col gap-3">
              <legend class="mb-3 font-medium">New topics and replies</legend>
              {(
                [
                  {
                    value: "newcomers",
                    label: "Newcomers’ wait for approval",
                    hint: "Until the admin has approved one of their posts or comments.",
                  },
                  {
                    value: "all",
                    label: "Everyone’s wait for approval",
                    hint: "Except moderators’.",
                  },
                  {
                    value: "none",
                    label: "Nothing waits",
                    hint: "Everything shows at once.",
                  },
                ] as const
              ).map((option) => (
                <div class="flex items-start gap-3">
                  <input
                    id={`moderation-${option.value}`}
                    type="radio"
                    name="moderation"
                    value={option.value}
                    checked={draft.moderation === option.value}
                    aria-describedby={`moderation-${option.value}-hint`}
                    class="mt-1 size-4 shrink-0 accent-accent"
                  />
                  <div>
                    <label
                      for={`moderation-${option.value}`}
                      class="font-medium"
                    >
                      {option.label}
                    </label>
                    <p
                      id={`moderation-${option.value}-hint`}
                      class="text-sm text-muted"
                    >
                      {option.hint}
                    </p>
                  </div>
                </div>
              ))}
            </fieldset>
          </div>
        </div>
      )}

      <div role="group" aria-labelledby="access-heading" class={row}>
        <h2 id="access-heading" class={label}>
          Access
        </h2>
        <div class={body}>
          {!category && (
            <div class="flex items-start gap-3">
              <input
                id="locked"
                type="checkbox"
                name="locked"
                checked={draft.locked}
                aria-describedby="locked-hint"
                class="mt-1 size-4 shrink-0 accent-accent"
              />
              <div>
                <label for="locked" class="font-medium">
                  Locked
                </label>
                <p id="locked-hint" class="text-sm text-muted">
                  Only moderators can start topics or reply (an announcements
                  forum, an archive).
                </p>
              </div>
            </div>
          )}
          <div class="flex items-start gap-3">
            <input
              id="hidden"
              type="checkbox"
              name="hidden"
              checked={draft.hidden}
              aria-describedby="hidden-hint"
              class="mt-1 size-4 shrink-0 accent-accent"
            />
            <div>
              <label for="hidden" class="font-medium">
                Hidden
              </label>
              <p id="hidden-hint" class="text-sm text-muted">
                Only moderators see it, and everything inside it.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class={row}>
        <div class="col-span-4 flex flex-wrap gap-3 md:col-span-8 xl:col-span-12">
          <button type="submit" class={buttonClasses()}>
            {existing ? "Save" : category ? "Create category" : "Create forum"}
          </button>
          <a
            href="/admin/forum/"
            class={buttonClasses({ variant: "secondary" })}
          >
            Cancel
          </a>
        </div>
      </div>
    </form>

    {existing && (
      <form
        id="permissions"
        method="post"
        action={self}
        class:list={[row, "mt-12 scroll-mt-6"]}
      >
        <input type="hidden" name="intent" value="permissions" />
        <h2 class={label}>Who may do what here</h2>
        <div class="col-span-4 flex min-w-0 flex-col gap-5 md:col-span-6 xl:col-span-10">
          <p class="text-muted">
            Each group does what its own settings say
            {parentForum ? `, as ${parentForum.name} changes them` : ""}, unless
            you choose otherwise here. Forums inside this one follow it.{" "}
            <a href="/admin/forum/groups/" class="link-wipe text-ink">
              Change the groups themselves
            </a>
            .
          </p>
          <div
            class="overflow-x-auto border border-ink"
            role="region"
            aria-label="Permissions by group"
          >
            <table
              class="w-full border-collapse text-sm"
              data-testid="forum-permissions"
            >
              <thead>
                <tr>
                  <th
                    scope="col"
                    class="border-b border-ink p-2 text-left font-medium"
                  >
                    Permission
                  </th>
                  {groupList.map((group) => (
                    <th
                      scope="col"
                      class="border-b border-l border-hair border-b-ink p-2 text-left font-medium whitespace-nowrap"
                    >
                      {group.name}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {PERMISSION_KEYS.map((key) => (
                  <tr>
                    <th
                      scope="row"
                      class="border-t border-hair p-2 text-left font-normal"
                    >
                      {FORUM_PERMISSIONS[key].label.replace(/ \(.*\)$/, "")}
                    </th>
                    {groupList.map((group) => {
                      const chosen = own.get(group.slug)?.get(key);
                      return (
                        <td class="border-t border-l border-hair p-1.5">
                          <select
                            name={`override:${String(group.id)}:${key}`}
                            aria-label={`${group.name}: ${FORUM_PERMISSIONS[key].label}`}
                            class:list={[
                              "h-8 w-full min-w-28 border bg-paper px-1",
                              chosen === undefined
                                ? "border-hair text-muted"
                                : "border-ink",
                            ]}
                          >
                            <option
                              value="inherit"
                              selected={chosen === undefined}
                            >
                              {inheritedValue(group.slug, key)
                                ? "Inherit: yes"
                                : "Inherit: no"}
                            </option>
                            <option value="allow" selected={chosen === true}>
                              Allow
                            </option>
                            <option value="deny" selected={chosen === false}>
                              Deny
                            </option>
                          </select>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            <button type="submit" class={buttonClasses()}>
              Save permissions
            </button>
          </p>
        </div>
      </form>
    )}

    {existing && existing.kind === "forum" && (
      <div id="prefixes" class:list={[row, "mt-12 scroll-mt-6"]}>
        <h2 class={label}>Prefixes</h2>
        <div class={body}>
          <p class="text-muted">
            Labels people can put before a topic’s title here, like [Bug] or
            [Guide]. Topics can be listed by prefix.
          </p>
          {prefixes.length === 0 ? (
            <p class="text-muted">None yet.</p>
          ) : (
            <ul
              class="flex flex-col border-b border-ink"
              data-testid="forum-prefixes"
            >
              {prefixes.map((prefix) => (
                <li class="flex items-center justify-between gap-3 border-t border-hair py-2">
                  <span
                    class:list={[
                      "type-label px-1.5 py-0.5",
                      {
                        accent: "bg-accent text-on-accent",
                        ink: "bg-ink text-paper",
                        outline: "border border-ink",
                      }[prefix.style] ?? "border border-ink",
                    ]}
                  >
                    {prefix.label}
                  </span>
                  <form method="post" action={self}>
                    <input type="hidden" name="intent" value="remove-prefix" />
                    <input
                      type="hidden"
                      name="prefix"
                      value={String(prefix.id)}
                    />
                    <button
                      type="submit"
                      class="type-label border border-ink px-2.5 py-1.5 hover:bg-chip"
                      aria-label={`Remove the ${prefix.label} prefix`}
                    >
                      Remove
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          <form
            method="post"
            action={self}
            class="flex flex-wrap items-end gap-3"
          >
            <input type="hidden" name="intent" value="add-prefix" />
            <div class="flex min-w-40 flex-1 flex-col gap-2">
              <label for="prefix-label" class="font-medium">
                New prefix
              </label>
              <input
                id="prefix-label"
                name="label"
                maxlength={PREFIX_MAX}
                placeholder="Bug"
                aria-invalid={prefixError ? "true" : undefined}
                aria-describedby={prefixError ? "prefix-error" : undefined}
                class={input}
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="prefix-style" class="font-medium">
                Look
              </label>
              <select
                id="prefix-style"
                name="style"
                class:list={[input, "w-auto"]}
              >
                {PREFIX_STYLES.map((style) => (
                  <option value={style}>
                    {
                      { accent: "Orange", ink: "Black", outline: "Outlined" }[
                        style
                      ]
                    }
                  </option>
                ))}
              </select>
            </div>
            <button
              type="submit"
              class={buttonClasses({ variant: "secondary" })}
            >
              Add
            </button>
            {prefixError && (
              <p
                id="prefix-error"
                role="alert"
                class="w-full text-sm font-medium"
              >
                {prefixError}
              </p>
            )}
          </form>
        </div>
      </div>
    )}

    {existing && (
      <div id="moderators" class:list={[row, "mt-12 scroll-mt-6"]}>
        <h2 class={label}>Moderators</h2>
        <div class={body}>
          <p class="text-muted">
            People assigned here moderate this {existing.kind} and everything in
            it, besides the Moderators group (every forum) and you.
          </p>
          {moderators.length === 0 ? (
            <p class="text-muted">Nobody assigned.</p>
          ) : (
            <ul
              class="flex flex-col border-b border-ink"
              data-testid="forum-moderators"
            >
              {moderators.map((person) => (
                <li class="flex items-center justify-between gap-3 border-t border-hair py-2">
                  <a href={profileHref(person.username)} class="link-wipe">
                    @{person.username}
                  </a>
                  <form method="post" action={self}>
                    <input
                      type="hidden"
                      name="intent"
                      value="remove-moderator"
                    />
                    <input type="hidden" name="user" value={person.id} />
                    <button
                      type="submit"
                      class="type-label border border-ink px-2.5 py-1.5 hover:bg-chip"
                      aria-label={`Remove @${person.username} as a moderator`}
                    >
                      Remove
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          <form
            method="post"
            action={self}
            class="flex flex-wrap items-end gap-3"
          >
            <input type="hidden" name="intent" value="add-moderator" />
            <div class="flex min-w-48 flex-1 flex-col gap-2">
              <label for="moderator-username" class="font-medium">
                Assign someone
              </label>
              <input
                id="moderator-username"
                name="username"
                placeholder="username"
                autocapitalize="none"
                spellcheck="false"
                aria-invalid={moderatorError ? "true" : undefined}
                aria-describedby={
                  moderatorError ? "moderator-error" : undefined
                }
                class:list={[input, "font-mono"]}
              />
            </div>
            <button
              type="submit"
              class={buttonClasses({ variant: "secondary" })}
            >
              Assign
            </button>
            {moderatorError && (
              <p
                id="moderator-error"
                role="alert"
                class="w-full text-sm font-medium"
              >
                {moderatorError}
              </p>
            )}
          </form>
        </div>
      </div>
    )}

    {existing && (
      <div class:list={[row, "mt-12"]}>
        <h2 class={label}>Delete</h2>
        <div class={body}>
          {empty ? (
            <form
              method="post"
              action="/admin/forum/action"
              class="flex flex-col gap-3"
            >
              <input type="hidden" name="forum" value={String(existing.id)} />
              <input type="hidden" name="action" value="delete" />
              <label class="flex items-start gap-3">
                <input
                  type="checkbox"
                  name="confirm"
                  value="yes"
                  required
                  class="mt-1 size-4 shrink-0 accent-accent"
                />
                <span>Yes, delete {existing.name}.</span>
              </label>
              <p>
                <button
                  type="submit"
                  class={buttonClasses({ variant: "secondary" })}
                >
                  Delete
                </button>
              </p>
            </form>
          ) : (
            <p class="text-muted">
              Only an empty {existing.kind} can be deleted: move or delete
              what’s in it first, or hide it.
            </p>
          )}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
