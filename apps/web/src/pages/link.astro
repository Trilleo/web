---
/**
 * Approving a device link (lib/api/device.ts): a program (a game mod) started one
 * through the API and showed a code; here, signed in, the person types it (or
 * arrives with ?code=), sees what's asking and for what, and approves or declines.
 * GET ?code= looks it up (wrong codes are limited per account, `mayTryCode`); POST
 * `intent` approve|deny with `code` decides. The program's next poll then gets a
 * personal token, listed on /account/apps/.
 */
import { buttonClasses } from "@trilleo/ui";
import AuthCard from "../components/account/AuthCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  decideLink,
  findWaitingLink,
  formatUserCode,
  mayTryCode,
  normalizeUserCode,
  noteWrongCode,
} from "../lib/api/device";
import { USER_TOKEN_LIMITS } from "../lib/api/limits";
import { USER_SCOPES, isUserScope } from "../lib/api/scopes";
import { logEvent } from "../lib/auth/activity";
import { requireUser } from "../lib/auth/guard";
import { noStoreRedirect } from "../lib/auth/redirect";
import { field } from "../lib/comments/form";
import { getDb } from "../lib/db";

export const prerender = false;

const user = requireUser(Astro);
if (user instanceof Response) return user;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const db = await getDb();
const now = new Date();
let error: string | null = null;
let typed = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = field(form, "intent");
  const code = normalizeUserCode(field(form, "code"));
  if (code && (intent === "approve" || intent === "deny")) {
    const result = await decideLink(
      db,
      user.id,
      code,
      intent === "approve",
      now,
    );
    if (result.ok) {
      if (intent === "approve")
        await logEvent(db, user.id, "device-linked", {
          detail: result.link.clientName,
          userAgent: Astro.request.headers.get("user-agent"),
          now,
        });
      return noStoreRedirect(
        `/link/?done=${intent === "approve" ? "approved" : "declined"}`,
        303,
      );
    }
    error =
      result.problem === "limit"
        ? `Your account already has ${String(USER_TOKEN_LIMITS.perUser)} tokens. Revoke one on the Apps page, then link again.`
        : "That code expired or was already used. Start linking again in the program.";
  } else {
    error = "Something was missing. Type the code again.";
  }
  Astro.response.status = 422;
}

const done =
  Astro.request.method === "GET" ? Astro.url.searchParams.get("done") : null;
const asked = Astro.url.searchParams.get("code");
let link: Awaited<ReturnType<typeof findWaitingLink>> = null;
if (Astro.request.method === "GET" && asked !== null && !done) {
  typed = asked.slice(0, 20);
  const code = normalizeUserCode(asked);
  if (!mayTryCode(user.id)) {
    error = "Too many wrong codes. Try again in an hour.";
    Astro.response.status = 429;
  } else if (code === null) {
    noteWrongCode(user.id);
    error = "A code is eight letters, like BCDF-GHJK.";
    Astro.response.status = 422;
  } else {
    link = await findWaitingLink(db, code, now);
    if (!link) {
      noteWrongCode(user.id);
      error =
        "That code isn’t waiting: it may be mistyped, expired or already used.";
      Astro.response.status = 404;
    }
  }
}

const minutesLeft = link
  ? Math.max(1, Math.ceil((link.expiresAt.getTime() - now.getTime()) / 60_000))
  : 0;
const input =
  "w-full border border-ink bg-paper px-3 py-2.5 text-base text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-invalid:border-accent";
---

<BaseLayout title="Link a device" noindex>
  {done === "approved" ? (
    <AuthCard
      id="link-title"
      title="Linked"
      description="Go back to the program."
    >
      <p>
        It can now act for <strong>@{user.username}</strong> within what you
        allowed, until you revoke it.
      </p>
      <a
        href="/account/apps/"
        class={buttonClasses({
          hover: "plain",
          variant: "secondary",
          className: "w-full",
        })}
      >
        Manage apps
      </a>
    </AuthCard>
  ) : done === "declined" ? (
    <AuthCard id="link-title" title="Declined">
      <a
        href="/account/apps/"
        class={buttonClasses({
          hover: "plain",
          variant: "secondary",
          className: "w-full",
        })}
      >
        Manage apps
      </a>
    </AuthCard>
  ) : link ? (
    <AuthCard
      id="link-title"
      title={`Link ${link.clientName}?`}
      description={`Code ${formatUserCode(link.userCode)}. Approve only if you started this.`}
    >
      <div class="flex flex-col gap-3">
        <p>
          <strong class="break-words">{link.clientName}</strong> will be able to
          act for <strong>@{user.username}</strong>:
        </p>
        <ul class="flex list-disc flex-col gap-1 pl-5" data-link-scopes>
          {link.scopes.filter(isUserScope).map((scope) => (
            <li>{USER_SCOPES[scope]}</li>
          ))}
        </ul>
        <p class="text-sm text-muted">
          Expires in {minutesLeft} {minutesLeft === 1 ? "minute" : "minutes"}.
        </p>
      </div>
      <form method="post" action="/link/" class="flex flex-col gap-3">
        <input type="hidden" name="code" value={link.userCode} />
        <button
          type="submit"
          name="intent"
          value="approve"
          class={buttonClasses({ hover: "plain", className: "w-full" })}
        >
          Approve
        </button>
        <button
          type="submit"
          name="intent"
          value="deny"
          class={buttonClasses({
            hover: "plain",
            variant: "secondary",
            className: "w-full",
          })}
        >
          Decline
        </button>
      </form>
    </AuthCard>
  ) : (
    <AuthCard id="link-title" title="Link a device">
      {error && (
        <p slot="notice" role="alert" class="border-l-2 border-accent pl-3">
          {error}
        </p>
      )}
      <form method="get" action="/link/" class="flex flex-col gap-4" novalidate>
        <div class="flex flex-col gap-2">
          <label for="code" class="font-medium">
            Code
          </label>
          <input
            id="code"
            name="code"
            type="text"
            value={typed}
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            maxlength={20}
            required
            aria-invalid={error ? "true" : undefined}
            aria-describedby="code-hint"
            class:list={[input, "font-mono tracking-[0.2em] uppercase"]}
          />
          <p id="code-hint" class="text-sm text-muted">
            Like BCDF-GHJK.
          </p>
        </div>
        <button
          type="submit"
          class={buttonClasses({ hover: "plain", className: "w-full" })}
        >
          Continue
        </button>
      </form>
      <p slot="footer">
        Signed in as @{user.username}. Your linked programs are on the{" "}
        <a href="/account/apps/" class="text-ink underline">
          Apps page
        </a>
        .
      </p>
    </AuthCard>
  )}
</BaseLayout>
