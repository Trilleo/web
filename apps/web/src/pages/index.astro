---
import Counter from "../components/Counter";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../lib/site";
---

<BaseLayout>
  <main class="mx-auto flex max-w-2xl flex-col items-start gap-6 px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight">{SITE_NAME}</h1>
    <p class="text-lg text-neutral-600">
      A new home for the blog and tools is under construction.
    </p>
    <Counter client:load />
  </main>
</BaseLayout>
