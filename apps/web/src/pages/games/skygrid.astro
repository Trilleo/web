---
import { signInHref } from "@trilleo/tool-kit";
import { SkygridApp, meta } from "@trilleo/game-skygrid";
import GameLayout from "../../components/games/GameLayout.astro";
import { getDb } from "../../lib/db";
import { gamePath } from "../../lib/games/registry";
import { loadSkygridSave } from "../../lib/games/skygrid/store";

// Rendered per visit: signed-in players get their island in the page itself.
export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const { user } = Astro.locals;
const account = user
  ? await loadSkygridSave(await getDb(), user.id)
  : undefined;

const controls = [
  ["Arrow keys / WASD", "Walk. Hold to keep walking."],
  ["Walk into something", "Use it: chop, harvest, mine, fish, trade."],
  ["Walk into a mob", "Fight it. Hold the key to keep swinging."],
  ["E / Space", "Use what you face; reel in a bite."],
  ["Click or tap", "Walk there, and use it when you arrive."],
  ["1–6", "Switch panels: skills, gear, bag, craft, minions, collections."],
] as const;
---

<GameLayout meta={meta}>
  <SkygridApp
    client:load
    signedIn={user !== null}
    signInHref={signInHref(gamePath(meta.slug))}
    account={account}
    serverTime={Date.now()}
  />
  <Fragment slot="about">
    <p class="text-[15px] leading-normal xl:text-base">
      You start on a small island in the sky with nothing. Chop trees and
      harvest crops, craft tools, and head through the portals: to the Hub and
      its merchant, the Forest, the Mines and the Shore. Past the Hub’s
      graveyard lies the Spider Cave, and its Broodmother. Every skill levels up
      as you work, and every resource grows a collection that unlocks new
      recipes: tools, swords and armor, and minions, which keep working on your
      island while you’re away.
    </p>
    <h3 class="type-label mt-2">How to play</h3>
    <dl class="grid grid-cols-1 border-t border-ink md:grid-cols-[14rem_1fr]">
      {controls.map(([keys, what]) => (
        <>
          <dt class="pt-3 font-mono text-sm md:border-b md:border-hair md:pb-3">
            {keys}
          </dt>
          <dd class="border-b border-hair pb-3 text-[15px] text-muted md:pt-3">
            {what}
          </dd>
        </>
      ))}
    </dl>
    <p class="text-[15px] leading-normal text-muted">
      Signed out, your island is kept in this browser. Sign in with GitHub to
      keep it in your account instead: the server checks every move, so it’s the
      same island on every device. The player Bazaar and leaderboards are on the
      way.
    </p>
  </Fragment>
</GameLayout>
