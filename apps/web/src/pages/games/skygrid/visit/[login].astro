---
/**
 * Someone's Skygrid island, read-only: /games/skygrid/visit/<login>/. Like profiles,
 * a private profile, a blocked account or no island is a 404 (except to its owner).
 */
import {
  COLLECTION_TIERS,
  GEAR_SLOTS,
  ISLAND_MAPS,
  RESOURCE_IDS,
  SKILLS,
  SKILL_NAMES,
  collectionTier,
  itemName,
  levelOf,
  romanTier,
} from "@trilleo/game-skygrid/core";
import { drawWorld } from "@trilleo/game-skygrid/draw";
import { meta } from "@trilleo/game-skygrid/meta";
import { ArrowLeftIcon } from "@trilleo/ui";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import IslandPicture from "../../../../components/games/IslandPicture.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getDb } from "../../../../lib/db";
import { gamePath } from "../../../../lib/games/registry";
import { findIsland } from "../../../../lib/games/skygrid/leaderboard";
import { displayName, profileHref } from "../../../../lib/profile/profile";

export const prerender = false;

const viewer = Astro.locals.user;
const found = await findIsland(
  await getDb(),
  Astro.params.login ?? "",
  viewer?.id ?? null,
);
if (!found) return Astro.rewrite("/404");

// Depends on who's looking (own/private), so never shared from a cache.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { user, state } = found;
const name = displayName(user);
const own = viewer?.id === user.id;
const home = ISLAND_MAPS.home;
// Their island as it is, with them standing at home.
const drawing = drawWorld(
  {
    ...state,
    pos: { island: "home", ...home.spawn },
    fishing: null,
  },
  null,
  state.now,
);
const minions = state.minions.filter((minion) => minion !== null);
const collections = RESOURCE_IDS.map((item) => ({
  item,
  tier: collectionTier(state.collections[item] ?? 0),
})).filter((entry) => entry.tier > 0);
const gear = GEAR_SLOTS.map((slot) => state.equipment[slot]).filter(
  (item): item is string => item !== undefined,
);

const row = "grid-swiss mt-12 gap-y-4 border-t border-ink pt-4 md:pt-5 xl:pt-6";
const heading = "type-label col-span-4 md:col-span-2 xl:col-span-2";
const body = "col-span-4 md:col-span-6 xl:col-span-7";
---

<BaseLayout
  title={`${name}’s island · ${meta.name}`}
  description={`${name}’s island in ${meta.name}.`}
  noindex
>
  <section
    aria-labelledby="island-title"
    class="px-page pt-4 pb-24 xl:pt-5 xl:pb-32"
  >
    <div class="grid-swiss type-label">
      <Breadcrumb
        class="col-span-2 md:col-span-4 xl:col-span-2"
        items={[
          { label: "(03) Games", href: "/games/" },
          { label: meta.name, href: gamePath(meta.slug) },
        ]}
      />
      <a
        href={`${gamePath(meta.slug)}leaderboard/`}
        class="group col-span-2 inline-flex items-center gap-2 justify-self-end md:col-span-4 xl:col-span-3 xl:col-start-10"
      >
        <ArrowLeftIcon
          size={16}
          className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-x-1"
        />
        <span class="link-wipe">Leaderboard</span>
      </a>
    </div>

    <h1
      id="island-title"
      class="type-headline mt-6 break-words md:mt-8 xl:mt-10"
    >
      {`${name}’s island`}
    </h1>
    <p class="mt-4 text-muted">
      <a href={profileHref(user.githubLogin)} class="text-ink underline">
        @{user.githubLogin}
      </a>
      {own &&
        !user.profilePublic &&
        " · Only you can see this: your profile is private."}
    </p>

    <div class="mt-8 border-y border-ink">
      <IslandPicture
        drawing={drawing}
        label={`${name}’s island, with ${String(minions.length)} ${minions.length === 1 ? "minion" : "minions"} at work.`}
      />
    </div>

    <div class={row}>
      <h2 class={heading}>Skills</h2>
      <dl class={`${body} grid grid-cols-2 gap-x-6 md:grid-cols-3`}>
        {SKILLS.map((skill) => (
          <div class="flex justify-between border-b border-hair py-2">
            <dt class="text-muted">{SKILL_NAMES[skill]}</dt>
            <dd class="font-mono">Lv {levelOf(state.skills[skill])}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class={row}>
      <h2 class={heading}>Minions</h2>
      <div class={body}>
        {minions.length === 0 ? (
          <p class="text-muted">None yet.</p>
        ) : (
          <ul class="flex flex-wrap gap-x-6 gap-y-1">
            {minions.map((minion) => (
              <li>
                {itemName(minion.kind)} Minion {romanTier(minion.tier)}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class={row}>
      <h2 class={heading}>Gear</h2>
      <div class={body}>
        {gear.length === 0 ? (
          <p class="text-muted">Bare-handed.</p>
        ) : (
          <ul class="flex flex-wrap gap-x-6 gap-y-1">
            {gear.map((item) => (
              <li>{itemName(item)}</li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class={row}>
      <h2 class={heading}>Collections</h2>
      <div class={body}>
        {collections.length === 0 ? (
          <p class="text-muted">Nothing gathered yet.</p>
        ) : (
          <ul class="grid grid-cols-2 gap-x-6 md:grid-cols-3">
            {collections.map(({ item, tier }) => (
              <li class="flex justify-between border-b border-hair py-2">
                <span>{itemName(item)}</span>
                <span class="font-mono text-muted">
                  {romanTier(tier)}
                  <span class="sr-only"> of {COLLECTION_TIERS.length}</span>
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
