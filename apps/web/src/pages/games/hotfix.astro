---
import { HotfixApp, meta } from "@trilleo/game-hotfix";
import {
  BIOMES,
  POWERS,
  TOKEN_POINTS,
  packInputs,
} from "@trilleo/game-hotfix/core";
import { signInHref } from "@trilleo/tool-kit";
import GameLayout from "../../components/games/GameLayout.astro";
import { getDb } from "../../lib/db";
import { findReplay } from "../../lib/games/hotfix/leaderboard";
import { loadPlayer } from "../../lib/games/hotfix/store";
import { gamePath } from "../../lib/games/registry";

// Rendered per visit: signed-in players get their record in the page, and
// ?watch=<run> offers a run from the leaderboards to watch.
export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const { user } = Astro.locals;
const watchId = Astro.url.searchParams.get("watch");
const db = user || watchId ? await getDb() : null;
const account = user && db ? await loadPlayer(db, user.id) : null;
const replay = watchId && db ? await findReplay(db, watchId) : null;
const watch = replay
  ? {
      seed: replay.seed,
      inputs: packInputs(replay.inputs),
      rules: replay.rules,
      score: replay.score,
      name: replay.name,
      accessory: replay.accessory,
      board: replay.board,
    }
  : null;
const path = gamePath(meta.slug);

const controls = [
  [
    "Space / ↑ / W",
    "Jump. Hold it to jump higher; let go early for a short hop.",
  ],
  ["Space in the air", "Jump once more (one double jump per jump)."],
  ["↓ / S", "Slide under things, or drop faster in the air."],
  ["P / Esc", "Pause. Leaving the game or the tab pauses it too."],
  ["Tap / swipe down", "Jump and slide on touch screens, or use the buttons."],
] as const;

const obstacles = [
  ["Bugs", "Scuttle along the floor towards you. Jump them."],
  [
    "Stack traces",
    "Stand in the way, short or tall. Jump them, two at a time in Production.",
  ],
  [
    "Drones",
    "Fly at three heights: jump the low ones, slide under the middle ones, and don’t jump into the high ones.",
  ],
  ["404s", "Holes in the floor. Fall in and the run is over."],
] as const;
---

<GameLayout meta={meta}>
  <HotfixApp
    client:load
    signedIn={user !== null}
    signInHref={signInHref(path)}
    account={account}
    watch={watch}
    leaderboardHref={`${path}leaderboard/`}
  />
  <Fragment slot="about">
    <p class="text-[15px] leading-normal xl:text-base">
      Production is down and the fix is ready. Run it there: the robot keeps
      running, faster and faster, and all you choose is when to jump and when to
      slide. Each metre is a point and each token is worth {TOKEN_POINTS}. The
      course is different every run.
    </p>
    <h3 class="type-label mt-2">How to play</h3>
    <dl class="grid grid-cols-1 border-t border-ink md:grid-cols-[14rem_1fr]">
      {controls.map(([keys, what]) => (
        <>
          <dt class="pt-3 font-mono text-sm md:border-b md:border-hair md:pb-3">
            {keys}
          </dt>
          <dd class="border-b border-hair pb-3 text-[15px] text-muted md:pt-3">
            {what}
          </dd>
        </>
      ))}
    </dl>
    <h3 class="type-label mt-2">In the way</h3>
    <dl class="grid grid-cols-1 border-t border-ink md:grid-cols-[14rem_1fr]">
      {obstacles.map(([name, what]) => (
        <>
          <dt class="pt-3 text-[15px] font-semibold md:border-b md:border-hair md:pb-3">
            {name}
          </dt>
          <dd class="border-b border-hair pb-3 text-[15px] text-muted md:pt-3">
            {what}
          </dd>
        </>
      ))}
    </dl>
    <h3 class="type-label mt-2">Power-ups</h3>
    <dl class="grid grid-cols-1 border-t border-ink md:grid-cols-[14rem_1fr]">
      {Object.values(POWERS).map((power) => (
        <>
          <dt class="pt-3 font-mono text-sm md:border-b md:border-hair md:pb-3">
            {power.name}
          </dt>
          <dd class="border-b border-hair pb-3 text-[15px] text-muted md:pt-3">
            {power.summary}
          </dd>
        </>
      ))}
    </dl>
    <h3 class="type-label mt-2">The way there</h3>
    <ol class="grid grid-cols-1 border-t border-ink">
      {BIOMES.map((biome) => (
        <li class="grid grid-cols-1 border-b border-hair py-3 md:grid-cols-[14rem_1fr]">
          <span class="text-[15px] font-semibold">
            {biome.name}
            <span class="block font-mono text-sm font-normal text-muted">
              From {biome.fromMetres} m
            </span>
          </span>
          <span class="text-[15px] text-muted">{biome.line}</span>
        </li>
      ))}
    </ol>
    <h3 class="type-label mt-2">Daily Run and leaderboards</h3>
    <p class="text-[15px] leading-normal">
      The Daily Run is the same course for everyone, all day (UTC); play it as
      often as you like. Signed in, every run you finish is checked: the server
      replays your key presses through the same game, so the score on the board
      is the one you earned. Your best endless run and each day’s best Daily Run
      go on the{" "}
      <a href={`${path}leaderboard/`} class="underline">
        leaderboards
      </a>
      , where anyone can watch them again. Checked runs also earn achievements,
      and some of those unlock something for the robot to wear.
    </p>
    <p class="text-[15px] leading-normal text-muted">
      Signed out, your best score, furthest run and tokens are kept in this
      browser, and they stay there when you sign in: only checked runs count in
      an account.
    </p>
  </Fragment>
</GameLayout>
