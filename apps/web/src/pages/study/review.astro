---
import { Review } from "@trilleo/study/react";
import StudyLayout from "../../components/study/StudyLayout.astro";
import { breadcrumbJsonLd } from "../../lib/seo";
---

<!-- Built once: the session runs in the browser, from your records and the decks. -->
<StudyLayout
  title="Review"
  description="Flashcards due today, scheduled by how well you remember each one."
  current="review"
  crumbs={[{ label: "Review" }]}
  noindex
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Study", path: "/study/" },
      { name: "Review", path: "/study/review/" },
    ]),
  ]}
>
  <div class="grid-swiss px-page gap-y-8 pt-10 pb-24 md:pt-14">
    <header class="col-span-4 flex flex-col gap-3 md:col-span-6 md:col-start-3 xl:col-span-7 xl:col-start-3">
      <h1 class="study-heading text-[2.25rem] leading-tight md:text-5xl">
        Review
      </h1>
      <p class="type-dek text-muted">
        Recall the answer before you turn the card over, then say how it went:
        the next review comes sooner or later to match.
      </p>
    </header>
    <div class="col-span-4 md:col-span-6 md:col-start-3 xl:col-span-7 xl:col-start-3">
      <Review client:load />
      <noscript>
        <p class="study-panel-note">Reviews need JavaScript.</p>
      </noscript>
    </div>
  </div>
</StudyLayout>
