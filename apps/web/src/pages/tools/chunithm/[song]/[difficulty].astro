---
/**
 * One CHUNITHM chart: /tools/chunithm/<SEGA song ID>/<difficulty>/. The song's facts
 * beside it, links to its other difficulties, and the picture (ChartViewer), which
 * asks for a build the first time anyone views it, then the score calculator and the
 * song's other names (the admin adds, removes and decides them here too). Rendered per visit; kept out of
 * search engines (the pictures are sdvx.in's work, credited and linked here).
 */
import {
  DIFFICULTIES,
  DIFFICULTY_LABELS,
  formatConstant,
  isDifficulty,
  sdvxViewerPath,
} from "@trilleo/chunithm";
import { signInHref } from "@trilleo/tool-kit";
import {
  ChartViewer,
  ScoreCalculator,
  meta,
  type SavedChart,
} from "@trilleo/tool-chunithm";
import { ArrowLeftIcon, ArrowUpRightIcon } from "@trilleo/ui";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { SDVX_ORIGIN } from "../../../../lib/chunithm/sources";
import { ALIAS_LIMITS } from "@trilleo/chunithm";
import {
  ALIAS_ERRORS,
  SUGGESTION_LIMITS,
  songAliases,
  suggestionsFor,
  waitingSuggestions,
  type AliasError,
} from "../../../../lib/chunithm/aliases";
import { isAdmin } from "../../../../lib/auth/guard";
import { chartPage, peekBuild } from "../../../../lib/chunithm/viewer";
import { parseId } from "../../../../lib/comments/form";
import { getDb } from "../../../../lib/db";
import { breadcrumbJsonLd, ogImagePath, toolCard } from "../../../../lib/seo";
import { getStorage } from "../../../../lib/storage/config";
import { toolPath } from "../../../../lib/tools/registry";
import { listToolData } from "../../../../lib/tools/store";
import { toast } from "../../../../lib/toast";

export const prerender = false;

const songId = parseId(Astro.params.song ?? "");
const difficulty = Astro.params.difficulty ?? "";
if (songId === null || !isDifficulty(difficulty)) return Astro.rewrite("/404");

const db = await getDb();
const storage = getStorage();
const page = await chartPage(db, storage, songId, difficulty);
if (!page) return Astro.rewrite("/404");
const { song, chart } = page;

// Who's signed in decides the favourites shown, so no shared caching.
Astro.response.headers.set("Cache-Control", "private, no-store");

const initial = storage ? await peekBuild(db, storage, chart, "normal") : null;
const { user } = Astro.locals;
const initialSaved = user
  ? await listToolData<SavedChart>(db, user.id, meta.slug)
  : undefined;
const path = `${toolPath(meta.slug)}${String(song.id)}/${difficulty}/`;
const levelText = `${chart.level}${chart.worldsEndStars ? ` ${"☆".repeat(chart.worldsEndStars)}` : ""}`;
const label = `${song.title}, ${DIFFICULTY_LABELS[difficulty]} ${levelText}`;
const current = page.constants[0];
const image = ogImagePath(`tools/${meta.slug}`, toolCard(meta));
const others = DIFFICULTIES.flatMap((d) => {
  const other = page.charts.find((c) => c.difficulty === d);
  return other ? [{ ...other, difficulty: d }] : [];
});
const aliases = await songAliases(db, song.id);
/** sdvx.in's count of the notes by kind: "Tap 956 · Hold 143 · …". */
function noteTypesText(types: typeof chart.noteTypes): string | null {
  if (!types) return null;
  const kinds = [
    ["Tap", types.tap],
    ["Hold", types.hold],
    ["Slide", types.slide],
    ["Air", types.air],
    ["Flick", types.flick],
  ] as const;
  const known = kinds.flatMap(([name, n]) =>
    n === null ? [] : [`${name} ${n.toLocaleString("en")}`],
  );
  return known.length > 0 ? known.join(" · ") : null;
}
const facts: [string, string | null][] = [
  ["Artist", song.artist],
  ["Also known as", aliases.map((alias) => alias.alias).join(" · ") || null],
  ["Genre", song.genre],
  ["BPM", song.bpm],
  ["Notes designer", chart.designer],
  ["Level", levelText],
  [
    "Constant",
    chart.constant !== null
      ? `${formatConstant(chart.constant)}${current ? ` (${current.name})` : ""}`
      : null,
  ],
  ["Notes", chart.notes !== null ? chart.notes.toLocaleString("en") : null],
  ["By kind", noteTypesText(chart.noteTypes)],
  ["Added in", page.versionName],
  [
    "Removed",
    song.inGame
      ? null
      : `${page.removedInName ?? "Yes"}${song.removedOn ? ` (${song.removedOn})` : ""}`,
  ],
];
const history = page.constants.slice(1);
const admin = isAdmin(user);
const mine = user && !admin ? await suggestionsFor(db, user.id, song.id) : [];
const waiting = admin ? await waitingSuggestions(db, song.id) : [];
const aliasAnswer = Astro.url.searchParams.get("alias");
const DONE: Record<string, string> = {
  sent: "Thanks: your suggestion waits for a look before it’s searchable.",
  added: "Name added: it’s searchable now.",
  removed: "Name removed.",
  approved: "Approved: the name is searchable now.",
  declined: "Declined.",
};
const aliasDone = aliasAnswer !== null && aliasAnswer in DONE;
const aliasMessage = aliasDone
  ? DONE[aliasAnswer]
  : aliasAnswer && aliasAnswer in ALIAS_ERRORS
    ? ALIAS_ERRORS[aliasAnswer as AliasError]
    : null;
const STATUS = {
  pending: "waiting",
  approved: "added",
  declined: "not added",
} as const;
const viewerPath = chart.sdvxRef ? sdvxViewerPath(chart.sdvxRef) : null;
const sdvxPage = viewerPath ? new URL(viewerPath, SDVX_ORIGIN).href : null;
const hasMirror = ["expert", "master", "ultima", "worldsend"].includes(
  difficulty,
);
toast(Astro, aliasMessage, aliasDone ? "done" : "error");
---

<BaseLayout
  title={`${song.title} · ${DIFFICULTY_LABELS[difficulty]} ${chart.level} · ${meta.name}`}
  description={`${song.title} by ${song.artist}: the ${DIFFICULTY_LABELS[difficulty]} chart (${levelText}), read from the bottom up.`}
  noindex
  {image}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Tools", path: "/tools/" },
      { name: meta.name, path: toolPath(meta.slug) },
      { name: `${song.title} (${DIFFICULTY_LABELS[difficulty]})`, path },
    ]),
  ]}
>
  <div class="grid-swiss px-page type-label border-b border-hair py-3 xl:py-4">
    <Breadcrumb
      class="col-span-4 md:col-span-6 xl:col-span-9"
      items={[
        { label: "(02) Tools", href: "/tools/" },
        { label: meta.name, href: toolPath(meta.slug) },
        { label: `${song.title} · ${DIFFICULTY_LABELS[difficulty]}` },
      ]}
    />
    <a
      href={toolPath(meta.slug)}
      class="group col-span-4 inline-flex items-center gap-2 md:col-span-2 md:justify-self-end xl:col-span-3"
    >
      <ArrowLeftIcon
        size={16}
        className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-x-1"
      />
      <span class="link-wipe">All charts</span>
    </a>
  </div>

  <section
    aria-labelledby="chart-title"
    class="px-page pt-8 pb-24 md:pt-10 xl:pt-14 xl:pb-32"
  >
    <div class="grid-swiss gap-y-6 pb-8">
      <div class="col-span-4 md:col-span-8 xl:col-span-9">
        <div class="flex min-w-0 flex-col gap-3">
          <p class="type-label text-muted">
            {DIFFICULTY_LABELS[difficulty]} {levelText}
            {chart.constant !== null && ` · ${formatConstant(chart.constant)}`}
          </p>
          <h1
            id="chart-title"
            class="type-headline break-words [word-break:auto-phrase]"
            lang="ja"
          >
            {song.title}
          </h1>
          <p class="type-dek text-muted" lang="ja">
            {song.artist}
          </p>
        </div>
      </div>
      <div
        class="col-span-4 flex flex-col gap-5 self-start md:col-span-8 md:flex-row md:items-start xl:col-span-3 xl:flex-col"
        data-testid="chart-info"
      >
        <div class="flex w-full max-w-[300px] shrink-0 flex-col gap-2 md:w-56 xl:w-full">
          {
            /* The jacket at its own 300px (never enlarged), smaller where the column is. */
            page.jacket ? (
              <img
                src={page.jacket}
                alt=""
                width={300}
                height={300}
                data-testid="chart-jacket"
                class="aspect-square w-full border border-hair"
              />
            ) : (
              <p
                data-testid="chart-jacket-missing"
                class="flex aspect-square w-full items-center justify-center border border-hair p-4 text-center type-label text-muted"
              >
                No jacket yet
              </p>
            )
          }
          {
            /* Straight to sdvx.in's file, full size: our server never handles it. */
            page.jacketOriginal && (
              <a
                href={page.jacketOriginal}
                target="_blank"
                rel="noreferrer"
                class="group inline-flex items-center gap-2 self-start type-label"
                data-testid="chart-jacket-original"
              >
                <span class="link-wipe">Original jacket</span>
                <ArrowUpRightIcon
                  size={14}
                  className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                />
                <span class="sr-only">(sdvx.in, opens in a new tab)</span>
              </a>
            )
          }
        </div>
        <dl
          class="grid min-w-0 flex-1 grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 self-stretch text-sm"
          data-testid="chart-facts"
        >
          {facts.flatMap(([name, value]) =>
            value
              ? [
                  <dt class="type-label text-muted">{name}</dt>,
                  <dd
                    lang={
                      name === "Artist" ||
                      name === "Notes designer" ||
                      name === "Also known as"
                        ? "ja"
                        : undefined
                    }
                  >
                    {value}
                  </dd>,
                ]
              : [],
          )}
          {history.length > 0 && (
            <>
              <dt class="type-label text-muted">Before</dt>
              <dd>
                {history
                  .map((row) => `${formatConstant(row.constant)} (${row.name})`)
                  .join(", ")}
              </dd>
            </>
          )}
        </dl>
      </div>
      <nav
        aria-label="Difficulties"
        class="col-span-4 md:col-span-8 xl:col-span-12"
      >
        <ul class="flex flex-wrap gap-2">
          {others.map((other) => {
            const text = `${DIFFICULTY_LABELS[other.difficulty]} ${other.level}`;
            const viewable =
              other.sdvxRef !== null && other.withdrawnAt === null;
            return (
              <li>
                {other.difficulty === difficulty ? (
                  <span
                    aria-current="page"
                    class="inline-block border border-ink bg-ink px-3 py-2 type-label text-paper"
                  >
                    {text}
                  </span>
                ) : viewable ? (
                  <a
                    href={`${toolPath(meta.slug)}${String(song.id)}/${other.difficulty}/`}
                    class="inline-block border border-ink px-3 py-2 type-label hover:bg-chip"
                  >
                    {text}
                  </a>
                ) : (
                  <span class="inline-block border border-hair px-3 py-2 type-label text-muted">
                    {text}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
    </div>

    <ChartViewer
      client:load
      songId={song.id}
      difficulty={difficulty}
      label={label}
      initial={initial ? JSON.parse(JSON.stringify(initial)) : null}
      hasMirror={hasMirror}
      signedIn={user !== null}
      signInHref={signInHref(path)}
      initialSaved={initialSaved}
    />

    <section
      id="score"
      aria-labelledby="score-title"
      class="grid-swiss mt-10 gap-y-4 border-t border-ink pt-4 md:pt-5"
    >
      <h2 id="score-title" class="col-span-4 type-label md:col-span-2">
        Score calculator
      </h2>
      <div class="col-span-4 min-w-0 md:col-span-6 xl:col-span-10">
        <ScoreCalculator
          client:visible
          notes={chart.notes}
          constant={chart.constant}
        />
      </div>
    </section>

    <section
      id="names"
      aria-labelledby="names-title"
      class="grid-swiss mt-10 gap-y-4 border-t border-ink pt-4 md:pt-5"
    >
      <h2 id="names-title" class="col-span-4 type-label md:col-span-2">
        Other names
      </h2>
      <div class="col-span-4 flex flex-col gap-4 md:col-span-6 xl:col-span-7">
        <p class="text-muted">
          Search finds songs by the names players use too: nicknames,
          translations, short forms.
          {aliases.length === 0 && " This song has none yet."}
        </p>
        {admin && aliases.length > 0 && (
          <ul class="flex flex-col text-sm" data-testid="admin-names">
            {aliases.map((alias) => (
              <li class="flex items-center justify-between gap-3 border-b border-hair py-2">
                <span lang="ja">{alias.alias}</span>
                <form method="post" action="/tools/chunithm/alias">
                  <input type="hidden" name="intent" value="remove" />
                  <input type="hidden" name="song" value={String(song.id)} />
                  <input type="hidden" name="difficulty" value={difficulty} />
                  <input type="hidden" name="id" value={String(alias.id)} />
                  <button
                    type="submit"
                    class="press border border-ink px-3 py-1.5 type-label hover:bg-chip"
                  >
                    Remove{" "}
                    <span class="sr-only" lang="ja">
                      {alias.alias}
                    </span>
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}
        {admin && waiting.length > 0 && (
          <div class="flex flex-col gap-2" data-testid="admin-suggestions">
            <h3 class="type-label">Suggested, waiting</h3>
            <ul class="flex flex-col text-sm">
              {waiting.map((suggestion) => (
                <li class="border-b border-hair py-2">
                  <form
                    method="post"
                    action="/tools/chunithm/alias"
                    class="flex flex-wrap items-end gap-3"
                  >
                    <input type="hidden" name="song" value={String(song.id)} />
                    <input type="hidden" name="difficulty" value={difficulty} />
                    <input
                      type="hidden"
                      name="id"
                      value={String(suggestion.id)}
                    />
                    <p class="min-w-40 flex-1">
                      <span lang="ja">{suggestion.alias}</span>
                      <span class="text-muted"> · @{suggestion.username}</span>
                    </p>
                    <label class="flex min-w-48 flex-1 flex-col gap-1">
                      <span class="type-label">Note (optional)</span>
                      <input
                        name="note"
                        maxlength={SUGGESTION_LIMITS.noteMax}
                        class="h-9 border border-ink bg-paper px-2 text-ink focus:outline-2 focus:outline-offset-2 focus:outline-accent"
                      />
                    </label>
                    <button
                      type="submit"
                      name="intent"
                      value="approve"
                      class="press h-9 border border-ink bg-ink px-3 type-label text-paper"
                    >
                      Approve
                    </button>
                    <button
                      type="submit"
                      name="intent"
                      value="decline"
                      class="press h-9 border border-ink px-3 type-label hover:bg-chip"
                    >
                      Decline
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </div>
        )}
        {admin ? (
          <form
            method="post"
            action="/tools/chunithm/alias"
            class="flex flex-wrap items-end gap-3"
          >
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="song" value={String(song.id)} />
            <input type="hidden" name="difficulty" value={difficulty} />
            <label class="flex min-w-60 flex-1 flex-col gap-1.5">
              <span class="type-label">Add a name</span>
              <input
                name="alias"
                required
                maxlength={ALIAS_LIMITS.maxLength}
                class="h-11 border border-ink bg-paper px-3 text-ink focus:outline-2 focus:outline-offset-2 focus:outline-accent"
              />
            </label>
            <button
              type="submit"
              class="press h-11 border border-ink px-4 type-nav hover:bg-ink hover:text-paper"
            >
              Add
            </button>
          </form>
        ) : user ? (
          <form
            method="post"
            action="/tools/chunithm/alias"
            class="flex flex-wrap items-end gap-3"
          >
            <input type="hidden" name="song" value={String(song.id)} />
            <input type="hidden" name="difficulty" value={difficulty} />
            <label class="flex min-w-60 flex-1 flex-col gap-1.5">
              <span class="type-label">Suggest a name</span>
              <input
                name="alias"
                required
                maxlength={ALIAS_LIMITS.maxLength}
                class="h-11 border border-ink bg-paper px-3 text-ink focus:outline-2 focus:outline-offset-2 focus:outline-accent"
              />
            </label>
            <button
              type="submit"
              class="press h-11 border border-ink px-4 type-nav hover:bg-ink hover:text-paper"
            >
              Suggest
            </button>
          </form>
        ) : (
          <p>
            <a href={signInHref(path)} class="underline">
              Sign in
            </a>{" "}
            to suggest a name for this song.
          </p>
        )}
        {mine.length > 0 && (
          <ul class="flex flex-col text-sm" data-testid="my-suggestions">
            {mine.map((suggestion) => (
              <li class="border-b border-hair py-2">
                <span lang="ja">{suggestion.alias}</span>
                <span class="text-muted">
                  {" "}
                  · {STATUS[suggestion.status]}
                  {suggestion.note && ` · ${suggestion.note}`}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <p class="mt-8 text-sm text-muted">
      {"Chart picture by "}
      {sdvxPage ? (
        <a href={sdvxPage} class="underline" rel="noreferrer">
          sdvx.in (CHUNITHM譜面保管所)
        </a>
      ) : (
        "sdvx.in (CHUNITHM譜面保管所)"
      )}
      {
        ", whose columns are joined here into one. Song details from SEGA’s song list and otoge-db. CHUNITHM is SEGA’s; this tool isn’t made or endorsed by SEGA or sdvx.in."
      }
    </p>
  </section>
</BaseLayout>
