---
/**
 * One event: /tools/skyblock/events/<slug>/. What happens, when (in the game's words
 * and the next times in real time), how long, where; on now or next. A perk's event
 * (mayor.ts) has times only while someone in office holds the perk. Rendered on the
 * server from the calendar and the election feed; event-clock.ts makes it live.
 * "Remind me" (RemindMe.astro) adds email reminders for the signed-in and browser
 * notifications for anyone (event-notify.ts).
 */
import {
  EVENT_CATEGORIES,
  cadence,
  currentOccurrence,
  eventBySlug,
  formatCountdown,
  formatDuration,
  formatSkyblockDate,
  lengthOf,
  mayorEvents,
  nextOccurrences,
  perkEventBySlug,
  perkHolder,
  scheduleInWords,
  skyblockDate,
} from "@trilleo/skyblock/events";
import { EVENTS_PATH, eventPath, meta } from "@trilleo/tool-skyblock/meta";
import RemindMe from "../../../../components/skyblock/RemindMe.astro";
import SkyblockLayout from "../../../../components/skyblock/SkyblockLayout.astro";
import { getDb } from "../../../../lib/db";
import { ogImagePath, toolCard } from "../../../../lib/seo";
import { liveFeeds } from "../../../../lib/skyblock/feeds";
import {
  SKYBLOCKER_URL,
  cropsOf,
  isoTime,
  utcTime,
} from "../../../../lib/skyblock/events";
import { REMINDER_ANSWERS } from "../../../../lib/skyblock/reminder-answers";
import { listReminders } from "../../../../lib/skyblock/reminders";
import { toast, toastError } from "../../../../lib/toast";

export const prerender = false;

/** How many times ahead the page lists: a day of the hourly ones, else ten. */
const NEXT_SHOWN = 10;
const NEXT_SHOWN_HOURLY = 24;

const slug = Astro.params.slug ?? "";
const base = eventBySlug(slug) ?? perkEventBySlug(slug);
if (!base) return Astro.rewrite("/404");

const now = Date.now();
const user = Astro.locals.user ?? null;
const db = await getDb();
let event = base;
let holder: ReturnType<typeof perkHolder> = null;
const { election, jacob } = await liveFeeds(db, now);
const contest = base.slug === "jacobs-farming-contest";
if (base.perk) {
  holder = election ? perkHolder(election, base.perk) : null;
  // In office: the event with the term's limits. Otherwise it has no times.
  event = mayorEvents(election).find((e) => e.slug === base.slug) ?? base;
}
const inactive = base.perk !== undefined && !event.during;
const current = inactive ? null : currentOccurrence(event, now);
const upcoming = inactive
  ? []
  : nextOccurrences(
      event,
      now,
      event.schedule.kind === "cycle" ? NEXT_SHOWN_HOURLY : NEXT_SHOWN,
    );
const next = upcoming[0];
const length = lengthOf(event.schedule);
const boundary = current ? current.end : (next?.start ?? now);
Astro.response.headers.set("Cache-Control", "private, no-store");
const reminders = user
  ? (await listReminders(db, user.id)).filter((r) => r.eventSlug === base.slug)
  : [];
const answer = REMINDER_ANSWERS[Astro.url.searchParams.get("reminder") ?? ""];
if (answer?.error) toastError(Astro, answer.message);
else if (answer) toast(Astro, answer.message);

const description = `${event.name} in Hypixel SkyBlock: ${scheduleInWords(event).toLowerCase()}. ${event.summary} The next times, with countdowns.`;
const row = "grid-swiss mt-10 gap-y-4 border-t border-ink pt-4 md:pt-5";
const label = "col-span-4 type-label md:col-span-2";
const body =
  "col-span-4 flex min-w-0 flex-col gap-4 md:col-span-6 xl:col-span-10";
const th = "type-label border-b border-ink py-2 pr-4 font-normal text-muted";
const td = "border-b border-hair py-2 pr-4 align-top tabular-nums";
const facts: { term: string; value: string; mono?: boolean }[] = [
  { term: "When", value: scheduleInWords(event) },
  { term: "How often", value: cadence(event) },
  { term: "Lasts", value: formatDuration(length) },
  { term: "Where", value: event.where },
  ...(event.warp ? [{ term: "Warp", value: event.warp, mono: true }] : []),
  { term: "Kind", value: EVENT_CATEGORIES[event.category] },
  ...(event.perk
    ? [
        {
          term: "Perk",
          value: holder
            ? `${event.perk}, held by ${holder.name} (${holder.role})`
            : `${event.perk}, held by nobody now`,
        },
      ]
    : []),
];
---

<SkyblockLayout
  title={`${event.name} · Event timer · ${meta.name}`}
  {description}
  image={ogImagePath(`tools/${meta.slug}`, toolCard(meta))}
  crumbs={[
    { label: "Event timer", path: EVENTS_PATH },
    { label: event.name, path: eventPath(event.slug) },
  ]}
  back={{ href: EVENTS_PATH, label: "Event timer" }}
  notice="own"
>
  <div
    class="grid-swiss gap-y-4 pb-8 md:pb-10"
    data-boundary={String(boundary)}
  >
    <h1 class="type-headline col-span-4 md:col-span-6 xl:col-span-9">
      {event.name}
    </h1>
  </div>

  <section class={row} aria-labelledby="about-title">
    <h2 id="about-title" class={label}>
      <span class="text-muted">(01)</span> About
    </h2>
    <div class={body}>
      <p class="type-dek max-w-[40rem]">{event.summary}</p>
      <p class="border-l-2 border-accent pl-4" data-testid="event-status">
        {current ? (
          <>
            On now, ends in{" "}
            <span class="tabular-nums" data-countdown={String(current.end)}>
              {formatCountdown(current.end - now)}
            </span>
            .
          </>
        ) : next ? (
          <>
            Next in{" "}
            <span class="tabular-nums" data-countdown={String(next.start)}>
              {formatCountdown(next.start - now)}
            </span>
            ,{" "}
            <time datetime={isoTime(next.start)} data-local>
              {utcTime(next.start)}
            </time>
            .
          </>
        ) : inactive ? (
          <>
            Only while a mayor or minister with the {event.perk} perk is in
            office.
          </>
        ) : (
          <>Not again this term.</>
        )}
      </p>
      <dl
        class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm"
        data-testid="event-facts"
      >
        {facts.map((fact) => (
          <>
            <dt class="type-label text-muted">{fact.term}</dt>
            <dd class:list={[fact.mono && "font-mono"]}>{fact.value}</dd>
          </>
        ))}
      </dl>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class={row} aria-labelledby="times-title">
      <h2 id="times-title" class={label}>
        <span class="text-muted">(02)</span> Next times
      </h2>
      <div class={body}>
        <table
          class="w-full border-collapse text-left text-sm"
          data-testid="event-times"
        >
          <thead>
            <tr>
              <th scope="col" class={th}>
                Starts
              </th>
              <th scope="col" class={th}>
                In
              </th>
              <th scope="col" class={th}>
                SkyBlock date
              </th>
              {contest && (
                <th scope="col" class={th}>
                  Crops
                </th>
              )}
            </tr>
          </thead>
          <tbody>
            {upcoming.map((occurrence) => (
              <tr
                data-notify-event={event.slug}
                data-notify-name={event.name}
                data-notify-start={String(occurrence.start)}
              >
                <td class={td}>
                  <time datetime={isoTime(occurrence.start)} data-local>
                    {utcTime(occurrence.start)}
                  </time>
                </td>
                <td class={td}>
                  <span data-countdown={String(occurrence.start)}>
                    {formatCountdown(occurrence.start - now)}
                  </span>
                </td>
                <td class={td}>
                  {formatSkyblockDate(skyblockDate(occurrence.start))}
                </td>
                {contest && (
                  <td class={td} data-testid="contest-crops">
                    {cropsOf(occurrence, jacob) ?? "Not known yet"}
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <RemindMe
    {event}
    {user}
    {reminders}
    {now}
    path={eventPath(base.slug)}
    number={upcoming.length > 0 ? "03" : "02"}
  />

  <Fragment slot="credit">
    Times are worked out from the SkyBlock calendar.
    {contest && (
      <>
        Crops are from the{" "}
        <a href={SKYBLOCKER_URL} class="underline" rel="noreferrer">
          Skyblocker
        </a>{" "}
        mod's calendar.
      </>
    )}
  </Fragment>
</SkyblockLayout>

<script>
  import { startEventClock } from "../../../../components/skyblock/event-clock";
  import { startEventNotify } from "../../../../components/skyblock/event-notify";

  startEventClock();
  startEventNotify();
</script>
