---
/**
 * "Report this project": a plain form (signed in) posting to /minecraft/report.
 * Reports are about the page itself (its text or pictures); files have their own.
 */
import {
  MAX_MESSAGE_LENGTH,
  REPORT_REASONS,
  REPORT_REASON_LABELS,
} from "@trilleo/storage";
import { buttonClasses } from "@trilleo/ui";

interface Props {
  projectId: number;
  name: string;
  /** The page to come back to. */
  back: string;
  signedIn: boolean;
  reported: string | null;
  error: string | null;
}

const { projectId, name, back, signedIn, reported, error } = Astro.props;
const input =
  "w-full border border-ink bg-paper px-3 py-2 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<div id="report" class="scroll-mt-6 border-t border-hair pt-4">
  {reported ? (
    <p role="status" class="text-sm">
      {reported === "again"
        ? "You’ve already reported it. Thanks."
        : "Thanks: the site owner will look at it."}
    </p>
  ) : signedIn ? (
    <details open={error !== null}>
      <summary class="type-label cursor-pointer text-muted hover:text-ink">
        Report this project
      </summary>
      <form
        method="post"
        action="/minecraft/report"
        class="mt-4 flex flex-col gap-3"
      >
        <input type="hidden" name="project" value={String(projectId)} />
        <input type="hidden" name="back" value={back} />
        {error && (
          <p role="alert" class="border-l-2 border-accent pl-3 text-sm">
            {error}
          </p>
        )}
        <fieldset class="flex flex-col gap-2">
          <legend class="mb-1 text-sm font-medium">
            What’s wrong with {name}?
          </legend>
          {REPORT_REASONS.map((reason) => (
            <label class="flex items-start gap-2 text-sm">
              <input
                type="radio"
                name="reason"
                value={reason}
                required
                class="mt-0.5 size-4 shrink-0 accent-accent"
              />
              {REPORT_REASON_LABELS[reason]}
            </label>
          ))}
        </fieldset>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-medium">Details (optional)</span>
          <textarea
            name="details"
            rows="3"
            maxlength={MAX_MESSAGE_LENGTH}
            class={input}
          ></textarea>
        </label>
        <button
          type="submit"
          class={buttonClasses({
            variant: "secondary",
            className: "self-start",
          })}
        >
          Send report
        </button>
      </form>
    </details>
  ) : (
    <a
      href={`/sign-in?next=${encodeURIComponent(`${back}#report`)}`}
      class="type-label text-muted hover:text-ink"
    >
      <span class="link-wipe">Sign in to report this project</span>
    </a>
  )}
</div>
