---
/**
 * One post on a topic page: who wrote it (picture, name, rank, points, badges,
 * when they joined) beside what they wrote and their signature, then reactions and
 * its buttons: quote, reply (threaded forums), votes and accepting (Q&A forums),
 * edit, delete, report, and the moderator's. Every button is a link or a POST form,
 * so it works without JS. Threaded replies are indented by `view.depth`.
 */
import {
  BAN_LENGTHS,
  REASON_MAX,
  badgeInfo,
  postAnchor,
  postPath,
} from "@trilleo/forum";
import type { ReactionSummary } from "../../lib/forum/reactions";
import type { Reputation } from "../../lib/forum/reputation";
import Reactions from "./Reactions.astro";
import Attachments from "./Attachments.astro";
import type { AttachmentView } from "../../lib/forum/attachments";
import { counted, formatWhen } from "../../lib/forum/public";
import type { PostView } from "../../lib/forum/store";
import { formatPostDate } from "../../lib/listings";
import { profileHref } from "../../lib/profile/profile";
import Avatar from "../account/Avatar.astro";
import ReportForm from "./ReportForm.astro";

interface Props {
  view: PostView;
  /** Its number in the topic (1 is the opening post). */
  number: number;
  /** Where "Quote" goes: this page with ?quote=<id>, or nothing if they can't reply. */
  quoteHref?: string | undefined;
  canEdit: boolean;
  canDelete: boolean;
  /** The viewer moderates this forum. */
  mod: boolean;
  /** The viewer may report it (signed in, not their own). */
  canReport?: boolean;
  /** Who's looking (a moderator isn't offered to ban themselves). */
  viewerId?: string | undefined;
  /** The id of the page's split form, which a moderator's tick box joins. */
  splitForm?: string | undefined;
  /** Where buttons come back to. */
  back: string;
  now?: Date;
  reactions?: readonly ReactionSummary[];
  canReact?: boolean;
  /** Q&A forums: the score, the viewer's vote, and whether they may vote. */
  votes?: { score: number; mine: number; canVote: boolean } | undefined;
  /** Q&A forums: the viewer may accept (or take back) this answer. */
  canAccept?: boolean;
  /** Threaded forums: "Reply" to this post goes here. */
  replyHref?: string | undefined;
  signature?: string | undefined;
  reputation?: Reputation | undefined;
  attachments?: readonly AttachmentView[];
  /** "Message" the author (signed in, someone else's post). */
  messageHref?: string | undefined;
}

const {
  view,
  number,
  quoteHref,
  canEdit,
  canDelete,
  mod,
  canReport = false,
  viewerId,
  splitForm,
  back,
  now = new Date(),
  reactions = [],
  canReact = false,
  votes,
  canAccept = false,
  replyHref,
  signature,
  reputation,
  attachments = [],
  messageHref,
} = Astro.props;
const { post, author, html } = view;
const anchor = postAnchor(post);
const person = author && {
  username: author.username,
  name: author.linkedName,
  displayName: author.displayName,
  avatarHash: author.avatarHash,
};
const action = "group type-label cursor-pointer text-muted hover:text-ink";
---

<article
  id={anchor}
  class:list={[
    "grid-swiss scroll-mt-6 gap-y-3 border-t border-hair py-5 md:py-6",
    view.depth > 0 && "forum-nested",
    view.accepted && "border-l-2 border-l-accent pl-3",
  ]}
  style={view.depth > 0 ? `--depth: ${String(view.depth)}` : undefined}
  aria-labelledby={`${anchor}-by`}
  data-post={String(post.id)}
  data-depth={String(view.depth)}
>
  <header class="col-span-4 flex items-center gap-3 md:col-span-2 md:flex-col md:items-start md:gap-2 xl:col-span-2">
    {person ? (
      <Avatar user={person} size="md" />
    ) : (
      <span class="size-14 bg-chip" aria-hidden="true" />
    )}
    <div class="flex min-w-0 flex-col gap-0.5">
      <p id={`${anchor}-by`} class="min-w-0 truncate font-medium">
        <span class="sr-only">Post by </span>
        {author ? (
          author.profile ? (
            <a href={profileHref(author.username)} class="group">
              <span class="link-wipe">{author.name}</span>
            </a>
          ) : (
            author.name
          )
        ) : (
          <span class="text-muted">Deleted account</span>
        )}
      </p>
      {author && (
        <p class="type-label flex flex-wrap gap-x-3 text-muted md:flex-col">
          <span>@{author.username}</span>
          {reputation?.rank && <span class="text-ink">{reputation.rank}</span>}
          <a href={`/forum/members/${author.username}/`} class="group">
            <span class="link-wipe">
              {counted(view.authorPosts, "post")}
              {reputation ? ` · ${counted(reputation.points, "point")}` : ""}
            </span>
          </a>
          <span>Joined {formatPostDate(author.joinedAt)}</span>
          {messageHref && (
            <a href={messageHref} class="group text-ink">
              <span class="link-wipe">Message</span>
            </a>
          )}
        </p>
      )}
      {reputation && reputation.badges.length > 0 && (
        <ul class="flex flex-wrap gap-1" aria-label="Badges">
          {reputation.badges.map((key) => {
            const badge = badgeInfo(key);
            return badge ? (
              <li
                class="type-label border border-hair px-1.5 py-0.5 text-muted"
                title={badge.description}
              >
                {badge.name}
              </li>
            ) : null;
          })}
        </ul>
      )}
      {view.titles.length > 0 && (
        <p class="flex flex-wrap gap-1.5">
          {view.titles.map((title) => (
            <span class="type-label bg-ink px-1.5 py-0.5 text-paper">
              {title}
            </span>
          ))}
        </p>
      )}
    </div>
  </header>

  <div class="col-span-4 flex min-w-0 flex-col gap-3 md:col-span-6 xl:col-span-7">
    <p class="type-label flex flex-wrap items-center gap-x-3 gap-y-1 text-muted">
      <a
        href={postPath(post)}
        class="group text-ink"
        aria-label={`Post ${String(number)}, permanent link`}
      >
        <span class="link-wipe">#{number}</span>
      </a>
      <time datetime={post.createdAt.toISOString()}>
        {formatWhen(post.createdAt, now)}
      </time>
      {post.editedAt &&
        (mod ? (
          <a
            href={`/forum/history/${String(post.id)}/`}
            class="group"
            title={post.editedAt.toISOString()}
          >
            <span class="link-wipe">
              Edited {formatWhen(post.editedAt, now)} · History
            </span>
          </a>
        ) : (
          <span title={post.editedAt.toISOString()}>
            Edited {formatWhen(post.editedAt, now)}
          </span>
        ))}
      {splitForm && (
        <span class="inline-flex items-center gap-1.5">
          <input
            id={`${anchor}-split`}
            type="checkbox"
            name="posts"
            value={String(post.id)}
            form={splitForm}
            class="size-4 accent-accent"
          />
          <label for={`${anchor}-split`}>Split</label>
        </span>
      )}
      {post.state === "pending" && (
        <span class="bg-accent px-1.5 py-0.5 text-on-accent">
          Awaiting approval
        </span>
      )}
      {post.state === "hidden" && (
        <span class="bg-chip px-1.5 py-0.5 text-ink">Hidden</span>
      )}
      {view.accepted && (
        <span class="inline-flex items-center gap-1.5 bg-accent px-1.5 py-0.5 text-on-accent">
          Accepted answer
        </span>
      )}
    </p>
    <div class="flex gap-4">
      {votes && (
        <div
          class="flex shrink-0 flex-col items-center gap-0.5"
          role="group"
          aria-label="Votes"
        >
          {([1, -1] as const).map((value) =>
            votes.canVote ? (
              <form
                method="post"
                action="/forum/engage"
                class={value === -1 ? "order-last" : undefined}
              >
                <input type="hidden" name="do" value="vote" />
                <input type="hidden" name="post" value={String(post.id)} />
                <input type="hidden" name="value" value={String(value)} />
                <input
                  type="hidden"
                  name="back"
                  value={`${back.split("#")[0] ?? back}#${anchor}`}
                />
                <button
                  type="submit"
                  class="inline-flex size-8 cursor-pointer items-center justify-center border border-hair font-mono hover:border-ink aria-pressed:bg-ink aria-pressed:text-paper"
                  aria-pressed={votes.mine === value ? "true" : "false"}
                  aria-label={value === 1 ? "Vote up" : "Vote down"}
                >
                  {value === 1 ? "▲" : "▼"}
                </button>
              </form>
            ) : null,
          )}
          <span
            class="font-mono text-sm"
            aria-label={`Score ${String(votes.score)}`}
          >
            {votes.score}
          </span>
        </div>
      )}
      <div class="min-w-0 flex-1">
        <div class="comment-body forum-body">
          <Fragment set:html={html} />
        </div>
        {attachments.length > 0 && (
          <div class="mt-4">
            <Attachments attachments={attachments} postId={post.id} />
          </div>
        )}
        {signature && (
          <p
            class="mt-4 border-t border-hair pt-2 text-sm text-muted"
            data-signature
          >
            {signature}
          </p>
        )}
      </div>
    </div>

    {(reactions.length > 0 || canReact) && (
      <Reactions
        postId={post.id}
        reactions={reactions}
        canReact={canReact}
        back={`${back.split("#")[0] ?? back}#${anchor}`}
      />
    )}

    {(quoteHref ||
      replyHref ||
      canEdit ||
      canDelete ||
      mod ||
      canReport ||
      canAccept) && (
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        {replyHref && (
          <a href={replyHref} class={action}>
            <span class="link-wipe">Reply</span>
          </a>
        )}
        {canAccept && (
          <form method="post" action="/forum/engage">
            <input
              type="hidden"
              name="do"
              value={view.accepted ? "unaccept" : "accept"}
            />
            <input type="hidden" name="post" value={String(post.id)} />
            <input
              type="hidden"
              name="back"
              value={`${back.split("#")[0] ?? back}#${anchor}`}
            />
            <button type="submit" class={action}>
              <span class="link-wipe">
                {view.accepted ? "Take back acceptance" : "Accept this answer"}
              </span>
            </button>
          </form>
        )}
        {quoteHref && (
          <a href={quoteHref} class={action} data-quote={String(post.id)}>
            <span class="link-wipe">Quote</span>
          </a>
        )}
        {canEdit && (
          <a href={`/forum/edit/${String(post.id)}/`} class={action}>
            <span class="link-wipe">Edit</span>
          </a>
        )}
        {mod && post.state === "pending" && (
          <form method="post" action="/forum/action">
            <input type="hidden" name="post" value={String(post.id)} />
            <input type="hidden" name="action" value="approve" />
            <input type="hidden" name="back" value={back} />
            <button type="submit" class={action}>
              <span class="link-wipe">Approve</span>
            </button>
          </form>
        )}
        {mod && post.state !== "pending" && (
          <form method="post" action="/forum/action">
            <input type="hidden" name="post" value={String(post.id)} />
            <input
              type="hidden"
              name="action"
              value={post.state === "hidden" ? "unhide" : "hide"}
            />
            <input type="hidden" name="back" value={back} />
            <button type="submit" class={action}>
              <span class="link-wipe">
                {post.state === "hidden" ? "Show again" : "Hide"}
              </span>
            </button>
          </form>
        )}
        {(canDelete || mod) && (
          <details class="type-label text-muted">
            <summary class="link-wipe w-fit cursor-pointer hover:text-ink">
              Delete
            </summary>
            <form method="post" action="/forum/action" class="mt-2">
              <input type="hidden" name="post" value={String(post.id)} />
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="back" value={back} />
              <button
                type="submit"
                class="type-label border border-ink px-2.5 py-1.5 text-ink hover:bg-ink hover:text-paper"
              >
                {view.first
                  ? "Yes, delete the whole topic"
                  : "Yes, delete this post"}
              </button>
            </form>
          </details>
        )}
        {canReport && (
          <ReportForm
            target={{ post: post.id }}
            back={`${back.split("#")[0] ?? back}#${anchor}`}
            id={`${anchor}-report`}
          />
        )}
        {mod &&
          author &&
          author.id !== viewerId &&
          !view.titles.includes("Admin") && (
            <details class="type-label text-muted">
              <summary class="link-wipe w-fit cursor-pointer hover:text-ink">
                Ban @{author.username}
              </summary>
              <form
                method="post"
                action="/forum/action"
                class="mt-3 flex max-w-md flex-col gap-3 border border-hair p-3 font-sans text-sm tracking-normal text-ink normal-case"
              >
                <input type="hidden" name="post" value={String(post.id)} />
                <input type="hidden" name="action" value="ban" />
                <input type="hidden" name="back" value={back} />
                <p>
                  Stops them posting in the forum. They can still read it and
                  use the rest of the site.
                </p>
                <div class="flex flex-col gap-1">
                  <label for={`${anchor}-ban-length`} class="font-medium">
                    How long
                  </label>
                  <select
                    id={`${anchor}-ban-length`}
                    name="length"
                    class="h-9 border border-ink bg-paper px-2"
                  >
                    {Object.entries(BAN_LENGTHS).map(([value, length]) => (
                      <option value={value}>{length.label}</option>
                    ))}
                  </select>
                </div>
                <div class="flex flex-col gap-1">
                  <label for={`${anchor}-ban-reason`} class="font-medium">
                    Why (they’ll see this)
                  </label>
                  <input
                    id={`${anchor}-ban-reason`}
                    name="reason"
                    required
                    maxlength={REASON_MAX}
                    class="border border-ink bg-paper px-2 py-1.5"
                  />
                </div>
                <p>
                  <button
                    type="submit"
                    class="type-label border border-ink px-2.5 py-1.5 hover:bg-ink hover:text-paper"
                  >
                    Ban
                  </button>
                </p>
              </form>
            </details>
          )}
      </div>
    )}
  </div>
</article>
