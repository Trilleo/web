---
/**
 * Writing a topic or a reply: an optional title (with a prefix and tags for new
 * topics), the text, a short formatting guide, and Preview / Post buttons (preview
 * is a round trip, so it works without JavaScript; the page shows it above the
 * form). With JavaScript, the preview follows the text as it's typed, and a draft
 * is saved to the account (`draftKey`) and offered back next time.
 */
import type { ForumPrefix } from "@trilleo/db";
import {
  ATTACHMENT_EXTENSIONS,
  ATTACHMENT_LIMITS,
  FORUM_LIMITS,
  MAX_TAGS,
} from "@trilleo/forum";
import ForumAttachments from "./ForumAttachments";
import { buttonClasses } from "@trilleo/ui";

interface Props {
  action: string;
  /** Show a title field with this value (new topics, editing an opening post). */
  title?: string | undefined;
  body: string;
  /** What went wrong, by field. */
  errors?: { title?: string | undefined; body?: string | undefined };
  submitLabel: string;
  /** The textarea's label. */
  label?: string;
  /** Hidden fields the form carries along (the forum, the topic, …). */
  hidden?: Record<string, string>;
  rows?: number;
  id?: string;
  /** Where "Cancel" goes. */
  cancel?: string | undefined;
  /** The forum's prefixes to choose from, and the chosen one. */
  prefixes?: readonly ForumPrefix[];
  prefixId?: number | null;
  /** Show the tags field with this value; `suggestions` feed its list. */
  tags?: string | undefined;
  suggestions?: readonly string[];
  /** Where drafts are saved (drafts.ts's keys); none: no drafts. */
  draftKey?: string | undefined;
  /** A line above the text, e.g. "Replying to @alice" with a link to cancel it. */
  replyingTo?: { label: string; cancel: string } | undefined;
  /** Files can be attached: how many more this post can take. */
  attach?: { room: number } | undefined;
  /** Files already attached (editing), each with a "remove" box. */
  attached?: readonly { id: string; name: string }[];
  /** Uploads sent with a post that came back (refused, or previewed): kept. */
  pending?: readonly string[];
}

const {
  action,
  title,
  body,
  errors = {},
  submitLabel,
  label = "Your post",
  hidden = {},
  rows = 10,
  id = "post-form",
  cancel,
  prefixes = [],
  prefixId = null,
  tags,
  suggestions = [],
  draftKey,
  replyingTo,
  attach,
  attached = [],
  pending = [],
} = Astro.props;
const input =
  "w-full border border-ink bg-paper px-3 py-2.5 text-base text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-invalid:border-accent";
---

<form
  method="post"
  action={action}
  class="flex flex-col gap-5"
  id={id}
  novalidate
  data-post-form
  data-draft-key={draftKey}
>
  {Object.entries(hidden).map(([name, value]) => (
    <input type="hidden" name={name} value={value} />
  ))}
  {replyingTo && (
    <p class="flex flex-wrap items-baseline gap-x-3 border-l-2 border-accent pl-3 text-sm">
      <span>{replyingTo.label}</span>
      <a
        href={replyingTo.cancel}
        class="group type-label text-muted hover:text-ink"
      >
        <span class="link-wipe">Reply to the topic instead</span>
      </a>
    </p>
  )}
  {title !== undefined && (
    <div class="flex flex-col gap-2">
      <label for={`${id}-title`} class="font-medium">
        Title
      </label>
      <div class="flex flex-wrap gap-2">
        {prefixes.length > 0 && (
          <>
            <label for={`${id}-prefix`} class="sr-only">
              Prefix
            </label>
            <select
              id={`${id}-prefix`}
              name="prefix"
              class="h-12 border border-ink bg-paper px-2 text-sm"
            >
              <option value="">No prefix</option>
              {prefixes.map((prefix) => (
                <option
                  value={String(prefix.id)}
                  selected={prefix.id === prefixId}
                >
                  [{prefix.label}]
                </option>
              ))}
            </select>
          </>
        )}
        <input
          id={`${id}-title`}
          name="title"
          value={title}
          required
          maxlength={FORUM_LIMITS.title.max * 2}
          aria-invalid={errors.title ? "true" : undefined}
          aria-describedby={errors.title ? `${id}-title-error` : undefined}
          class:list={[input, "min-w-0 flex-1 text-lg font-semibold"]}
          data-post-title
        />
      </div>
      {errors.title && (
        <p id={`${id}-title-error`} class="text-sm font-medium">
          {errors.title}
        </p>
      )}
    </div>
  )}
  <div class="flex flex-col gap-2">
    <label for={`${id}-body`} class="font-medium">
      {label}
    </label>
    <textarea
      id={`${id}-body`}
      name="body"
      rows={rows}
      required
      aria-invalid={errors.body ? "true" : undefined}
      aria-describedby={`${id}-hint`}
      class:list={[input, "font-serif leading-relaxed"]}
      data-post-body
    >{body}</textarea>
    <p
      id={`${id}-hint`}
      class:list={["text-sm", errors.body ? "text-ink" : "text-muted"]}
    >
      {errors.body ? (
        <strong class="font-medium">{errors.body}</strong>
      ) : (
        <>
          Markdown: **bold**, *italic*, `code`, &gt; quotes, lists, tables, #
          headings and links. @username mentions someone.
        </>
      )}
    </p>
    <p class="type-label text-muted" aria-live="polite" data-draft-status></p>
  </div>
  {tags !== undefined && (
    <div class="flex flex-col gap-2">
      <label for={`${id}-tags`} class="font-medium">
        Tags (optional)
      </label>
      <input
        id={`${id}-tags`}
        name="tags"
        value={tags}
        list={`${id}-tag-list`}
        autocapitalize="none"
        aria-describedby={`${id}-tags-hint`}
        class:list={[input, "font-mono text-sm"]}
        data-post-tags
      />
      <datalist id={`${id}-tag-list`}>
        {suggestions.map((tag) => (
          <option value={tag} />
        ))}
      </datalist>
      <p id={`${id}-tags-hint`} class="text-sm text-muted">
        Up to {MAX_TAGS}, separated by commas or spaces, e.g. “redstone, help”.
      </p>
    </div>
  )}
  {attached.length > 0 && (
    <fieldset class="flex flex-col gap-2">
      <legend class="mb-1 font-medium">Attached files</legend>
      {attached.map((file) => (
        <div class="flex items-center gap-3 text-sm">
          <input
            id={`${id}-remove-${file.id}`}
            type="checkbox"
            name="removeAttachment"
            value={file.id}
            class="size-4 accent-accent"
          />
          <label for={`${id}-remove-${file.id}`}>Remove {file.name}</label>
        </div>
      ))}
    </fieldset>
  )}
  {pending.map((fileId) => (
    <input type="hidden" name="attachments" value={fileId} />
  ))}
  {attach && (
    <div class="flex flex-col gap-2">
      <p class="font-medium">Attachments (optional)</p>
      {pending.length > 0 && (
        <p class="text-sm text-muted">
          {pending.length} {pending.length === 1 ? "file is" : "files are"}{" "}
          already uploaded for this post.
        </p>
      )}
      <noscript>
        <p class="text-sm text-muted">Attaching files needs JavaScript.</p>
      </noscript>
      <ForumAttachments
        client:visible
        accept={ATTACHMENT_EXTENSIONS.map((extension) => `.${extension}`).join(
          ",",
        )}
        room={attach.room}
        hint={`Up to ${String(ATTACHMENT_LIMITS.perPost)} files of ${String(ATTACHMENT_LIMITS.bytes / 1024 / 1024)} MB: pictures, PDF, ZIP, text and Minecraft files.`}
      />
    </div>
  )}
  <slot name="extra" />
  <section
    class="border border-hair p-4"
    aria-label="Live preview"
    hidden
    data-live-preview
  >
    <p class="type-label mb-3 text-muted">Preview</p>
    <div class="comment-body forum-body" data-live-preview-body></div>
  </section>
  <div class="flex flex-wrap items-center gap-3">
    <button type="submit" name="intent" value="post" class={buttonClasses()}>
      {submitLabel}
    </button>
    <button
      type="submit"
      name="intent"
      value="preview"
      class={buttonClasses({ variant: "secondary" })}
      data-preview-button
    >
      Preview
    </button>
    {cancel && (
      <a href={cancel} class="group type-label ml-2 text-muted hover:text-ink">
        <span class="link-wipe">Cancel</span>
      </a>
    )}
  </div>
</form>

<script>
  import { enhancePostForms } from "../../lib/forum/post-form";

  enhancePostForms();
</script>
