---
/**
 * The line a forum page shows after a button: ?done=, ?error=, ?reported=1 or
 * ?report-error= (set by /forum/action and /forum/report).
 */
const DONE: Record<string, string> = {
  banned: "Banned. They can still read the forum.",
};

const params = Astro.url.searchParams;
const done = params.get("done");
const error = params.get("error") ?? params.get("report-error");
const message = error
  ? error.slice(0, 200)
  : params.has("reported")
    ? "Thanks: a moderator will look at your report."
    : done
      ? (DONE[done] ?? null)
      : null;
---

{message && (
  <p
    role={error ? "alert" : "status"}
    class="mt-6 border-l-2 border-accent pl-4"
  >
    {message}
  </p>
)}
