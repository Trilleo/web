---
/** A topic's state at a glance: pinned, locked, waiting, hidden. */
import type { ForumTopic } from "@trilleo/db";

interface Props {
  topic: Pick<ForumTopic, "pinned" | "locked" | "state" | "solvedAt">;
  prefix?: { label: string; style: string } | null | undefined;
}

const { topic, prefix } = Astro.props;
const badges = [
  topic.pinned === "global" && { label: "Announcement", accent: true },
  topic.pinned === "forum" && { label: "Pinned", accent: true },
  topic.locked && { label: "Locked", accent: false },
  topic.state === "pending" && { label: "Awaiting approval", accent: false },
  topic.state === "hidden" && { label: "Hidden", accent: false },
].filter((badge) => badge !== false);
---

{prefix && (
  <span
    class:list={[
      "type-label inline-flex items-center px-1.5 py-0.5",
      {
        accent: "bg-accent text-on-accent",
        ink: "bg-ink text-paper",
        outline: "border border-ink text-ink",
      }[prefix.style] ?? "border border-ink text-ink",
    ]}
  >
    {prefix.label}
  </span>
)}
{topic.solvedAt && (
  <span class="type-label inline-flex items-center gap-1.5 text-ink">
    <span aria-hidden="true">✓</span>Solved
  </span>
)}
{badges.map((badge) => (
  <span
    class:list={[
      "type-label inline-flex items-center gap-1.5",
      badge.accent ? "text-ink" : "bg-chip px-1.5 py-0.5 text-ink",
    ]}
  >
    {badge.accent && <span class="size-2 bg-accent" aria-hidden="true" />}
    {badge.label}
  </span>
))}
