---
/** Info pages as a ruled list: title, a line about each, and when it last changed. */
import { ArrowRightIcon } from "@trilleo/ui";
import { formatPostDate } from "../lib/listings";
import { lastUpdated, type InfoPage } from "../lib/info-pages";

interface Props {
  pages: readonly InfoPage[];
  /** Show each page's "Updated" date. */
  dates?: boolean;
}

const { pages, dates = false } = Astro.props;
---

<ul class="flex flex-col border-t border-ink">
  {pages.map((page) => (
    <li class="border-b border-ink">
      <a
        href={page.path}
        class="group grid gap-x-6 gap-y-1 py-4 md:grid-cols-[1fr_auto] md:items-baseline"
      >
        <span class="flex items-center gap-3 text-lg font-semibold">
          <span class="link-wipe">{page.title}</span>
          <ArrowRightIcon className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:translate-x-1" />
        </span>
        {dates && (
          <span class="type-label text-muted md:row-span-2 md:text-right">
            Updated{" "}
            <time datetime={lastUpdated(page).toISOString().slice(0, 10)}>
              {formatPostDate(lastUpdated(page))}
            </time>
          </span>
        )}
        <span class="text-[15px] leading-normal text-muted">
          {page.description}
        </span>
      </a>
    </li>
  ))}
</ul>
