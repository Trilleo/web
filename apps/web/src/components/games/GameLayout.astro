---
/**
 * The frame around a game. The game itself runs the full width of the page, under
 * a thin bar with its name; what it is and how to play follow below.
 */
import type { GameMeta } from "@trilleo/tool-kit";
import { ArrowLeftIcon } from "@trilleo/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { gamePath } from "../../lib/games/registry";
import {
  breadcrumbJsonLd,
  gameCard,
  gameJsonLd,
  ogImagePath,
} from "../../lib/seo";
import { transitionName } from "../../lib/site";
import Breadcrumb from "../Breadcrumb.astro";

interface Props {
  meta: GameMeta;
}

const { meta } = Astro.props;
const path = gamePath(meta.slug);
const image = ogImagePath(`games/${meta.slug}`, gameCard(meta));
---

<BaseLayout
  title={meta.name}
  description={meta.description}
  {image}
  jsonLd={[
    gameJsonLd(meta, path, image),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Games", path: "/games/" },
      { name: meta.name, path },
    ]),
  ]}
>
  <div class="grid-swiss px-page items-center py-2.5 xl:py-3">
    <Breadcrumb
      class="type-label col-span-3 text-muted md:col-span-6 xl:col-span-9"
      items={[{ label: "(03) Games", href: "/games/" }]}
    >
      <!-- Morphs from the game's name in a list (ToolList with morph="game"). -->
      <h1 class="text-ink">
        <span
          class="inline-block"
          data-morph
          style={`view-transition-name: ${transitionName("game", meta.name)}; view-transition-class: tr-morph`}
        >
          {meta.name}
        </span>
      </h1>
    </Breadcrumb>
    <a
      href="/games/"
      class="group type-label col-span-1 inline-flex items-center gap-2 justify-self-end md:col-span-2 xl:col-span-3"
    >
      <ArrowLeftIcon
        size={16}
        className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-x-1"
      />
      <span class="link-wipe">
        <span class="max-md:sr-only">All </span>games
      </span>
    </a>
  </div>

  <slot />

  <section
    aria-labelledby="game-about"
    class="grid-swiss px-page gap-y-6 pt-12 pb-24 md:pt-16 xl:pb-32"
  >
    <h2 id="game-about" class="type-label col-span-4 md:col-span-2">
      About {meta.name}
    </h2>
    <div class="col-span-4 flex flex-col gap-6 md:col-span-6 xl:col-span-7">
      <p class="type-dek text-muted">{meta.description}</p>
      <slot name="about" />
    </div>
  </section>
</BaseLayout>
