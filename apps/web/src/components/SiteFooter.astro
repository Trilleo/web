---
import { ArrowUpIcon } from "@trilleo/ui";
import { MOJANG_NOTICE } from "../lib/minecraft/catalog";
import {
  GITHUB_URL,
  ICP_FILING,
  NAV_ITEMS,
  PSB_FILING,
  SITE_NAME,
} from "../lib/site";

const year = new Date().getFullYear();
// The footer lists Minecraft beside the header's sections (the header doesn't).
const sections = [
  ...NAV_ITEMS.filter((item) => item.href !== "/about/"),
  { label: "Minecraft", href: "/minecraft/" },
  ...NAV_ITEMS.filter((item) => item.href === "/about/"),
];
// Mojang's usage guidelines ask pages about Minecraft content to say this.
const path = Astro.url.pathname;
const showNotice = path === "/" || path.startsWith("/minecraft");
const linkClass = "group type-label inline-flex min-h-9 items-center";
const smallLink = "group inline-flex min-h-6 items-center";

const information = [
  { label: "Contact", href: "/contact/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Legal", href: "/legal/" },
  { label: "Accessibility", href: "/accessibility/" },
] as const;
const fine = [
  { label: "Terms", href: "/legal/terms/" },
  { label: "Privacy", href: "/legal/privacy/" },
  { label: "Cookies", href: "/legal/cookies/" },
  { label: "Security", href: "/security/" },
  { label: "Colophon", href: "/colophon/" },
  { label: "Sitemap", href: "/sitemap/" },
] as const;
// The PSB number's digits, which its search page links by (…?code=<digits>).
const psbCode = PSB_FILING?.match(/\d+/)?.[0];
---

<footer class="grid-swiss px-page gap-y-6 pt-7 pb-8 md:pt-8 md:pb-10">
  <div class="col-span-4 flex items-baseline justify-between md:col-span-2 md:flex-col md:justify-start md:gap-2 xl:col-span-2">
    <span class="text-xl font-bold tracking-[-0.03em]">{SITE_NAME}</span>
    <span class="type-label whitespace-nowrap text-muted">
      © {year} {SITE_NAME}
    </span>
  </div>

  <nav
    aria-label="Sections"
    class="col-span-2 flex flex-col md:col-span-2 xl:col-span-2"
  >
    {sections.map((item) => (
      <a href={item.href} class={linkClass}>
        <span class="link-wipe">{item.label}</span>
      </a>
    ))}
  </nav>

  <nav
    aria-label="Information"
    class="col-span-2 flex flex-col md:col-span-2 xl:col-span-2"
  >
    {information.map((item) => (
      <a href={item.href} class={linkClass}>
        <span class="link-wipe">{item.label}</span>
      </a>
    ))}
  </nav>

  <nav
    aria-label="Elsewhere"
    class="col-span-2 flex flex-col md:col-span-2 xl:col-span-2"
  >
    <a href="/rss.xml" class={linkClass}>
      <span class="link-wipe">RSS</span>
    </a>
    <a href={GITHUB_URL} class={linkClass}>
      <span class="link-wipe">GitHub</span>
    </a>
  </nav>

  <a
    href="#top"
    class={`${linkClass} col-span-2 gap-2 self-start md:col-span-8 md:justify-self-start xl:col-span-4 xl:justify-self-end`}
  >
    <span class="link-wipe">Back to top</span>
    <ArrowUpIcon
      size={16}
      className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:-translate-y-0.5"
    />
  </a>

  {showNotice && (
    <p class="type-label col-span-4 text-muted md:col-span-8 xl:col-span-12">
      {MOJANG_NOTICE}
    </p>
  )}

  <div class="type-label col-span-4 flex flex-col gap-3 border-t border-hair pt-4 text-muted md:col-span-8 md:flex-row md:items-center md:justify-between xl:col-span-12">
    <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-1">
      {fine.map((item) => (
        <a href={item.href} class={smallLink}>
          <span class="link-wipe">{item.label}</span>
        </a>
      ))}
    </nav>
    {(ICP_FILING || PSB_FILING) && (
      <p
        lang="zh-CN"
        class="flex flex-wrap gap-x-5 gap-y-1 font-cjk text-[13px] tracking-normal normal-case"
      >
        {ICP_FILING && (
          <a href="https://beian.miit.gov.cn/" rel="noopener" class={smallLink}>
            <span class="link-wipe">{ICP_FILING}</span>
          </a>
        )}
        {PSB_FILING && (
          <a
            href={`https://beian.mps.gov.cn/#/query/webSearch${psbCode ? `?code=${psbCode}` : ""}`}
            rel="noopener"
            class={smallLink}
          >
            <span class="link-wipe">{PSB_FILING}</span>
          </a>
        )}
      </p>
    )}
  </div>
</footer>
