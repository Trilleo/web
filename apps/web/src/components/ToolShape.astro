---
import type { ToolShape } from "../lib/listings";

interface Props {
  shape: ToolShape;
  /** Outline instead of fill, e.g. for planned tools. */
  outline?: boolean;
  class?: string;
}

const { shape, outline = false, class: className } = Astro.props;
// The circle carries the accent; the other marks use the ink color.
const fill = outline
  ? "none"
  : shape === "circle"
    ? "var(--tr-accent)"
    : "currentColor";
const stroke = outline ? "currentColor" : "none";
---

<svg
  viewBox="0 0 120 120"
  class={className}
  fill={fill}
  stroke={stroke}
  stroke-width="2"
  aria-hidden="true"
  focusable="false"
>
  {shape === "circle" && (
    <circle
      cx="60"
      cy="60"
      r={outline ? 59 : 60}
      data-shape="circle"
      vector-effect="non-scaling-stroke"
    />
  )}
  {shape === "quarter" && (
    <path
      d="M0 120A120 120 0 0 1 120 0V120Z"
      data-shape="quarter"
      vector-effect="non-scaling-stroke"
    />
  )}
  {shape === "triangle" && (
    <path
      d="M60 3L117 117H3Z"
      data-shape="triangle"
      vector-effect="non-scaling-stroke"
    />
  )}
</svg>
