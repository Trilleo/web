---
import { ArrowUpRightIcon } from "@trilleo/ui";
import {
  TOOL_STATUS_LABEL,
  formatListingNumber,
  type ToolListing,
} from "../lib/listings";
import { transitionName } from "../lib/site";
import ToolIcon from "./ToolIcon.astro";

interface Props {
  tools: readonly ToolListing[];
  /** 3 under a page section's h2 (home); 2 straight under the page's h1 (/tools). */
  headingLevel?: 2 | 3;
  /** The card number's letter: T—01 for tools, G—01 for games. */
  code?: string;
  /** Morphs into the page title that uses the same prefix (ToolLayout, GameLayout). */
  morph?: string;
}

const { tools, headingLevel = 3, code = "T", morph = "tool" } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<ul class="tools border-t border-l border-ink">
  {tools.map((tool, index) => {
    const planned = tool.status === "planned";
    return (
      <li
        class:list={[
          "tool group border-r border-b border-ink",
          { "tool-linked": tool.href },
        ]}
        data-reveal
      >
        <p class="tool-meta type-label">
          <span>
            {code}—{formatListingNumber(index, 2)}
          </span>
          <span class="tool-status text-muted">
            <span
              class:list={["tool-dot", { "tool-dot-outline": planned }]}
              aria-hidden="true"
            />
            {TOOL_STATUS_LABEL[tool.status]}
          </span>
        </p>
        {/* Wrapped so this component's scoped styles can place it (they don't reach child components). */}
        <div class="tool-icon">
          <ToolIcon
            icon={tool.icon}
            outline={planned}
            class="block size-16 md:size-24 xl:size-30"
          />
        </div>
        <div class="tool-body flex flex-col gap-2 md:gap-2.5 xl:gap-3">
          {/* Morphs into the tool or game page's title (ToolLayout, GameLayout). */}
          <Heading
            class="type-card w-fit"
            data-morph="from"
            style={`view-transition-name: ${transitionName(morph, tool.name)}; view-transition-class: tr-morph`}
          >
            {tool.href ? (
              <a href={tool.href} class="tool-link">
                {/* The link covers the whole card (::after); the underline sits on the text. */}
                <span class="link-wipe">{tool.name}</span>
              </a>
            ) : (
              tool.name
            )}
          </Heading>
          <p class="text-[15px] leading-normal text-muted xl:text-base">
            {tool.description}
          </p>
        </div>
        <p class="tool-path inline-flex items-center gap-1.5 font-mono text-xs">
          {tool.path}
          {tool.href && (
            <ArrowUpRightIcon
              size={14}
              className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          )}
        </p>
      </li>
    );
  })}
</ul>

<style>
  .tools {
    display: grid;
  }
  .tool-meta {
    grid-area: meta;
    display: flex;
    gap: 0.5em;
  }
  .tool-status::before {
    content: "· ";
  }
  .tool-dot {
    display: none;
  }
  .tool-icon {
    grid-area: shape;
  }

  /* A live card is one link: the title's link stretches over the whole card, so
     a click anywhere opens it, while the heading stays the only link to read. */
  .tool {
    position: relative;
    transition: background-color var(--tr-dur-base) var(--tr-ease);
  }
  .tool-linked:hover,
  .tool-linked:focus-within {
    background-color: var(--tr-fig);
  }
  .tool-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .tool-link:focus-visible {
    outline: none;
  }
  .tool-linked:has(.tool-link:focus-visible) {
    outline: 2px solid var(--tr-accent);
    outline-offset: -2px;
  }
  .tool-body {
    grid-area: body;
  }
  .tool-path {
    grid-area: path;
  }

  /* Phone: meta beside a small mark, then the text. */
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "meta shape"
      "body body"
      "path path";
    gap: 1.25rem 1rem;
    padding: 1.25rem;
  }
  /* Keep the path close to the description (0.5rem, not the full row gap). */
  .tool-path {
    margin-top: -0.75rem;
  }

  /* iPad: full-width rows, mark on the left, path bottom-right. */
  @media (width >= 48rem) {
    .tool {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      /* The tall mark spans both rows; give the extra height to the second row so the
         text stays right under the meta line. */
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "shape shape meta meta meta meta . ."
        "shape shape body body body body path path";
      gap: 0.625rem 1.25rem;
      padding: 1.5rem 1.25rem;
    }
    .tool-body {
      align-self: start;
    }
    .tool-path {
      margin-top: 0;
      align-self: end;
      justify-self: end;
    }
  }

  /* Desktop: three tall cards, mark in the middle, status with a dot. */
  @media (width >= 80rem) {
    .tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* The icon gets a fixed band and the text takes what's left, so every card's
       title starts at the same height whatever its description's length. Cards
       in a row share the tallest card's height (grid rows stretch). */
    .tool {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 13.5rem 1fr auto;
      grid-template-areas: "meta" "shape" "body" "path";
      gap: 0.75rem;
      min-height: 26.25rem;
      padding: 1.5rem;
    }
    .tool-body {
      align-self: start;
    }
    .tool-meta {
      justify-content: space-between;
    }
    .tool-status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .tool-status::before {
      content: none;
    }
    .tool-dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background-color: var(--tr-ink);
    }
    .tool-dot-outline {
      background-color: transparent;
      border: 1.5px solid var(--tr-ink);
    }
    /* A live tool's dot breathes. Only with motion allowed: an infinite animation
       squeezed to 0.01ms by the reduced-motion reset would flicker. */
    @media (prefers-reduced-motion: no-preference) {
      .tool-dot:not(.tool-dot-outline) {
        animation: tool-breathe 2.4s var(--tr-ease) infinite alternate;
      }
    }
    .tool-icon {
      align-self: center;
    }
    .tool-path {
      justify-self: start;
      padding-top: 0.5rem;
    }
  }

  @keyframes tool-breathe {
    to {
      opacity: 0.25;
    }
  }
</style>
