---
import { ArrowUpRightIcon } from "@trilleo/ui";
import {
  TOOL_STATUS_LABEL,
  formatListingNumber,
  type ToolListing,
} from "../lib/listings";
import { transitionName } from "../lib/site";
import ToolShape from "./ToolShape.astro";

interface Props {
  tools: readonly ToolListing[];
  /** 3 under a page section's h2 (home); 2 straight under the page's h1 (/tools). */
  headingLevel?: 2 | 3;
}

const { tools, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<ul class="tools border-t border-l border-ink">
  {tools.map((tool, index) => {
    const planned = tool.status === "planned";
    return (
      <li class="tool group border-r border-b border-ink" data-reveal>
        <p class="tool-meta type-label">
          <span>T—{formatListingNumber(index, 2)}</span>
          <span class="tool-status text-muted">
            <span
              class:list={["tool-dot", { "tool-dot-outline": planned }]}
              aria-hidden="true"
            />
            {TOOL_STATUS_LABEL[tool.status]}
          </span>
        </p>
        {/* Wrapped so this component's scoped styles can place it (they don't reach child components). */}
        <div class="tool-shape">
          <ToolShape
            shape={tool.shape}
            outline={planned}
            class="block size-16 md:size-24 xl:size-30"
          />
        </div>
        <div class="tool-body flex flex-col gap-2 md:gap-2.5 xl:gap-3">
          {/* Morphs into the tool page's title (ToolLayout). */}
          <Heading
            class="type-card w-fit"
            data-morph="from"
            style={`view-transition-name: ${transitionName("tool", tool.name)}; view-transition-class: tr-morph`}
          >
            {tool.href ? (
              <a href={tool.href} class="link-wipe">
                {tool.name}
              </a>
            ) : (
              tool.name
            )}
          </Heading>
          <p class="text-[15px] leading-normal text-muted xl:text-base">
            {tool.description}
          </p>
        </div>
        <p class="tool-path inline-flex items-center gap-1.5 font-mono text-xs">
          {tool.path}
          {tool.href && (
            <ArrowUpRightIcon
              size={14}
              className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          )}
        </p>
      </li>
    );
  })}
</ul>

<style>
  .tools {
    display: grid;
  }
  .tool-meta {
    grid-area: meta;
    display: flex;
    gap: 0.5em;
  }
  .tool-status::before {
    content: "· ";
  }
  .tool-dot {
    display: none;
  }
  .tool-shape {
    grid-area: shape;
  }

  /* Hovering a card wakes its mark: the circle breathes in, the quarter turns a
     quarter, the triangle flips. */
  .tool {
    transition: background-color var(--tr-dur-base) var(--tr-ease);
  }
  .tool:hover,
  .tool:focus-within {
    background-color: var(--tr-fig);
  }
  /* Turning marks swing past the square's corners mid-turn. */
  .tool-shape :global(svg) {
    overflow: visible;
  }
  .tool-shape :global(svg > *) {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      scale var(--tr-dur-slow) var(--tr-ease),
      rotate var(--tr-dur-slow) var(--tr-ease);
  }
  .tool:is(:hover, :focus-within) .tool-shape :global([data-shape="circle"]) {
    scale: 0.86;
  }
  .tool:is(:hover, :focus-within) .tool-shape :global([data-shape="quarter"]) {
    rotate: 90deg;
  }
  .tool:is(:hover, :focus-within) .tool-shape :global([data-shape="triangle"]) {
    rotate: 180deg;
  }
  .tool-body {
    grid-area: body;
  }
  .tool-path {
    grid-area: path;
  }

  /* Phone: meta beside a small mark, then the text. */
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "meta shape"
      "body body"
      "path path";
    gap: 1.25rem 1rem;
    padding: 1.25rem;
  }
  /* Keep the path close to the description (0.5rem, not the full row gap). */
  .tool-path {
    margin-top: -0.75rem;
  }

  /* iPad: full-width rows, mark on the left, path bottom-right. */
  @media (width >= 48rem) {
    .tool {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      /* The tall mark spans both rows; give the extra height to the second row so the
         text stays right under the meta line. */
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "shape shape meta meta meta meta . ."
        "shape shape body body body body path path";
      gap: 0.625rem 1.25rem;
      padding: 1.5rem 1.25rem;
    }
    .tool-body {
      align-self: start;
    }
    .tool-path {
      margin-top: 0;
      align-self: end;
      justify-self: end;
    }
  }

  /* Desktop: three tall cards, mark in the middle, status with a dot. */
  @media (width >= 80rem) {
    .tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tool {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas: "meta" "shape" "body" "path";
      gap: 0.75rem;
      height: 26.25rem;
      padding: 1.5rem;
    }
    .tool-meta {
      justify-content: space-between;
    }
    .tool-status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .tool-status::before {
      content: none;
    }
    .tool-dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background-color: var(--tr-ink);
    }
    .tool-dot-outline {
      background-color: transparent;
      border: 1.5px solid var(--tr-ink);
    }
    /* A live tool's dot breathes. Only with motion allowed: an infinite animation
       squeezed to 0.01ms by the reduced-motion reset would flicker. */
    @media (prefers-reduced-motion: no-preference) {
      .tool-dot:not(.tool-dot-outline) {
        animation: tool-breathe 2.4s var(--tr-ease) infinite alternate;
      }
    }
    .tool-shape {
      align-self: center;
    }
    .tool-path {
      justify-self: start;
      padding-top: 0.5rem;
    }
  }

  @keyframes tool-breathe {
    to {
      opacity: 0.25;
    }
  }
</style>
