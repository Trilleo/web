---
/**
 * Full-text search over posts (Postgres, see searchPosts). Without JavaScript the form
 * submits to /writing/?q=…, which renders the results. With it, results come from
 * /api/search as you type and replace the element marked [data-search-hides] (the full
 * post list) while a query is active.
 */
interface Props {
  /** The query the page was loaded with. */
  query?: string;
  /** What the server said about that query's results. */
  status?: string;
}

const { query = "", status = "" } = Astro.props;
---

<form
  role="search"
  method="get"
  action="/writing/"
  class="flex flex-col gap-2"
  data-post-search
>
  <label for="post-search-input" class="type-label text-muted">
    Search posts
  </label>
  <input
    id="post-search-input"
    type="search"
    name="q"
    value={query}
    autocomplete="off"
    spellcheck="false"
    placeholder="Type to search"
    class="type-row h-12 w-full border-b border-ink bg-transparent placeholder:text-muted focus:outline-none focus-visible:border-accent"
  />
  <p
    class="type-label min-h-4 text-muted"
    aria-live="polite"
    data-search-status
  >
    {status}
  </p>
</form>

<template id="post-search-result">
  <li class="border-t border-ink">
    <!-- href is replaced with each result's URL. -->
    <a href="/writing/" class="group flex flex-col gap-2 py-5 md:py-6">
      <span class="type-row">
        <span class="link-wipe" data-title></span>
      </span>
      <span class="text-[15px] leading-normal text-muted" data-excerpt></span>
    </a>
  </li>
</template>

<script>
  import { searchSummary } from "../lib/posts";

  interface SearchResult {
    url: string;
    title: string;
    /** Escaped text with the matches in <mark>. */
    excerpt: string;
  }

  const form = document.querySelector<HTMLFormElement>("[data-post-search]");
  const input = form?.querySelector<HTMLInputElement>("input[type=search]");
  const status = form?.querySelector<HTMLElement>("[data-search-status]");
  const template = document.querySelector<HTMLTemplateElement>(
    "#post-search-result",
  );
  const results = document.querySelector<HTMLOListElement>(
    "[data-search-results]",
  );
  const hides = document.querySelector<HTMLElement>("[data-search-hides]");

  /** Just the text and <mark>s of the excerpt, never other markup. */
  const excerptNodes = (html: string): Node[] =>
    [...new DOMParser().parseFromString(html, "text/html").body.childNodes].map(
      (node) => {
        const text = node.textContent ?? "";
        if (node.nodeName !== "MARK") return document.createTextNode(text);
        const mark = document.createElement("mark");
        mark.textContent = text;
        return mark;
      },
    );

  if (form && input && status && template && results && hides) {
    let latest = 0;

    const show = (searching: boolean) => {
      results.hidden = !searching;
      hides.hidden = searching;
    };

    const run = async () => {
      const query = input.value.trim();
      // Ignore results that arrive after a newer query started.
      const ticket = ++latest;
      const url = new URL(location.href);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);

      if (!query) {
        show(false);
        status.textContent = "";
        return;
      }

      let found: SearchResult[];
      try {
        const response = await fetch(
          `/api/search?q=${encodeURIComponent(query)}`,
        );
        if (!response.ok) throw new Error(String(response.status));
        found = ((await response.json()) as { results: SearchResult[] })
          .results;
      } catch {
        if (ticket === latest)
          status.textContent = "Search isn’t working right now.";
        return;
      }
      if (ticket !== latest) return;

      results.replaceChildren(
        ...found.map((item) => {
          const fragment = template.content.cloneNode(true) as DocumentFragment;
          const link = fragment.querySelector("a");
          const title = fragment.querySelector("[data-title]");
          const excerpt = fragment.querySelector("[data-excerpt]");
          if (link) link.href = item.url;
          if (title) title.textContent = item.title;
          excerpt?.replaceChildren(...excerptNodes(item.excerpt));
          return fragment;
        }),
      );
      status.textContent = searchSummary(found.length, query);
      show(true);
    };

    let timer: number | undefined;
    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(), 150);
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void run();
    });
  }
</script>
