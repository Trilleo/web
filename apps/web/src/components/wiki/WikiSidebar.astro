---
/**
 * A wiki's sidebar: its own sections (set in its settings), then the wiki's tools.
 * Everything here belongs to this wiki.
 */
import type { Wiki } from "@trilleo/db";
import type { WikiAccess } from "../../lib/wiki/access";
import { normalizeTitle } from "../../lib/wiki/titles";
import { toolHref, wikiHref } from "../../lib/wiki/wikis";

interface Props {
  wiki: Wiki;
  access: WikiAccess | null;
}

const { wiki, access } = Astro.props;
const sections = wiki.nav
  .map((section) => ({
    label: section.label,
    links: section.links.flatMap((link) => {
      const title = normalizeTitle(link.page);
      return title ? [{ label: link.label, href: wikiHref(wiki, title) }] : [];
    }),
  }))
  .filter((section) => section.links.length > 0);

const tools = [
  { label: "Recent changes", href: toolHref(wiki, "recent") },
  { label: "All pages", href: toolHref(wiki, "pages") },
  { label: "Categories", href: toolHref(wiki, "categories") },
  { label: "Wanted pages", href: toolHref(wiki, "wanted") },
  { label: "Components", href: toolHref(wiki, "components") },
  { label: "Log", href: toolHref(wiki, "log") },
  ...(access?.edit
    ? [{ label: "Create a page", href: toolHref(wiki, "create") }]
    : []),
  ...(access?.manage
    ? [{ label: "Settings", href: toolHref(wiki, "settings") }]
    : []),
];
const groups = [...sections, { label: "This wiki", links: tools }];
---

<nav
  aria-label={`${wiki.name} wiki`}
  class="flex flex-col gap-7 md:sticky md:top-6"
>
  {groups.map((group) => (
    <section class="flex flex-col gap-2">
      <h2 class="type-label text-muted">{group.label}</h2>
      <ul class="flex flex-col gap-1.5 text-[0.9375rem]">
        {group.links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={
                Astro.url.pathname.replace(/^\/wiki/, "") === link.href
                  ? "page"
                  : undefined
              }
              class="hover:underline aria-[current=page]:font-semibold"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</nav>
