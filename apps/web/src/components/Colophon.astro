---
const facts = [
  { term: "Framework", value: "Astro" },
  { term: "Interface", value: "React · Tailwind" },
  { term: "Hosting", value: "Docker · Caddy" },
  { term: "Accounts", value: "GitHub sign-in" },
] as const;
---

<!-- Text stays black on the accent in both themes: it reads better on orange. -->
<section
  id="colophon"
  aria-labelledby="colophon-title"
  class="bg-accent text-on-accent"
>
  <div class="grid-swiss px-page gap-y-6 pt-8 pb-10 md:gap-y-10 md:pt-10 md:pb-12 xl:gap-y-14 xl:pt-12 xl:pb-14">
    <p class="type-label col-span-4 md:col-span-2 xl:col-span-3">
      (03) Colophon
    </p>
    <h2
      id="colophon-title"
      class="type-band col-span-4 md:col-span-6 xl:col-span-9"
    >
      <span class="block">Built by hand.</span>
      <span class="block">Served from a small server.</span>
    </h2>
    <dl class="col-span-4 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-on-accent pt-3 md:col-span-6 md:col-start-3 md:gap-y-[18px] md:pt-3.5 xl:col-span-9 xl:col-start-4 xl:grid-cols-4 xl:gap-x-6 xl:pt-4">
      {facts.map((fact) => (
        <div class="flex flex-col gap-1 xl:gap-1.5">
          <dt class="type-label">{fact.term}</dt>
          <dd class="text-base font-medium md:text-[17px] xl:text-lg">
            {fact.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
