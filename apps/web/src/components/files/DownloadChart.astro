---
/**
 * Downloads per day as a row of thin bars (one series: no legend; the heading names
 * it). Each bar shows its day and count on hover; the same numbers are in a table
 * for screen readers and anyone who wants them.
 */
import type { DayCount } from "../../lib/storage/downloads-stats";

interface Props {
  days: readonly DayCount[];
  /** What the chart counts, e.g. "Downloads of castle.zip". */
  label: string;
}

const { days, label } = Astro.props;
const total = days.reduce((sum, day) => sum + day.count, 0);
const peak = Math.max(0, ...days.map((day) => day.count));
const max = Math.max(1, peak);
const BAR = 8;
const GAP = 2;
const HEIGHT = 64;
const width = days.length * (BAR + GAP) - GAP;
const shortDate = (day: string) =>
  new Date(`${day}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });
const first = days[0];
const last = days.at(-1);
---

<figure class="flex flex-col gap-2">
  <svg
    viewBox={`0 0 ${String(width)} ${String(HEIGHT + 1)}`}
    class="h-16 w-full max-w-xl"
    preserveAspectRatio="none"
    role="img"
    aria-label={`${label}: ${String(total)} in the last ${String(days.length)} days`}
  >
    <line
      x1="0"
      x2={width}
      y1={HEIGHT + 0.5}
      y2={HEIGHT + 0.5}
      stroke="var(--tr-hair)"
      stroke-width="1"
    />
    {days.map((day, i) => {
      const height =
        day.count === 0 ? 0 : Math.max(2, (day.count / max) * HEIGHT);
      const x = i * (BAR + GAP);
      return (
        <g>
          <title>
              {shortDate(day.day)}: {day.count} {day.count === 1 ? "download" : "downloads"}
            </title>
          {/* The whole column answers hover, not just the (maybe tiny) bar. */}
          <rect x={x} y="0" width={BAR} height={HEIGHT} fill="transparent" />
          {height > 0 && (
            <rect
              x={x}
              y={HEIGHT - height}
              width={BAR}
              height={height}
              rx="1"
              fill="var(--tr-accent)"
            />
          )}
        </g>
      );
    })}
  </svg>
  <figcaption class="type-label flex max-w-xl justify-between text-muted">
    <span>{first && shortDate(first.day)}</span>
    <span>
      {total} in {days.length} days · most {peak} a day
    </span>
    <span>{last && shortDate(last.day)}</span>
  </figcaption>
  <details class="max-w-xl">
    <summary class="type-label cursor-pointer text-muted">
      Show as a table
    </summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{label}, per day</caption>
      <thead>
        <tr class="type-label text-muted">
          <th scope="col" class="text-left font-normal">
            Day (UTC)
          </th>
          <th scope="col" class="text-right font-normal">
            Downloads
          </th>
        </tr>
      </thead>
      <tbody>
        {[...days].reverse().map((day) => (
          <tr class="border-t border-hair">
            <td>{day.day}</td>
            <td class="text-right">{day.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
