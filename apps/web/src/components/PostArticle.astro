---
/**
 * A post as readers see it: the bar above, the header with its facts, the text, and
 * the footer (tags, next post). Used by the post page and a draft's preview link.
 */
import { ArrowLeftIcon, ArrowRightIcon } from "@trilleo/ui";
import type { BlogPost } from "../lib/blog/store";
import { formatPostDate } from "../lib/listings";
import { addSidenotes } from "../lib/post-html";
import { postHref, readingMinutes } from "../lib/posts";
import Breadcrumb from "./Breadcrumb.astro";
import TableOfContents from "./TableOfContents.astro";
import TagLinks from "./TagLinks.astro";

interface Props {
  post: BlogPost;
  /** Its "No." in the index ("—" if it isn't public). */
  number: string;
  next?: { post: BlogPost; number: string; newer: boolean } | undefined;
  /** For the admin: a link to edit it. */
  editHref?: string | undefined;
  /** Shown instead of the Published/Draft status (e.g. "Scheduled"). */
  statusLabel?: string | undefined;
}

const { post, number, next, editHref, statusLabel } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const sections = post.row.toc.filter((heading) => heading.depth === 2);
const status = statusLabel ?? (draft ? "Draft" : "Published");
---

<div class="grid-swiss px-page type-label border-b border-hair py-3 xl:py-4">
  <Breadcrumb
    class="col-span-2 md:col-span-4 xl:col-span-2"
    items={[{ label: "(01) Writing", href: "/writing/" }, { label: number }]}
  />
  <span class="col-span-2 flex justify-end gap-6 md:col-span-4 xl:col-span-3 xl:col-start-10">
    {editHref && (
      <a href={editHref} class="group">
        <span class="link-wipe">Edit post</span>
      </a>
    )}
    <a href="/writing/" class="group inline-flex items-center gap-2">
      <ArrowLeftIcon
        size={16}
        className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-x-1"
      />
      <span class="link-wipe">All posts</span>
    </a>
  </span>
</div>

<article>
  <header class="grid-swiss px-page gap-y-8 pt-10 pb-12 md:pt-14 md:pb-14 xl:pt-18 xl:pb-16">
    <div class="col-span-4 flex flex-col gap-6 md:col-span-6 md:col-start-3 md:row-start-1 xl:col-span-10 xl:col-start-3 xl:gap-8">
      <h1 class="type-headline">{title}</h1>
      {description && (
        <p class="type-dek max-w-[47.5rem] animate-rise text-muted [animation-delay:120ms]">
          {description}
        </p>
      )}
    </div>
    <dl class="type-label col-span-4 flex animate-fade flex-col gap-3.5 [animation-delay:200ms] md:col-span-2 md:col-start-1 md:row-start-1 md:pt-2.5 xl:col-span-2">
      <div class="flex gap-3">
        <dt class="w-18 text-muted">Status</dt>
        <dd class="inline-flex items-center gap-2">
          <span
            class:list={["size-2", draft ? "bg-accent" : "bg-ink"]}
            aria-hidden="true"
          ></span>
          {status}
        </dd>
      </div>
      <div class="flex gap-3">
        <dt class="w-18 text-muted">Date</dt>
        <dd>
          {pubDate ? (
            <time datetime={pubDate.toISOString()}>
              {formatPostDate(pubDate)}
            </time>
          ) : (
            "—"
          )}
        </dd>
      </div>
      {updatedDate && (
        <div class="flex gap-3">
          <dt class="w-18 text-muted">Updated</dt>
          <dd>
            <time datetime={updatedDate.toISOString()}>
              {formatPostDate(updatedDate)}
            </time>
          </dd>
        </div>
      )}
      <div class="flex gap-3">
        <dt class="w-18 text-muted">Read</dt>
        <dd>{readingMinutes(post.body)} min</dd>
      </div>
    </dl>
  </header>

  <div class="mx-page h-0.5 origin-left animate-draw bg-ink [animation-delay:150ms]"></div>
  <div class="grid-swiss mx-page pt-10 md:pt-12">
    {sections.length > 1 && (
      <div class="hidden xl:col-span-2 xl:block">
        <TableOfContents headings={sections} />
      </div>
    )}
    <div class="prose col-span-4 md:col-span-8 md:max-w-[40rem] xl:col-span-7 xl:col-start-3 xl:max-w-none">
      <Fragment set:html={addSidenotes(post.row.html)} />
    </div>
  </div>
</article>

<footer class="mx-page mt-16 flex flex-col gap-16 pb-16 md:mt-20 md:gap-20 md:pb-24 xl:mt-24">
  {tags.length > 0 && (
    <div class="grid-swiss gap-y-4 border-t border-ink pt-4" data-reveal>
      <p class="type-label col-span-4 md:col-span-2 xl:col-span-2">Tags</p>
      <div class="col-span-4 md:col-span-6 xl:col-span-10">
        <TagLinks tags={tags.map((name) => ({ name }))} label="Post tags" />
      </div>
    </div>
  )}
  {next && (
    <a
      href={postHref(next.post.id)}
      class="group grid-swiss items-end gap-y-4 border-t-2 border-b border-ink pt-4 pb-8 xl:pb-10"
      data-reveal
    >
      <span class="type-label col-span-4 self-start md:col-span-2 xl:col-span-2">
        {next.newer ? "Next" : "Previous"} — {next.number}
      </span>
      <span class="type-title col-span-4 md:col-span-5 xl:col-span-9">
        <!-- Looser than the title's own 0.9 so, on a wrapped title, each line's
             hover underline clears the line below. -->
        <span class="link-wipe leading-[1.12]">{next.post.data.title}</span>
      </span>
      <span class="hidden justify-self-end transition-transform duration-(--tr-dur-base) ease-swiss group-hover:translate-x-1 md:col-span-1 md:block">
        {next.newer ? (
          <ArrowRightIcon size={48} strokeWidth={1.4} />
        ) : (
          <ArrowLeftIcon size={48} strokeWidth={1.4} />
        )}
      </span>
    </a>
  )}
</footer>
