---
/**
 * The human check's puzzle: a 4×4 grid of shapes, a checkbox each, plus the same
 * check as a question in words for those who can't see the grid. Plain HTML, so it
 * works without JavaScript; it posts back to /check/ with the visitor's own form
 * fields carried along as hidden inputs.
 */
import { PUZZLE_SIZE, cellSvg, type Puzzle } from "@trilleo/captcha";
import { buttonClasses, fieldClasses } from "@trilleo/ui";

interface Props {
  action: string;
  token: string;
  puzzle: Puzzle;
  /** The visitor's form, sent on once the check is passed. */
  fields: readonly (readonly [string, string])[];
  /** E2E only: the answers, so specs can solve it. */
  revealAnswers?: boolean;
  /** Ids unique on the page (the puzzle may appear twice: in <noscript>). */
  idPrefix?: string;
}

const {
  action,
  token,
  puzzle,
  fields,
  revealAnswers = false,
  idPrefix = "check",
} = Astro.props;
const legendId = `${idPrefix}-legend`;
const textId = `${idPrefix}-text`;
---

<form
  method="post"
  {action}
  class="flex flex-col gap-5"
  data-answer={revealAnswers ? puzzle.answer.join(",") : undefined}
  data-text-answer={revealAnswers ? puzzle.textAnswer : undefined}
>
  {fields.map(([name, value]) => (
    <input type="hidden" {name} {value} />
  ))}
  <input type="hidden" name="_check_token" value={token} />

  <fieldset class="flex flex-col gap-3" aria-describedby={`${idPrefix}-hint`}>
    <legend id={legendId} class="mb-1 font-medium">
      Select every square with a {puzzle.target}.
    </legend>
    <div
      class="grid gap-1.5"
      style={`grid-template-columns: repeat(${String(PUZZLE_SIZE)}, minmax(0, 1fr))`}
    >
      {puzzle.cells.map((cell, i) => (
        <label class="check-cell relative block aspect-square cursor-pointer border border-ink text-ink">
          <input
            type="checkbox"
            name="_check_cell"
            value={String(i)}
            class="peer sr-only"
          />
          <span class="block size-full p-1.5" set:html={cellSvg(cell)} />
          <span class="sr-only">
            {`Square ${String(i + 1)}: row ${String(Math.floor(i / PUZZLE_SIZE) + 1)}, column ${String((i % PUZZLE_SIZE) + 1)}`}
          </span>
        </label>
      ))}
    </div>
    <p id={`${idPrefix}-hint`} class="text-sm text-muted">
      Can’t see the pictures? Answer the question below instead.
    </p>
  </fieldset>

  <div class="flex flex-col gap-2">
    <label for={textId} class="font-medium">
      {puzzle.question}
    </label>
    <input
      id={textId}
      name="_check_text"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      maxlength={40}
      class={`${fieldClasses} px-3 py-2.5 text-base`}
    />
  </div>

  <button
    type="submit"
    class={buttonClasses({ hover: "plain", className: "w-full" })}
  >
    Continue
  </button>
</form>
