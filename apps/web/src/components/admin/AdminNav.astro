---
/** The admin's sections: the dashboard (comments, account), posts, files, Minecraft, the forum, the daily cryptic, the API, messages and mail. */
interface Props {
  current:
    | "dashboard"
    | "posts"
    | "files"
    | "minecraft"
    | "forum"
    | "cryptic"
    | "api"
    | "messages"
    | "mail";
}

const { current } = Astro.props;
const items = [
  { key: "dashboard", label: "Dashboard", href: "/admin/" },
  { key: "posts", label: "Posts", href: "/admin/posts/" },
  { key: "files", label: "Files", href: "/admin/files/" },
  { key: "minecraft", label: "Minecraft", href: "/admin/minecraft/" },
  { key: "forum", label: "Forum", href: "/admin/forum/" },
  { key: "cryptic", label: "Cryptic", href: "/admin/cryptic/" },
  { key: "api", label: "API", href: "/admin/api/" },
  { key: "messages", label: "Messages", href: "/admin/messages/" },
  { key: "mail", label: "Mail", href: "/admin/mail/" },
] as const;
---

<!-- Above the page's display title, whose tall glyphs reach up over this row. -->
<nav
  aria-label="Admin"
  class="type-label relative z-10 flex flex-wrap gap-x-6 gap-y-2"
>
  <span class="text-muted">(Admin)</span>
  {items.map((item) => (
    <a
      href={item.href}
      class="group inline-flex items-center gap-2"
      aria-current={item.key === current ? "page" : undefined}
    >
      <span
        class:list={[
          "size-2",
          item.key === current ? "bg-accent" : "bg-transparent",
        ]}
        aria-hidden="true"
      ></span>
      <span class="link-wipe">{item.label}</span>
    </a>
  ))}
</nav>
