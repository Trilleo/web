---
import { ContrastIcon } from "@trilleo/ui";
---

<!-- Names the mode it switches to: "Dark mode" in light, "Light mode" in dark. The
     label follows <html data-theme> in CSS, which is set before first paint, so it's
     never wrong for a moment; the hidden one is display: none, so only the visible
     label names the button. -->
<button
  type="button"
  class="group press type-nav inline-flex min-h-11 min-w-11 items-center justify-center gap-2 md:justify-start"
  data-theme-toggle
>
  <span class="theme-icon">
    <ContrastIcon size={18} />
  </span>
  <span class="sr-only md:not-sr-only">
    <span class="link-wipe to-dark">Dark mode</span>
    <span class="link-wipe to-light">Light mode</span>
  </span>
</button>

<style>
  .to-light,
  :global([data-theme="dark"]) .to-dark {
    display: none;
  }
  :global([data-theme="dark"]) .to-light {
    display: inline;
  }

  /* The icon turns a little on hover and half a turn with the theme. */
  .theme-icon {
    display: inline-flex;
    transition: rotate var(--tr-dur-slow) var(--tr-ease);
  }
  button:hover .theme-icon {
    rotate: 45deg;
  }
  :global([data-theme="dark"]) .theme-icon {
    rotate: 180deg;
  }
  :global([data-theme="dark"]) button:hover .theme-icon {
    rotate: 225deg;
  }
</style>

<script>
  import { bindThemeToggle } from "@trilleo/ui/theme";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  )) {
    bindThemeToggle(button);
  }
</script>
