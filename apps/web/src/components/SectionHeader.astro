---
import { ArrowUpRightIcon } from "@trilleo/ui";

interface Props {
  /** Section number, e.g. "01". */
  number: string;
  title: string;
  /** id for the <h2>, so the section can use aria-labelledby. */
  headingId: string;
  /** Short note at the right, e.g. "4 posts". */
  meta?: string | undefined;
  /** Turns the note into a link, e.g. to the full index. */
  href?: string | undefined;
}

const { number, title, headingId, meta, href } = Astro.props;
const metaClass =
  "type-label col-span-2 col-start-3 row-start-1 self-start justify-self-end md:col-start-7 md:self-end xl:col-span-3 xl:col-start-10";
---

<!-- The 2px rule draws in from the left as it scrolls into view, then the row rises.
     Phone: number and meta share the first row, title below. iPad/desktop: one row. -->
<div class="h-0.5 bg-ink" data-reveal="rule"></div>
<div class="grid-swiss items-end pt-3 md:pt-4" data-reveal>
  <span class="type-label col-span-2 row-start-1 self-start xl:col-span-2">
    ({number})
  </span>
  <h2
    id={headingId}
    class="type-title col-span-4 row-start-2 mt-2 md:col-span-4 md:col-start-3 md:row-start-1 md:mt-0 xl:col-span-7 xl:col-start-3"
  >
    {title}
  </h2>
  {meta &&
    (href ? (
      <a
        href={href}
        class={`${metaClass} group inline-flex min-h-8 items-center gap-1.5`}
      >
        <span class="link-wipe">{meta}</span>
        <ArrowUpRightIcon
          size={14}
          className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    ) : (
      <span class={`${metaClass} text-muted`}>{meta}</span>
    ))}
</div>
