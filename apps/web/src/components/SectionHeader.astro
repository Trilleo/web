---
import { ArrowUpRightIcon } from "@trilleo/ui";

interface Props {
  /** Section number, e.g. "01". */
  number: string;
  title: string;
  /** id for the <h2>, so the section can use aria-labelledby. */
  headingId: string;
  /** Short note at the right, e.g. "4 posts". */
  meta?: string | undefined;
  /** Turns the note into a link, e.g. to the full index. */
  href?: string | undefined;
}

const { number, title, headingId, meta, href } = Astro.props;
const metaClass =
  "type-label col-span-4 mt-3 justify-self-start md:col-span-2 md:mt-0 md:self-end md:justify-self-end xl:col-span-3";
---

<!-- The 2px rule draws in from the left as it scrolls into view, then the row rises.
     The number sits right before the title, at its top; the note goes at the right
     (under the title on phones). -->
<div class="h-0.5 bg-ink" data-reveal="rule"></div>
<div class="grid-swiss pt-3 md:pt-4" data-reveal>
  <div class="col-span-4 flex items-start gap-2 md:col-span-6 md:gap-3 xl:col-span-9">
    <!-- Sized like the title, so the padding (in its em) lines the number's
         capitals up with the title's (cap top ≈ 0.1em, less the label's own). -->
    <span class="type-title shrink-0 pt-[calc(0.1em-0.25rem)] font-normal">
      <span class="type-label block">({number})</span>
    </span>
    <h2 id={headingId} class="type-title min-w-0">
      {title}
    </h2>
  </div>
  {meta &&
    (href ? (
      <a
        href={href}
        class={`${metaClass} group inline-flex min-h-8 items-center gap-1.5`}
      >
        <span class="link-wipe">{meta}</span>
        <ArrowUpRightIcon
          size={14}
          className="transition-transform duration-(--tr-dur-fast) ease-swiss group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    ) : (
      <span class={`${metaClass} text-muted`}>{meta}</span>
    ))}
</div>
