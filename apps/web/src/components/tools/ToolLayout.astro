---
/** The frame around a tool's app: the site's layout, a way back, the tool's name. */
import type { ToolMeta } from "@trilleo/tool-kit";
import { ArrowLeftIcon } from "@trilleo/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  breadcrumbJsonLd,
  ogImagePath,
  toolCard,
  toolJsonLd,
} from "../../lib/seo";
import { transitionName } from "../../lib/site";
import { toolPath } from "../../lib/tools/registry";

interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props;
const path = toolPath(meta.slug);
const image = ogImagePath(`tools/${meta.slug}`, toolCard(meta));
---

<BaseLayout
  title={meta.name}
  description={meta.description}
  {image}
  jsonLd={[
    toolJsonLd(meta, path, image),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Tools", path: "/tools/" },
      { name: meta.name, path },
    ]),
  ]}
>
  <div class="grid-swiss px-page type-label border-b border-hair py-3 xl:py-4">
    <span class="col-span-2 md:col-span-4 xl:col-span-2">
      (02) Tools / {meta.name}
    </span>
    <a
      href="/tools/"
      class="group col-span-2 inline-flex items-center gap-2 justify-self-end md:col-span-4 xl:col-span-3 xl:col-start-10"
    >
      <ArrowLeftIcon
        size={16}
        className="transition-transform duration-(--tr-dur-base) ease-swiss group-hover:-translate-x-1"
      />
      <span class="link-wipe">All tools</span>
    </a>
  </div>

  <section
    aria-labelledby="tool-title"
    class="px-page pt-8 pb-24 md:pt-10 xl:pt-14 xl:pb-32"
  >
    <div class="grid-swiss gap-y-4 pb-8 md:pb-10">
      <!-- Morphs from the tool's name in a list (ToolList). -->
      <h1
        id="tool-title"
        class="type-headline col-span-4 md:col-span-6 xl:col-span-9"
      >
        <span
          class="inline-block"
          data-morph
          style={`view-transition-name: ${transitionName("tool", meta.name)}; view-transition-class: tr-morph`}
        >
          {meta.name}
        </span>
      </h1>
      <p class="type-dek col-span-4 max-w-[47.5rem] animate-rise text-muted [animation-delay:120ms] md:col-span-6 xl:col-span-9">
        {meta.description}
      </p>
    </div>
    <slot />
  </section>
</BaseLayout>
