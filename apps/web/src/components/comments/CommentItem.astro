---
import { renderComment } from "../../lib/comments/render";
import type { CommentView } from "../../lib/comments/store";
import { formatPostDate } from "../../lib/listings";
import { profileHref } from "../../lib/profile/profile";

interface Props {
  comment: CommentView;
  /** Show a delete button (the viewer wrote it, or is the admin). */
  canDelete: boolean;
  /** The admin's pin button: pin it, or unpin it (it's the pinned one). */
  pin?: "pin" | "unpin" | undefined;
  /** Where to come back to after deleting or pinning. */
  back: string;
}

const { comment, canDelete, pin, back } = Astro.props;
const anchor = `comment-${String(comment.id)}`;
---

<article
  id={anchor}
  class="flex scroll-mt-6 flex-col gap-2.5"
  aria-label={
    comment.removed
      ? "Removed comment"
      : `Comment by ${comment.author?.login ?? "a deleted account"}`
  }
>
  {comment.removed ? (
    <p class="type-label text-muted">This comment has been removed.</p>
  ) : (
    <>
      <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        {comment.author ? (
          <a
            href={
              comment.author.profile
                ? profileHref(comment.author.login)
                : `https://github.com/${comment.author.login}`
            }
            rel={comment.author.profile ? undefined : "nofollow ugc noopener"}
            class="group font-medium"
          >
            {comment.author.name ? (
              <>
                <span class="link-wipe">{comment.author.name}</span>
                <span class="type-label ml-1 text-muted">
                  @{comment.author.login}
                </span>
              </>
            ) : (
              <span class="link-wipe">@{comment.author.login}</span>
            )}
          </a>
        ) : (
          <span class="font-medium text-muted">Deleted account</span>
        )}
        <a href={`#${anchor}`} class="type-label link-wipe text-muted">
          <time datetime={comment.createdAt.toISOString()}>
            {formatPostDate(comment.createdAt)}
          </time>
        </a>
        {comment.pinned && (
          <span class="type-label inline-flex items-center gap-1.5 text-ink">
            <span class="size-2 bg-accent" aria-hidden="true"></span>
            Pinned
          </span>
        )}
        {comment.pending && (
          <span class="type-label bg-accent px-1.5 py-0.5 text-on-accent">
            Awaiting approval
          </span>
        )}
      </header>
      <div class="comment-body">
        <Fragment set:html={renderComment(comment.body)} />
      </div>
      {(canDelete || pin) && (
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
          {pin && (
            <form method="post" action="/comments/pin">
              <input type="hidden" name="id" value={String(comment.id)} />
              <input type="hidden" name="action" value={pin} />
              <input type="hidden" name="back" value={back} />
              <button
                type="submit"
                class="group type-label cursor-pointer text-muted hover:text-ink"
              >
                <span class="link-wipe">
                  {pin === "pin" ? "Pin to top" : "Unpin"}
                </span>
              </button>
            </form>
          )}
          {canDelete && (
            <details class="type-label text-muted">
              <summary class="link-wipe w-fit cursor-pointer hover:text-ink">
                Delete
              </summary>
              <form method="post" action="/comments/delete" class="mt-2">
                <input type="hidden" name="id" value={String(comment.id)} />
                <input type="hidden" name="back" value={back} />
                <button
                  type="submit"
                  class="type-label border border-ink px-2.5 py-1.5 text-ink hover:bg-ink hover:text-paper"
                >
                  Yes, delete this comment
                </button>
              </form>
            </details>
          )}
        </div>
      )}
    </>
  )}
</article>
