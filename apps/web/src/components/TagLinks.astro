---
import { tagHref } from "../lib/posts";

interface Props {
  tags: readonly { name: string; count?: number | undefined }[];
  /** Slug of the tag being viewed, marked as current. */
  current?: string | undefined;
  label?: string;
}

const { tags, current, label = "Tags" } = Astro.props;
---

{tags.length > 0 && (
  <nav aria-label={label}>
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => {
        const href = tagHref(tag.name);
        const isCurrent =
          current !== undefined && href.endsWith(`/${current}/`);
        return (
          <li>
            <a
              href={href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                "type-label press inline-flex min-h-9 items-center gap-2 border px-3",
                isCurrent
                  ? "border-ink bg-ink text-paper"
                  : // Ink slides in from the left behind the label, like buttons.
                    "relative isolate overflow-hidden border-ink before:absolute before:inset-0 before:-z-10 before:origin-left before:scale-x-0 before:bg-ink before:transition-transform before:duration-(--tr-dur-base) before:ease-swiss hover:text-paper hover:before:scale-x-100 focus-visible:text-paper focus-visible:before:scale-x-100",
              ]}
            >
              {tag.name}
              {tag.count !== undefined && (
                <span class="opacity-70">{tag.count}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}
