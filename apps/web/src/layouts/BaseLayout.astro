---
import "../styles/global.css";
import { morphGuardScript } from "@trilleo/ui/page-transition";
import { motionInitScript } from "@trilleo/ui/reveal";
import { THEME_COLORS, themeInitScript } from "@trilleo/ui/theme";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_IMAGE,
  serializeJsonLd,
  type JsonLd,
} from "../lib/seo";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  formatTitle,
} from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (private pages, search results, drafts). */
  noindex?: boolean;
  /** Its share image (a path from ogImagePath); the site's card by default. */
  image?: string;
  /** What the share image shows, for people who can't see it. */
  imageAlt?: string;
  /** A post: Open Graph calls it an article and gives its dates and tags. */
  article?: {
    published: Date;
    modified?: Date | undefined;
    tags: readonly string[];
  };
  /** Structured data about the page (see lib/seo.ts). */
  jsonLd?: readonly JsonLd[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  image = SITE_IMAGE,
  imageAlt = title ?? SITE_NAME,
  article,
  jsonLd = [],
} = Astro.props;
const site = Astro.site ?? SITE_URL;
const url = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
// Search engines check these once, on the home page. Read per request, so pages
// built ahead of time (without the server's settings) simply don't carry them.
const verification = Astro.isPrerendered
  ? {}
  : {
      google: process.env.GOOGLE_SITE_VERIFICATION?.trim(),
      bing: process.env.BING_SITE_VERIFICATION?.trim(),
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />
    <!-- Sets data-theme before first paint so dark-mode visitors never see a light flash. -->
    <script is:inline set:html={themeInitScript}></script>
    <!-- Opts into scroll reveals before first paint (only with JS and motion allowed). -->
    <script is:inline set:html={motionInitScript}></script>
    <!-- Titles morph from list to page only, and only when both ends are on screen. -->
    <script is:inline set:html={morphGuardScript}></script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <!-- A page that shouldn't be indexed has no preferred URL to point at. -->
    {!noindex && <link rel="canonical" href={url} />}
    {verification.google && (
      <meta name="google-site-verification" content={verification.google} />
    )}
    {verification.bing && (
      <meta name="msvalidate.01" content={verification.bing} />
    )}
    <!-- Link previews: Open Graph (most apps) and X's card, which falls back to it. -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title?.trim() || SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        {article.modified && (
          <meta
            property="article:modified_time"
            content={article.modified.toISOString()}
          />
        )}
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && (
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(jsonLd)}
      />
    )}
    <!-- From the channel's Main Logo.png (1024px), resized. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} · Writing`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{formatTitle(title)}</title>
  </head>
  <body id="top" class="flex min-h-dvh flex-col bg-paper text-ink">
    <a
      href="#main"
      class="type-nav sr-only bg-accent px-4 py-3 text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { bindReveal } from "@trilleo/ui/reveal";

      bindReveal(document);
    </script>
  </body>
</html>
