{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["ASTRO_OUT_DIR"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
